<app-loading wx:if="{{pageLoading}}" variant="book" />
<block wx:else>
<view class="s-page"><view class="s-title">{{context.book.snapshot.cover.title || '印刷与寄送'}}</view><view class="s-card"><view class="s-subtitle">1 本实体书</view><view class="s-muted">首本书费已包含，无需再次支付</view><button class="s-link" bindtap="preview" wx:if="{{context.book.state==='ready'}}">查看完整书稿 · {{context.book.pageCount}} 页</button></view><button class="s-row" bindtap="address"><view class="s-grow"><view class="s-subtitle">收货地址</view><block wx:if="{{context.address.value}}"><view>{{context.address.value.recipientName}}　{{context.address.value.phone}}</view><view class="s-muted">{{context.shipping.regionLabels[context.address.value.regionCode]}} {{context.address.value.detail}}</view></block><view wx:else class="s-muted">请填写收货信息</view></view><text class="s-arrow">›</text></button><view wx:for="{{context.shipping.terms}}" wx:key="label" class="s-muted s-space">{{item.label}} {{item.text}}</view><view class="s-error" wx:for="{{blockers}}" wx:key="*this">{{item}}</view><view class="s-error">{{status}}</view><button wx:if="{{!context.book || context.book.state!=='ready'}}" class="s-link" bindtap="book">返回生成书稿</button><button class="s-link" bindtap="terms">使用条款与客服</button><view class="s-dock"><button wx:if="{{unknown}}" class="s-button" bindtap="refresh" disabled="{{busy}}">查询提交结果</button><button wx:elif="{{context.production && !context.canReviseProduction}}" class="s-button" bindtap="production">查看制作进度</button><button wx:else class="s-button" disabled="{{busy || !context.canSubmit}}" loading="{{busy}}" bindtap="submit">确认印刷并寄送</button></view></view>
</block>
