<view class="page with-dock"
  ><view class="row print-product"
    ><image class="print-book" src="{{bookImage}}" mode="aspectFill" /><view
      class="grow"
      ><view class="serif section-title">{{p.title}}</view
      ><view class="subtitle">爱与岁月的故事</view
      ><view class="spec-line">专属故事书 · 1本</view
      ><view class="small muted">书稿第{{p.revision}}版</view
      ><view class="small muted">装帧与页数以最终打样为准</view></view
    ></view
  ><view class="entitlement section"
    ><view class="row between"
      ><view class="section-title">首本实体书</view
      ><view class="pill">已含在套餐中</view></view
    ><view class="row between" style="margin-top: 22rpx"
      ><text class="muted">套餐 ¥999 · 本次无需再次支付</text
      ><text class="price">¥0</text></view
    ><view class="small muted">当前为本机演示权益，尚未实际付款</view></view
  ><view class="paper section"
    ><view class="row section-title"
      ><image class="icon" src="/assets/icons/map-pin.svg" /> 收货信息</view
    ><view class="field"
      ><text class="label">收件人</text
      ><input
        placeholder="填写收件人姓名"
        value="{{name}}"
        data-field="name"
        bindinput="input"
        maxlength="30" /></view
    ><view class="field"
      ><text class="label">手机号</text
      ><input
        type="number"
        placeholder="填写11位手机号"
        value="{{phone}}"
        data-field="phone"
        bindinput="input"
        maxlength="11" /></view
    ><view class="field"
      ><text class="label">完整地址</text
      ><textarea
        placeholder="省、市、区、街道及门牌号"
        value="{{detail}}"
        data-field="detail"
        bindinput="input"
        maxlength="200"
      /></view></view
  ><view class="soft section"
    ><view class="row"
      ><image class="icon" src="/assets/icons/clipboard-check.svg" /><view
        class="grow"
        ><view>书稿确认</view
        ><view class="small muted"
          >{{ready?'本人内容与子女校对均已确认':'请先阅读并确认完整书稿'}}</view
        ></view
      ></view
    ><button class="link" bindtap="review"
      >{{ready?'查看已确认的书稿':'去确认完整书稿'}}
      <image
        class="icon small"
        src="/assets/icons/chevron-right.svg" /></button></view
  ><view class="row section note"
    ><image class="icon" src="/assets/icons/truck.svg" /><text
      >书稿锁定并审核后开始制作。实际印制与配送时间将在接入生产服务后公示。</text
    ></view
  ><view class="error">{{error}}</view></view
><view class="dock"
  ><button
    wx:if="{{!submitted}}"
    class="btn brown"
    disabled="{{!ready}}"
    bindtap="submit"
    >体验确认印刷与寄送</button
  ><button wx:else="" class="btn" bindtap="order">查看演示订单</button
  ><view class="dock-note">本次无需支付 · 不会创建真实印刷订单</view></view
>
