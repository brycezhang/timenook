<view wx:if="{{visible && embedded && !consentConfirm}}" class="quick-login-embedded tn-surface">
 <view class="quick-login-agreement">
  <button class="quick-login-check" bindtap="toggleAgreed" aria-role="checkbox" aria-checked="{{agreed}}" aria-label="我已阅读并同意隐私保护指引和使用条款" disabled="{{busy}}"><text class="quick-login-box {{agreed ? 'checked' : ''}}">{{agreed ? '✓' : ''}}</text></button>
  <view class="quick-login-terms">我已阅读并同意<button bindtap="privacy">《隐私保护指引》</button>和<button bindtap="terms">《使用条款》</button></view>
 </view>
 <view wx:if="{{status}}" class="tn-error">{{status}}</view>
 <view class="tn-dock"><button wx:if="{{agreed}}" class="tn-button quick-login-submit" open-type="getPhoneNumber|agreePrivacyAuthorization" bindgetphonenumber="login" loading="{{busy}}" disabled="{{busy}}"><image class="tn-icon" src="/assets/icons/phone-white.svg"/>授权微信手机号</button><button wx:else class="tn-button quick-login-submit" bindtap="requestConsent"><image class="tn-icon" src="/assets/icons/phone-white.svg"/>授权微信手机号</button></view>
</view>
<page-container wx:if="{{sheetMounted}}" show="{{sheetOpen}}" position="bottom" duration="{{240}}" round="{{true}}" z-index="{{20000}}" overlay-style="background-color: rgba(56, 44, 36, .35)" bindbeforeleave="beforeLeave" bindafterleave="afterLeave">
 <view class="tn-bottom-sheet quick-login-sheet tn-surface" role="dialog" aria-modal="true" aria-label="{{consentConfirm ? '隐私保护提示' : '微信手机号登录'}}">
  <block wx:if="{{!consentConfirm}}">
   <view class="quick-login-heading"><view class="tn-heading">微信手机号登录</view><button class="tn-icon-button quick-login-close" bindtap="close" disabled="{{busy}}" aria-label="关闭登录"><image class="tn-icon" src="/assets/icons/modern-close.svg"/></button></view>
   <view class="tn-muted">授权微信绑定的手机号，登录后继续。</view>
   <view class="quick-login-agreement">
    <button class="quick-login-check" bindtap="toggleAgreed" aria-role="checkbox" aria-checked="{{agreed}}" aria-label="我已阅读并同意隐私保护指引和使用条款" disabled="{{busy}}"><text class="quick-login-box {{agreed ? 'checked' : ''}}">{{agreed ? '✓' : ''}}</text></button>
    <view class="quick-login-terms">我已阅读并同意<button bindtap="privacy">《隐私保护指引》</button>和<button bindtap="terms">《使用条款》</button></view>
   </view>
   <button wx:if="{{agreed}}" class="tn-button quick-login-submit" open-type="getPhoneNumber|agreePrivacyAuthorization" bindgetphonenumber="login" loading="{{busy}}" disabled="{{busy}}"><image class="tn-icon" src="/assets/icons/phone-white.svg"/>微信手机号登录</button>
   <button wx:else class="tn-button quick-login-submit" bindtap="requestConsent"><image class="tn-icon" src="/assets/icons/phone-white.svg"/>微信手机号登录</button>
  </block>
  <block wx:else>
   <view class="tn-heading">隐私保护提示</view>
   <view class="tn-muted">请阅读并同意《隐私保护指引》和<button class="quick-consent-terms" bindtap="terms">《使用条款》</button>。</view>
   <view class="quick-consent-actions">
    <button class="tn-button tn-secondary quick-consent-guide" bindtap="privacy" disabled="{{busy}}">查看指引</button>
    <button class="tn-button quick-consent-continue" open-type="getPhoneNumber|agreePrivacyAuthorization" bindgetphonenumber="continueLogin" loading="{{busy}}" disabled="{{busy}}">同意并继续</button>
   </view>
   <button class="tn-link quick-consent-cancel" bindtap="cancelConsent" disabled="{{busy}}">暂不登录</button>
  </block>
  <view wx:if="{{status}}" class="tn-error">{{status}}</view>
 </view>
</page-container>
