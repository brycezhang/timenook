.outline-between { display:flex; align-items:center; justify-content:space-between; gap:12px; }
.outline-empty { padding:32px 16px; border:1px dashed #ded4c6; border-radius:18px; text-align:center; color:#756859; font-size:14px; }
.outline-badge { align-self:flex-start; padding:5px 9px; border-radius:8px; background:#edf0e7; color:#46563c; font-size:12px; font-weight:600; }
.outline-title { font-size:27px; font-weight:700; line-height:1.35; overflow-wrap:anywhere; }
.outline-tabs { display:flex; padding:4px; gap:5px; border:1px solid #ded4c6; border-radius:16px; }
.outline-tabs button { flex:1; font-size:14px; line-height:1.5; min-height:44px; border-radius:12px; padding:11px 8px; background:#fff; color:#756859; }
.outline-tabs button.selected { background:#46563c; color:#fff; font-weight:600; }
.outline-card { padding:18px; border:1px solid #ded4c6; border-radius:18px; background:#fff; text-align:left; width:100%; display:flex; flex-direction:column; gap:12px; }
.outline-card-title { font-size:17px; font-weight:600; line-height:1.6; overflow-wrap:anywhere; }
.outline-source { display:flex; justify-content:space-between; gap:12px; font-size:12px; color:#756859; }
.outline-source text:last-child { color:#46563c; flex-shrink:0; }
.outline-list { display:flex; flex-direction:column; gap:12px; }
.outline-danger { color:#9a4c36; }
.outline-textarea { box-sizing:border-box; width:100%; min-height:170px; border:1px solid #ded4c6; border-radius:16px; padding:14px 16px; font-size:16px; font-weight:400; line-height:1.8; background:#fff; }
.directory-page { padding-bottom:calc(170px + env(safe-area-inset-bottom)); gap:20px; }
.unassigned-card { padding:16px; border:1px solid #ded4c6; border-radius:16px; background:#edf0e7; color:#46563c; display:flex; justify-content:space-between; text-align:left; font-size:15px; font-weight:600; }

.outline-small-icon { width:17px; height:17px; flex-shrink:0; }
