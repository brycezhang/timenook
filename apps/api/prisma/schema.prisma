generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Infrastructure marker: readiness must verify migrations, not just a TCP port.
// Business entities are introduced by their own vertical tickets.
model ServiceSchema {
  id       Int @id
  revision Int

  @@map("service_schema")
}

model CareExport {
 id String @id @db.Uuid
 projectId String @map("project_id") @db.Uuid
 subjectId String @map("subject_id") @db.Uuid
 bindingVersion Int @map("binding_version")
 accessEpoch Int @map("access_epoch")
 recipient String
 recipientUserId String? @map("recipient_user_id") @db.Uuid
 recipientRef String? @map("recipient_ref")
 evidenceRef String? @map("evidence_ref")
 state String @default("requested")
 ownerId String? @map("owner_id") @db.Uuid
 requestedAt DateTime @default(now()) @map("requested_at") @db.Timestamptz(3)
 acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(3)
 dueAt DateTime? @map("due_at") @db.Timestamptz(3)
 readyAt DateTime? @map("ready_at") @db.Timestamptz(3)
 expiresAt DateTime? @map("expires_at") @db.Timestamptz(3)
 deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(3)
 deliveryEvidence String? @map("delivery_evidence")
 objectKey String? @map("object_key")
 sha256 String? @db.Char(64)
 bytes Int?
 manifest Json?
 missingReason String? @map("missing_reason")
 fence Int @default(0)
 leaseUntil DateTime? @map("lease_until") @db.Timestamptz(3)
 reviewHash String? @map("review_hash") @db.Char(64)
 @@unique([projectId,id])
 @@index([projectId,state])
 @@index([expiresAt])
 @@map("care_exports")
}

model OutlineTemplateVersion {
  templateId   String    @map("template_id")
  version      Int
  content      Json
  contentHash  String    @map("content_hash") @db.Char(64)
  reviewStatus String    @map("review_status")
  projects     Project[]

  @@id([templateId, version])
  @@map("outline_template_versions")
}

model Project {
 bookTitle String? @map("book_title")
 metadataVersion Int @default(0) @map("metadata_version")

  accessEpoch Int @default(0) @map("access_epoch")
  orderId String? @unique @map("order_id") @db.Uuid
  id                    String                 @id @db.Uuid
  createdBy             String                 @map("created_by")
  sourceTemplateId      String                 @map("source_template_id")
  sourceTemplateVersion Int                    @map("source_template_version")
  currentRevision       Int                    @default(1) @map("current_revision")
  sourceTemplate        OutlineTemplateVersion @relation(fields: [sourceTemplateId, sourceTemplateVersion], references: [templateId, version])
  revisions             PlanRevision[]         @relation("ProjectRevisions")
  currentPlan           PlanRevision           @relation("CurrentPlan", fields: [id, currentRevision], references: [projectId, revision], onDelete: NoAction, onUpdate: NoAction)
  preferences           InterviewPreferences?
  preferenceDecisions   PlanPreferenceDecision[]
  directoryVersions     PlanDirectoryVersion[]

  @@map("projects")
}

model PlanRevision {
  projectId   String    @map("project_id") @db.Uuid
  revision    Int
  content     Json?
  contentHash String    @map("content_hash") @db.Char(64)
  createdBy   String    @map("created_by")
  project     Project   @relation("ProjectRevisions", fields: [projectId], references: [id])
  currentFor  Project[] @relation("CurrentPlan")
  actualQuestions ActualPlanQuestion[]

  @@id([projectId, revision])
  @@map("plan_revisions")
}

model InterviewPreferences {
  projectId     String   @id @map("project_id") @db.Uuid
  version       Int      @default(1)
  blockedTopics String[] @default([]) @map("blocked_topics")
  updatedBy     String?  @map("updated_by")
  questionStates Json? @default("[]") @map("question_states")
  project       Project  @relation(fields: [projectId], references: [id])

  @@map("interview_preferences")
}

model User {
  id         String           @id @db.Uuid
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  identities WechatIdentity[]
  sessions   Session[]
  webLoginTickets WebLoginTicket[]
  wechatLinks WechatLink[]

  @@map("users")
}

model WechatIdentity {
  appId  String @map("app_id")
  openId String @map("open_id")
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  @@id([appId, openId])
  @@unique([appId, openId, userId], map: "wechat_identity_owner_unique")
  @@index([userId])
  @@map("wechat_identities")
}

model Session {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id])
  webSession WebSession?
  wechatLinks WechatLink[]

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model WebLoginTicket {
  id String @id @db.Uuid
  userId String @map("user_id") @db.Uuid
  tokenHash String @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id])
  @@index([userId])
  @@index([expiresAt])
  @@map("web_login_tickets")
}

model WebSession {
  sessionId String @id @map("session_id") @db.Uuid
  keyHash String @map("key_hash") @db.Char(64)
  session Session @relation(fields: [sessionId], references: [id])
  @@map("web_sessions")
}

model WechatLink {
  id String @id @db.Uuid
  userId String @map("user_id") @db.Uuid
  sessionId String @map("session_id") @db.Uuid
  codeHash String @unique @map("code_hash") @db.Char(64)
  proofHash String? @unique @map("proof_hash") @db.Char(64)
  verificationCode String? @map("verification_code") @db.Char(6)
  appId String? @map("app_id")
  openId String? @map("open_id")
  state String @default("waiting")
  attempts Int @default(0)
  webConfirmed Boolean @default(false) @map("web_confirmed")
  nativeConfirmed Boolean @default(false) @map("native_confirmed")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id])
  session Session @relation(fields: [sessionId], references: [id])
  @@index([sessionId])
  @@index([appId, openId])
  @@index([expiresAt])
  @@map("wechat_links")
}

// An exchange is consumed before the external request, including unknown results.
// Clients must obtain a fresh wx.login code after any failed exchange.
model WechatCodeRedemption {
  appId     String   @map("app_id")
  codeHash  String   @map("code_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@id([appId, codeHash])
  @@index([expiresAt])
  @@map("wechat_code_redemptions")
}

// Separate identity realm: no relation to product users or their sessions.
model AdminAccount {
  id String @id @db.Uuid
  username String
  realm String
  feishuAppId String? @map("feishu_app_id")
  feishuOpenId String? @map("feishu_open_id")
  tenantKey String? @map("tenant_key")
  permissions String[]
  disabled Boolean @default(false)
  sessions AdminSession[]
  @@unique([realm, username])
  @@unique([realm, feishuAppId, tenantKey, feishuOpenId])
  @@map("admin_accounts")
}
model AdminSession {
  id String @id @db.Uuid
  tokenHash String @unique @map("token_hash") @db.Char(64)
  adminId String? @map("admin_id") @db.Uuid
  account AdminAccount? @relation(fields: [adminId], references: [id])
  realm String
  phase String
  identityHash String? @map("identity_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  @@index([expiresAt])
  @@index([adminId])
  @@map("admin_sessions")
}
model AdminAudit {
  id String @id @db.Uuid
  operatorId String? @map("operator_id") @db.Uuid
  action String
  requestId String @map("request_id")
  result String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@index([createdAt])
  @@map("admin_audit")
}

// Controlled S0 probe realm; deliberately no FK to product users/projects.
model ProbeClip {
  aiRuns ProbeAiRun[]
  printEntry ProbePrintEntry?
  storageScope String @map("storage_scope")
  id String @id @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  clientClipId String @map("client_clip_id") @db.Uuid
  bytes Int
  sha256 String @db.Char(64)
  state String @default("pending")
  durationMs Int? @map("duration_ms")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@unique([ownerId, clientClipId])
  @@map("probe_clips")
}

// A random locator, never a bearer credential. Authorization stays on ProbeClip.
model ProbePrintEntry {
  id String @id @db.VarChar(22)
  clipId String @unique @map("clip_id") @db.Uuid
  clip ProbeClip @relation(fields: [clipId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@map("probe_print_entries")
}

model RecipientType {
  realm     String
  code      String
  label     String
  sortOrder Int     @map("sort_order")
  active    Boolean
  revision  Int     @default(1)

  @@id([realm, code])
  @@map("recipient_types")
}

model PackageDraft {
  id                   String   @id @db.Uuid
  realm                String
  title                String
  revision             Int      @default(1)
  d01                  Json
  admission            Json
  shippingRegionLabels Json     @map("shipping_region_labels")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("package_drafts")
}

model PackageVersion {
  id            String   @id @db.Uuid
  sequence      Int      @unique @default(autoincrement())
  realm         String
  purpose       String
  draftId       String   @map("draft_id") @db.Uuid
  draftRevision Int      @map("draft_revision")
  snapshot      Json
  publicOffer   Json     @map("public_offer")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([realm, draftId, draftRevision])
  @@map("package_versions")
}

// S0 only: immutable input and candidate configuration, independent of product tasks.
model ProbeAiRun {
  generations ProbeAiGeneration[]
  id String @id @db.Uuid
  clipId String @map("clip_id") @db.Uuid
  clip ProbeClip @relation(fields: [clipId], references: [id], onDelete: Cascade)
  input Json
  configuration Json
  configurationHash String @map("configuration_hash") @db.Char(64)
  fence Int @default(0)
  leaseUntil DateTime? @map("lease_until") @db.Timestamptz(3)
  submittedAt DateTime? @map("submitted_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  providerCode String? @map("provider_code")
  attempts Int @default(0)
  state String @default("ready")
  originalTranscript String? @map("original_transcript")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@map("probe_ai_runs")
}

model ProbeAiGeneration {
  id String @id @db.Uuid
  runId String @map("run_id") @db.Uuid
  run ProbeAiRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  kind String
  state String @default("generating")
  transcriptHash String @map("transcript_hash") @db.Char(64)
  output Json?
  usage Json?
  model String?
  failure String?
  startedAt DateTime @default(now()) @map("started_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  @@index([runId])
  @@map("probe_ai_generations")
}

// T10 local verification only. Financial fields/snapshots are immutable.
model PaymentOrder {
  firstCopyCancellationRequired Boolean @default(false) @map("first_copy_cancellation_required")
  productionFrozen Boolean @default(false) @map("production_frozen")
  creationState String @default("active") @map("creation_state")
  id String @id @db.Uuid
  buyerId String @map("buyer_id") @db.Uuid
  appId String @map("app_id")
  openId String @map("open_id")
  merchantId String @map("merchant_id")
  outTradeNo String @unique @map("out_trade_no")
  idempotencyKey String @map("idempotency_key")
  requestHash String @map("request_hash") @db.Char(64)
  amount Int
  currency String
  mode String
  packageVersionId String @map("package_version_id") @db.Uuid
  packageSnapshot Json @map("package_snapshot")
  recipient Json?
  template Json
  shippingRegionCode String @map("shipping_region_code")
  subjectName String? @map("subject_name")
  bookTitle String? @map("book_title")
  state String @default("pending")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@unique([buyerId,idempotencyKey])
  @@index([buyerId,createdAt])
  @@map("payment_orders")
}

model Refund {
 requestWindowStartedAt DateTime? @map("request_window_started_at") @db.Timestamptz(3)
 requestWindowEndsAt DateTime? @map("request_window_ends_at") @db.Timestamptz(3)
 id String @id @db.Uuid
 caseId String @unique @map("case_id") @db.Uuid
 orderId String @map("order_id") @db.Uuid
 projectId String @map("project_id") @db.Uuid
 requesterId String @map("requester_id") @db.Uuid
 requestKey String @map("request_key")
 requestHash String @map("request_hash") @db.Char(64)
 reason String
 state String @default("requested")
 amount Int?
 outRefundNo String @unique @map("out_refund_no")
 providerRefundId String? @unique @map("provider_refund_id")
 rule Json?
 evidenceRef String? @map("evidence_ref")
 approvedBy String? @map("approved_by") @db.Uuid
 approvedAt DateTime? @map("approved_at") @db.Timestamptz(3)
 dueAt DateTime? @map("due_at") @db.Timestamptz(3)
 submittedAt DateTime? @map("submitted_at") @db.Timestamptz(3)
 completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
 productionEvidence String? @map("production_evidence")
 productionEvidenceHash String? @map("production_evidence_hash") @db.Char(64)
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
 @@unique([orderId,requesterId,requestKey])
 @@unique([orderId,id])
 @@index([state,createdAt])
 @@map("refunds")
}
model RefundCommand {
 refundId String @map("refund_id") @db.Uuid
 actorId String @map("actor_id") @db.Uuid
 action String
 key String
 requestHash String @map("request_hash") @db.Char(64)
 payload Json?
 @@id([refundId,actorId,action,key])
 @@map("refund_commands")
}
model RefundInbox {
 eventId String @id @map("event_id")
 refundId String @map("refund_id") @db.Uuid
 payloadHash String @map("payload_hash") @db.Char(64)
 verifiedRefund Json @map("verified_refund")
 verifiedAt DateTime @default(now()) @map("verified_at") @db.Timestamptz(3)
 processedAt DateTime? @map("processed_at") @db.Timestamptz(3)
 @@index([processedAt])
 @@map("refund_inbox")
}

model PaymentSubmission {
 orderId String @id @map("order_id") @db.Uuid
 submittedAt DateTime @default(now()) @map("submitted_at") @db.Timestamptz(3)
 parameters Json?
 @@map("payment_submissions")
}
model PaymentCommand {
 orderId String @map("order_id") @db.Uuid
 action String
 key String
 requestHash String @map("request_hash") @db.Char(64)
 result Json?
 @@id([orderId,action,key])
 @@map("payment_commands")
}

model PaymentTransaction {
 orderId String @id @map("order_id") @db.Uuid
 providerTransactionId String @unique @map("provider_transaction_id")
 paidAt DateTime @map("paid_at") @db.Timestamptz(3)
 amount Int
 currency String
 @@map("payment_transactions")
}
model ProjectSubject {
 boundUserId String? @map("bound_user_id") @db.Uuid
 bindingVersion Int @default(0) @map("binding_version")
 id String @id @db.Uuid
 projectId String @unique @map("project_id") @db.Uuid
 name String?
 @@unique([projectId, id])
 @@map("project_subjects")
}
model FirstCopyEntitlement {
 id String @id @db.Uuid
 orderId String @unique @map("order_id") @db.Uuid
 projectId String @unique @map("project_id") @db.Uuid
 state String @default("available")
 @@map("first_copy_entitlements")
}
model PaymentInbox {
 eventId String @id @map("event_id")
 orderId String @map("order_id") @db.Uuid
 payloadHash String @map("payload_hash") @db.Char(64)
 verifiedPayment Json @map("verified_payment")
 verifiedAt DateTime @default(now()) @map("verified_at") @db.Timestamptz(3)
 processedAt DateTime? @map("processed_at") @db.Timestamptz(3)
 @@index([processedAt])
 @@map("payment_inbox")
}

model ProjectServiceTerms {
 projectId String @id @map("project_id") @db.Uuid
 packageVersionId String @map("package_version_id") @db.Uuid
 policy Json
 activatedAt DateTime @map("activated_at") @db.Timestamptz(3)
 @@map("project_service_terms")
}

model ProjectServiceEvent {
 projectId String @map("project_id") @db.Uuid
 eventId String @map("event_id")
 kind String
 occurredAt DateTime @map("occurred_at") @db.Timestamptz(3)
 supportCaseRef String? @map("support_case_ref")
 operatorId String? @map("operator_id") @db.Uuid
 @@id([projectId,eventId])
 @@index([projectId,occurredAt])
 @@map("project_service_events")
}

model Invitation {
  id         String    @id @db.Uuid
  projectId  String    @map("project_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)

  @@index([projectId])
  @@map("invitations")
}

model BindingRequest {
  id              String  @id @db.Uuid
  invitationId    String  @map("invitation_id") @db.Uuid
  applicantUserId String  @map("applicant_user_id") @db.Uuid
  state           String  @default("pending")
  approvedBy      String? @map("approved_by") @db.Uuid
  noticeVersion   String  @map("notice_version")
  evidenceRef     String  @map("evidence_ref")

  @@unique([invitationId, applicantUserId])
  @@map("binding_requests")
}

model ParticipationCommand {
  projectId      String @map("project_id") @db.Uuid
  action         String
  key            String
  operatorId     String @map("operator_id") @db.Uuid
  requestHash    String @map("request_hash") @db.Char(64)
  bindingVersion Int    @map("binding_version")
  accessEpoch    Int    @map("access_epoch")

  @@id([projectId, action, key])
  @@map("participation_commands")
}

model ConsentRecord {
  id             String   @id @db.Uuid
  sequence       Int      @unique @default(autoincrement())
  projectId      String   @map("project_id") @db.Uuid
  subjectId      String   @map("subject_id") @db.Uuid
  bindingVersion Int      @map("binding_version")
  accessEpoch    Int      @map("access_epoch")
  operatorUserId String?   @map("operator_user_id") @db.Uuid
  operatorAdminId String? @map("operator_admin_id") @db.Uuid
  granteeUserId  String?  @map("grantee_user_id") @db.Uuid
  purpose        String
  granted        Boolean
  noticeVersion  String   @map("notice_version")
  method         String
  evidenceRef    String?   @map("evidence_ref")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([projectId, bindingVersion])
  @@map("consent_records")
}

model CareRequest {
  exportCollectionStamp Json? @map("export_collection_stamp")
  withdrawalPurpose String? @map("withdrawal_purpose")
  id                   String   @id @db.Uuid
  projectId            String   @map("project_id") @db.Uuid
  requesterId          String?   @map("requester_id") @db.Uuid
  requesterSubjectId String? @map("requester_subject_id") @db.Uuid
  operatorId String @map("operator_id") @db.Uuid
  operatorRealm String @map("operator_realm")
  targetUserId         String?   @map("target_user_id") @db.Uuid
  sourceBindingVersion Int      @map("source_binding_version")
  sourceAccessEpoch Int @map("source_access_epoch")
  verificationKey String? @map("verification_key")
  verificationHash String? @map("verification_hash") @db.Char(64)
  verificationEvidence String? @map("verification_evidence")
  verificationNotice String? @map("verification_notice")
  verifiedBy String? @map("verified_by") @db.Uuid
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(3)
  revokedAccessEpoch Int? @map("revoked_access_epoch")
  idempotencyKey       String   @map("idempotency_key")
  requestHash          String   @map("request_hash") @db.Char(64)
  kind                 String
  state                String   @default("open")
  completedBy          String?  @map("completed_by") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([projectId, operatorId, operatorRealm, idempotencyKey])
  @@index([projectId, createdAt])
  @@map("care_requests")
}

model BindingChange {
  id                   String   @id @db.Uuid
  projectId            String   @map("project_id") @db.Uuid
  subjectId            String   @map("subject_id") @db.Uuid
  fromUserId           String?  @map("from_user_id") @db.Uuid
  toUserId             String   @map("to_user_id") @db.Uuid
  sourceBindingVersion Int      @map("source_binding_version")
  bindingVersion       Int      @map("binding_version")
  accessEpoch          Int      @map("access_epoch")
  operatorId           String   @map("operator_id") @db.Uuid
  operatorRealm        String   @map("operator_realm")
  supportCaseId        String?  @map("support_case_id") @db.Uuid
  noticeVersion        String   @map("notice_version")
  method               String
  evidenceRef          String?   @map("evidence_ref")
  requestId            String   @map("request_id")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([projectId, bindingVersion])
  @@map("binding_changes")
}

model AssistedSession {
 id String @id @db.Uuid
 sequence Int @unique @default(autoincrement())
 projectId String @map("project_id") @db.Uuid
 subjectId String @map("subject_id") @db.Uuid
 operatorUserId String @map("operator_user_id") @db.Uuid
 purpose String
 granted Boolean
 noticeVersion String @map("notice_version")
 evidenceRef String? @map("evidence_ref")
 bindingVersion Int @map("binding_version")
 accessEpoch Int @map("access_epoch")
 idempotencyKey String @map("idempotency_key")
 requestHash String @map("request_hash") @db.Char(64)
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
 expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
 @@unique([projectId,operatorUserId,idempotencyKey])
 @@unique([projectId,evidenceRef])
 @@index([projectId,createdAt])
 @@map("assisted_sessions")
}

model AssistedVersionEvidence {
 id String @id @db.Uuid
 projectId String @map("project_id") @db.Uuid
 subjectId String @map("subject_id") @db.Uuid
 operatorUserId String @map("operator_user_id") @db.Uuid
 sessionId String @map("session_id") @db.Uuid
 contentKind String @map("content_kind")
 versionId String @map("version_id") @db.Uuid
 contentHash String @map("content_hash") @db.Char(64)
 noticeVersion String @map("notice_version")
 evidenceRef String? @map("evidence_ref")
