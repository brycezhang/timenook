.manuscript-cover {
  text-align: center;
  min-height: 780rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  border: 1rpx solid #d4c5ac;
  background: #efe5d5;
  padding: 40rpx;
  box-shadow: inset 10rpx 0 0 #d3c4a561;
}
.manuscript-cover .title {
  font-size: 68rpx;
  line-height: 1.5;
}
.manuscript-cover .icon {
  width: 120rpx;
  height: 120rpx;
  margin: 34rpx 0;
}
.manuscript-chapter {
  background: var(--surface);
  padding: 38rpx 28rpx;
  margin-top: 32rpx;
  border: 1rpx solid var(--line);
}
.manuscript-chapter .title {
  font-size: 45rpx;
  margin: 26rpx 0;
}
.manuscript-body {
  display: block;
  white-space: pre-wrap;
  font-size: 29rpx;
  line-height: 1.95;
}
.manuscript-photo {
  width: 100%;
  margin-top: 24rpx;
  border-radius: 8rpx;
}
.live-manuscript {
  font-size: 34rpx;
  line-height: 1.7;
  overflow-wrap: anywhere;
  padding-bottom: 64rpx;
}
.live-manuscript .manuscript-body {
  font-size: 30rpx;
  margin: 20rpx 0;
}
.live-manuscript .btn {
  font-size: 34rpx;
  min-width: 96rpx;
  min-height: 96rpx;
  line-height: 1.5;
  padding: 22rpx;
  white-space: normal;
}
.live-manuscript .note {
  font-size: 29rpx;
}
.book-cover-photo {
  display: block;
  width: 100%;
  height: 420rpx;
  margin: 20rpx auto;
}

.live-manuscript .manuscript-cover {
  max-width: 440rpx;
  min-height: 500rpx;
  margin: 36rpx auto;
  padding: 42rpx;
}
.live-manuscript .manuscript-cover .title {
  font-size: 44rpx;
}
.live-manuscript .manuscript-chapter {
  padding: 42rpx;
  box-shadow: 6rpx 8rpx 0 #e9e1d6;
}
.live-manuscript .manuscript-chapter .title {
  font-size: 44rpx;
  margin: 0 0 28rpx;
}
.live-manuscript .manuscript-body {
  font-family: "Songti SC", "STSong", SimSun, serif;
  font-size: 40rpx;
  line-height: 2.05;
}
.live-manuscript .card {
  padding-top: 38rpx;
  border-top: 1rpx solid var(--line);
}
