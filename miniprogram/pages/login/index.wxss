.login-photo {
  display: block;
  width: 100%;
  height: 440rpx;
  border-radius: 28rpx;
}
.login-page {
  padding-bottom: 330rpx;
}
.agreement-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.agreement-sheet {
  width: 100%;
  max-width: 750rpx;
  box-sizing: border-box;
  padding: 48rpx 36rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #faf8f3;
  border-radius: 32rpx 32rpx 0 0;
}
.agreement-check {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: transparent;
  text-align: left;
  padding: 24rpx 0;
  font-size: 30rpx;
  line-height: 1.6;
}
.agreement-check::after {
  border: 0;
}
.check-box {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  line-height: 40rpx;
  text-align: center;
  border: 2rpx solid #8a826f;
  border-radius: 8rpx;
}
.check-box.checked {
  background: #526d59;
  color: white;
  border-color: #526d59;
}
