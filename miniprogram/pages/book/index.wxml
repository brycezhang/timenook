<app-loading wx:if="{{pageLoading}}" variant="book" />
<block wx:else>
<view class="s-page"><view class="s-subtitle book-state">{{stateLabel}}</view><view class="s-book"><view class="s-subtitle">{{title}}</view><view class="s-muted">{{context.cover.salutation}}</view><image wx:if="{{coverImage}}" src="{{coverImage}}" mode="aspectFill" /></view><button class="s-row" bindtap="cover"><text>调整书封</text><text class="s-arrow">›</text></button><button class="s-row directory-entry" bindtap="directory"><view><text>章节目录</text><view class="s-muted">共 {{context.directory.chapters.length || 0}} 个章节</view></view><text class="s-arrow">›</text></button><button wx:if="{{context.current.state==='ready'}}" class="s-row" bindtap="manuscript"><text>完整书稿预览</text><text class="s-arrow">›</text></button><button class="s-row" bindtap="production"><text>制作与物流</text><text class="s-arrow">›</text></button><view class="s-error">{{status}}</view><view wx:if="{{context && !context.eligibleStories.length}}" class="s-empty">先记录一个故事，再来看看你的书。<button class="s-link" bindtap="record">开始记录</button></view><view class="s-dock"><button wx:if="{{context.current.state==='ready' && !dirty}}" class="s-button" bindtap="print" disabled="{{busy}}">印刷我的书</button><button wx:else class="s-button" bindtap="generate" loading="{{busy || context.current.state==='queued' || context.current.state==='rendering'}}" disabled="{{busy || !context.eligibleStories.length || context.current.state==='queued' || context.current.state==='rendering'}}">{{context.current.state==='failed'?'重新生成书稿':context.current.state==='queued'||context.current.state==='rendering'?'正在生成书稿':context.current?'生成新版书稿':'生成我的书'}}</button></view></view>
</block>
