.story-page {
  gap: 22px;
}
.story-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}
.story-placement {
  flex: 1;
  min-width: 0;
  min-height: 44px;
  padding: 4px 0;
  text-align: left;
  display: flex;
  align-items: center;
  gap: 7px;
  color: #46563c;
  font-size: 13px;
  line-height: 1.7;
}
.story-placement text {
  min-width: 0;
  overflow-wrap: anywhere;
}
.story-placement image,
.story-edit image {
  width: 16px;
  height: 16px;
  flex-shrink: 0;
}
.story-edit {
  flex-shrink: 0;
}
.story-intro {
  display: flex;
  flex-direction: column;
  gap: 9px;
}
.story-heading {
  font-size: 28px;
  font-weight: 700;
  line-height: 1.3;
  letter-spacing: -0.8px;
  overflow-wrap: anywhere;
}
.live-audio-list {
  display: flex;
  flex-direction: column;
  gap: 14px;
}
.story-audio-number {
  font-size: 12px;
  color: #756859;
  margin-bottom: 6px;
}
.live-audio-card {
  padding: 16px;
  border: 1px solid #ded4c6;
  border-radius: 20px;
  background: #edf0e7;
  display: flex;
  align-items: center;
  gap: 12px;
  width: 100%;
  min-width: 0;
}
.live-audio-button {
  width: 48px;
  height: 48px;
  min-width: 48px;
  padding: 0;
  border-radius: 50%;
  background: #46563c;
  display: flex;
  align-items: center;
  justify-content: center;
}
.live-audio-button image {
  width: 21px;
  height: 21px;
}
.live-audio-button[disabled] {
  background: #46563c;
  opacity: 0.6;
}
.live-audio-timeline {
  flex: 1;
  min-width: 0;
}
.live-audio-slider {
  margin: 0 10px;
  height: 44px;
  min-width: 0;
}
.live-audio-times {
  display: flex;
  justify-content: space-between;
  padding: 0 2px;
  font-size: 12px;
  line-height: 1.5;
  font-variant-numeric: tabular-nums;
  color: #756859;
}
.story-body {
  display: flex;
  flex-direction: column;
  gap: 18px;
  font-size: 17px;
  line-height: 1.95;
  letter-spacing: 0.1px;
  overflow-wrap: anywhere;
}
.live-story-photo {
  display: flex;
  flex-direction: column;
  gap: 9px;
}
.live-photo-image,
.live-photo-placeholder {
  width: 100%;
  height: 220px;
  border-radius: 19px;
  overflow: hidden;
}
.live-photo-caption {
  font-size: 12px;
  line-height: 1.7;
  color: #756859;
}
.story-processing-preview {
  padding: 18px;
  border: 1px solid #ded4c6;
  border-radius: 20px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}
.story-processing-preview > view {
  height: 12px;
  background: #f1e9de;
  border-radius: 5px;
}
.story-processing-preview > view:nth-child(3) {
  width: 95%;
}
.story-processing-preview > view:nth-child(4) {
  width: 88%;
}
.story-processing-preview > view:nth-child(6) {
  width: 69%;
}
.story-processing-preview .processing-heading {
  height: 22px;
  width: 72%;
  border-radius: 6px;
  background: #e8ded0;
}
.story-processing-preview .processing-photo {
  height: 140px;
  border-radius: 14px;
}
.story-failure-intro {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20px;
  text-align: center;
}
.story-failure-icon {
  width: 82px;
  height: 82px;
  border-radius: 26px;
  background: #edf0e7;
  display: flex;
  align-items: center;
  justify-content: center;
}
.story-failure-icon image {
  width: 36px;
  height: 36px;
}
.story-failure-intro .story-heading {
  font-size: 26px;
}
.story-failed.with-dock {
  padding-bottom: calc(164px + env(safe-area-inset-bottom));
}

.story-state-space {
  height: 22px;
}
.story-state-tail {
  height: 8px;
}
@media (max-height: 740px) {
  .story-page {
    gap: 16px;
  }
}
