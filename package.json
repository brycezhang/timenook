    "check:native": "node scripts/check-native.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "lucide-static": "^0.468.0",
    "miniprogram-api-typings": "^4.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "type": "module"
}
