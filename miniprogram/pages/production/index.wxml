<view class="s-page"><view class="s-title">{{label}}</view><view wx:if="{{view.current.tracking}}" class="s-card"><view class="s-subtitle">{{view.current.tracking.carrier}}</view><text selectable>{{view.current.tracking.number}}</text></view><view wx:if="{{view.current.state==='cancellation_pending'}}" class="s-muted">取消结果正在核实，暂时不能再次提交印刷。</view><button wx:if="{{view.reservation}}" class="s-row" bindtap="preview"><text>查看本次印刷书稿</text><text>›</text></button><button wx:if="{{view.current.state==='cancelled'}}" class="s-button s-space" bindtap="book">修改后重新提交</button><button wx:if="{{view && !view.reservation}}" class="s-button s-space" bindtap="print">去印刷我的书</button><view class="s-error">{{status}}</view><button class="s-link" bindtap="terms">使用条款与客服</button><view class="s-dock"><button class="s-button secondary" bindtap="refresh" loading="{{busy}}" disabled="{{busy}}">刷新进度</button></view></view>