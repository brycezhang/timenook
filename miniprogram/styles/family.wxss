page {
  background: #fff;
}
.family-page {
  min-height: calc(100vh - 68px);
}
.family-photo {
  width: 100%;
  height: 210px;
  overflow: hidden;
  border-radius: 18px;
  position: relative;
  flex-shrink: 0;
  background: #e8ded0;
}
.family-photo image {
  width: 300%;
  max-width: none;
  height: 100%;
  transform: translateX(-33.333333%);
  display: block;
}
.family-photo.join-photo {
  height: 150px;
}
.family-benefit-copy {
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.family-caption {
  font-size: 12px;
  line-height: 1.55;
  color: #756859;
  font-weight: 400;
}
.family-notice {
  font-size: 12px;
  line-height: 1.75;
  color: #756859;
}
.family-relations {
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.family-required {
  color: #756859;
  font-size: 12px;
  font-weight: 400;
}
.family-options {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 9px;
}
.family-option {
  width: 100%;
  min-width: 0;
  min-height: 48px;
  border: 1px solid #ded4c6;
  border-radius: 14px;
  padding: 10px 5px;
  font-size: 16px;
  font-weight: 600;
  line-height: 1.5;
  color: #382c24;
  background: #fff;
}
.family-option.selected {
  border-color: #46563c;
  background: #edf0e7;
  color: #46563c;
}
.family-agreement {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  color: #382c24;
  font-size: 12px;
  line-height: 1.75;
  min-height: 44px;
  padding-top: 2px;
}
.family-agreement checkbox {
  flex-shrink: 0;
  transform: scale(0.8);
  transform-origin: top left;
  width: 28px;
  margin-top: 2px;
}
.family-terms {
  width: 100%;
  margin-top: 4px;
}
