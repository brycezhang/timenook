.profile {
  display: flex;
  gap: 28rpx;
  align-items: center;
  padding: 36rpx 0;
}
.avatar {
  width: 124rpx;
  height: 124rpx;
  background: #ece7db;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.avatar image {
  width: 66rpx;
  height: 66rpx;
}

.nickname-input {
  background: #fff;
  border: 1rpx solid #d8d1c3;
  border-radius: 16rpx;
  padding: 24rpx;
  min-height: 64rpx;
  font-size: 36rpx;
}
.profile .s-subtitle {
  overflow-wrap: anywhere;
}
