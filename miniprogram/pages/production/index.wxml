<import src="../../templates/print-book.wxml" />
<tn-navigation title="{{screen === 'shipped' ? '书籍已寄出' : screen === 'delivered' ? '书籍已送达' : screen === 'cancelled' ? '制作已取消' : '制作进度'}}" />
<app-loading wx:if="{{pageLoading}}" variant="book" />
<view wx:else class="tn-page with-dock print-page {{screen === 'production' || screen === 'delivered' ? 'double-dock' : ''}}">
  <block wx:if="{{view}}">
    <view class="book-state-space" />
    <view class="book-state-intro"><view class="book-state-icon"><image src="/assets/icons/{{screen === 'shipped' ? 'package' : screen === 'delivered' ? 'check' : screen === 'cancelled' ? 'x' : 'modern-book'}}.svg" /></view><view class="print-state-copy"><view class="print-state-title">{{label}}</view><view wx:if="{{screen === 'cancelled'}}" class="tn-muted">内容已保留，可重新提交。</view><view wx:elif="{{view.current.state === 'cancellation_pending'}}" class="tn-muted">取消结果确认前，暂不能重新提交。</view></view></view>
    <view class="book-state-tail" />
    <block wx:if="{{screen === 'production' && view.reservation}}">
      <template wx:if="{{book}}" is="print-book" data="{{book, coverImage, caption: '制作版本 V' + book.version}}" />
      <view class="tn-card"><view><view wx:for="{{steps}}" wx:key="title" class="print-step"><view class="print-step-mark {{item.done ? 'done' : ''}}"><image wx:if="{{item.done}}" src="/assets/icons/check-light.svg" /></view><view class="print-step-copy"><text class="print-step-title {{item.done ? 'done' : ''}}">{{item.title}}</text><text class="print-step-caption">{{item.caption}}</text></view></view></view></view>
    </block>
    <block wx:elif="{{screen === 'shipped'}}">
      <view wx:if="{{view.deliveryAddress}}" class="tn-card"><text class="production-recipient">{{view.deliveryAddress.recipientName}} · {{maskedPhone}}</text><text class="print-small">{{view.deliveryAddress.regionLabel}} {{view.deliveryAddress.detail}}</text></view>
      <view class="tn-card"><view class="print-card-heading"><text class="print-card-title">配送信息</text><text class="print-badge active">已寄出</text></view><button wx:if="{{view.current.tracking}}" class="tracking-number" bindtap="copyTracking"><text>{{view.current.tracking.carrier}}</text><text selectable>{{view.current.tracking.number}}</text><text class="tracking-copy">复制单号</text></button><view><view wx:for="{{steps}}" wx:key="title" class="print-step"><view class="print-step-mark {{item.done ? 'done' : ''}}"><image wx:if="{{item.done}}" src="/assets/icons/check-light.svg" /></view><view class="print-step-copy"><text class="print-step-title {{item.done ? 'done' : ''}}">{{item.title}}</text><text class="print-step-caption">{{item.caption}}</text></view></view></view></view>
    </block>
    <block wx:elif="{{screen === 'delivered'}}">
      <view wx:if="{{book}}" class="delivered-book"><view class="book-model"><text class="book-model-title">{{book.snapshot.cover.title}}</text><text wx:if="{{book.snapshot.cover.salutation}}" class="book-model-message">{{book.snapshot.cover.salutation}}</text><image wx:if="{{coverImage}}" class="book-model-image" src="{{coverImage}}" mode="aspectFill" /><text class="book-model-brand">时光故事</text></view></view>
      <view wx:if="{{book}}" class="tn-card"><text class="print-book-title">{{book.snapshot.cover.title}}</text><text class="print-small">已交付 · V{{book.version}} · 首本实体书</text></view>
    </block>
    <view class="tn-dock">
      <button wx:if="{{screen === 'cancelled'}}" class="tn-button" bindtap="book"><image class="tn-icon" src="/assets/icons/book-open-light.svg" />查看当前书稿</button>
      <button wx:elif="{{screen === 'shipped'}}" class="tn-button" bindtap="projectHome"><image class="tn-icon" src="/assets/icons/book-open-light.svg" />返回这本书</button>
      <block wx:elif="{{view.reservation}}"><button class="tn-button {{screen === 'production' ? 'tn-secondary' : ''}}" bindtap="preview"><image class="tn-icon" src="/assets/icons/{{screen === 'production' ? 'modern-book' : 'book-open-light'}}.svg" />查看制作书稿</button><button wx:if="{{screen === 'delivered'}}" class="tn-link" bindtap="record">继续记录新故事</button><button wx:else class="tn-link" bindtap="projectHome">回到这本书</button></block>
      <button wx:else class="tn-button" bindtap="print">去制作</button>
    </view>
  </block>
  <view wx:if="{{status}}" class="tn-error">{{status}}</view><button wx:if="{{status || !view}}" class="tn-link" bindtap="refresh" loading="{{busy}}" disabled="{{busy}}">重新读取进度</button>
</view>
