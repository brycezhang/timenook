<block wx:if="{{live}}">
  <view class="page live-manuscript">
    <view class="title">完整书稿</view>
    <view wx:if="{{status}}" class="note section">{{status}}</view>
    <block wx:if="{{version}}">
      <view class="manuscript-cover section"><view class="eyebrow">时光里 · 岁月成书</view><view class="title">{{version.snapshot.cover.title}}</view><view wx:if="{{version.snapshot.cover.salutation}}" class="cover-salutation-display">{{version.snapshot.cover.salutation}}</view><image wx:if="{{coverImage}}" class="book-cover-photo" src="{{coverImage}}" mode="aspectFit" /><view wx:if="{{version.snapshot.cover.photo}}" class="note">{{version.snapshot.cover.photo.caption}}</view><view>第 {{version.version}} 版 · {{version.pageCount || '待核对'}} 页</view></view>
      <button class="btn section" bindtap="openPdf" disabled="{{busy || version.state !== 'ready'}}">打开完整 PDF</button>
      <view wx:if="{{coverStatus}}" class="note section">{{coverStatus}}</view>
      <view class="note section">请逐页核对 PDF 中的全文、照片、原声入口和页数。</view>
      <view wx:for="{{version.snapshot.chapters}}" wx:for-item="chapter" wx:key="key">
        <view class="title section">{{chapter.title}}</view>
        <view wx:for="{{chapter.stories}}" wx:for-item="story" wx:key="id" class="manuscript-chapter">
          <view class="title">{{story.title}}</view>
          <text wx:for="{{story.paragraphs}}" wx:key="index" class="manuscript-body">{{item}}</text>
          <view wx:for="{{story.photos}}" wx:key="assetId" class="note section">照片说明：{{item.caption || '无说明'}}。照片见完整 PDF。</view>
          <view class="note section">{{story.provenance.label}}</view>
          <view wx:if="{{story.entry}}" class="note section">本篇关联本人原声，入口位置见完整 PDF。</view>
        </view>
      </view>
      <view class="note section">{{version.snapshot.provenance.notice}}</view>
      <view class="note section">{{version.snapshot.specification.status === 'internal-acceptance-candidate' ? '内部验收候选规格' : '合成测试规格'}} {{version.snapshot.specification.widthMm}} × {{version.snapshot.specification.heightMm}} mm，尚未开放正式生产。</view>
      <view wx:if="{{confirmations}}" class="section card">
        <view class="section-title">核对本版完整 PDF</view>
        <view class="note section">讲述者：{{confirmations.confirmations.narrator ? '已确认本版' : '待确认'}} · 发起人：{{confirmations.confirmations.initiator ? '已确认本版' : '待确认'}}</view>
        <view wx:if="{{!confirmations.physicalProduction}}" class="note section">本次仅确认书稿内容，无付款、收货地址或实体书生产义务。</view>
        <block wx:if="{{confirmations.canConfirm}}">
          <button class="check-row section" bindtap="chooseContentConfirmation" disabled="{{busy}}"><view class="check-box {{confirmChecked ? 'on' : ''}}"><image class="icon" src="/assets/icons/check-light.svg" /></view><text>我已逐页核对本版完整 PDF，确认文字、照片与原声入口</text></button>
          <label class="section">本次核对说明<input value="{{confirmationEvidence}}" bindinput="contentEvidence" maxlength="160" disabled="{{busy}}" placeholder="请用自己的话记录本次核对结果" /></label>
          <button class="btn section" bindtap="confirmContent" disabled="{{busy || !confirmChecked}}">以{{confirmations.role === 'narrator' ? '讲述者' : '发起人'}}身份确认本版</button>
        </block>
      </view>
      <button wx:if="{{version.snapshot.specification.status !== 'internal-acceptance-candidate'}}" class="btn section" bindtap="print" disabled="{{busy || version.state !== 'ready'}}">核对本版确认与首本制作</button>
    </block>
    <button class="btn secondary section" bindtap="refresh" disabled="{{busy}}">重新核对本版状态</button>
    <button class="btn secondary section" bindtap="book">返回成书总览</button>
  </view>
</block>
<block wx:else="">
<view class="page with-dock manuscript"
  ><view class="manuscript-cover"
    ><view class="eyebrow">时 光 里 · 岁 月 成 书</view
    ><view class="title">{{p.title}}</view
    ><view class="serif">爱与岁月的故事</view
    ><image class="icon" src="/assets/icons/sprout.svg" /><view
      class="small muted"
      >书稿第{{p.revision}}版 · {{stories.length}}篇故事</view
    ></view
  ><view wx:for="{{stories}}" wx:key="id" class="manuscript-chapter"
    ><view class="eyebrow">第{{index+1}}章 · {{item.chapter}}</view
    ><view class="title">{{item.title}}</view
    ><text class="manuscript-body">{{item.body}}</text
    ><image
      wx:for="{{item.photos}}"
      wx:for-item="photo"
      wx:key="*this"
      src="{{photo}}"
      mode="widthFix"
      class="manuscript-photo"
    /><button
      wx:if="{{item.confirmedVersion!==item.version}}"
      class="btn secondary"
      data-id="{{item.id}}"
      bindtap="story"
      >先确认这篇故事</button
    ></view
  ><view wx:if="{{!stories.length}}" class="empty"
    >还没有入书的故事，请先讲一段往事。</view
  ><view class="note section"
    >此处完整呈现当前入书文字与照片。真实分页、原声二维码和印刷PDF需由服务端生成，本次仅体验确认流程。</view
  ><button class="check-row" bindtap="content"
    ><view class="check-box {{content?'on':''}}"
      ><image class="icon" src="/assets/icons/check-light.svg" /></view
    ><text>讲述者：我已读过，允许这些故事入书</text></button
  ><button class="check-row" bindtap="layout"
    ><view class="check-box {{layout?'on':''}}"
      ><image class="icon" src="/assets/icons/check-light.svg" /></view
    ><text>购买子女：我已检查书名、文字和照片</text></button
  ></view
><view class="dock"
  ><button
    class="btn"
    disabled="{{!content || !layout || pending>0 || !stories.length}}"
    bindtap="approve"
    >确认这一版，填写收货信息</button
  ><view class="dock-note"
    >{{pending?'请先确认所有待确认故事':'本机演示 · 不会提交真实生产'}}</view
  ></view
>

</block>
