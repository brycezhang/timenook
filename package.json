{
  "name": "timenook",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm run build:frontend && pnpm --filter @timenook/contracts build && pnpm --filter @timenook/api build",
    "typecheck": "pnpm run typecheck:frontend && pnpm --filter @timenook/contracts build && pnpm --filter @timenook/api typecheck",
    "test": "pnpm run test:frontend && pnpm --filter @timenook/api test",
    "check": "pnpm run typecheck && pnpm test && pnpm run build",
    "check:native": "node scripts/check-native.mjs",
    "build:frontend": "node scripts/build.mjs && vite build --outDir dist/preview",
    "typecheck:frontend": "tsc --noEmit && tsc -p tsconfig.preview.json --noEmit",
    "test:frontend": "tsx --test tests/*.test.ts",
    "dev:api": "pnpm -r --filter @timenook/api... build && pnpm --filter @timenook/api start",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down",
    "db:generate": "pnpm --filter @timenook/api db:generate",
    "db:migrate": "pnpm --filter @timenook/api db:migrate",
    "api:openapi": "pnpm --filter @timenook/contracts build && pnpm --filter @timenook/api openapi"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "lucide-static": "^0.468.0",
    "miniprogram-api-typings": "^4.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.23.4 <23",
    "pnpm": ">=10.34.7 <11"
  }
}
