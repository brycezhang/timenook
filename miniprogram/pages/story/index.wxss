.story-title {
  margin-top: 18rpx;
  font-size: 52rpx;
}
.story-meta {
  margin: 24rpx 0 32rpx;
}
.audio-row {
  display: flex;
  align-items: center;
  text-align: left;
  gap: 20rpx;
  background: #eeefe5;
  border-radius: 18rpx;
  padding: 20rpx 24rpx;
  width: 100%;
  font-size: 30rpx;
}
.audio-row .badge-icon {
  width: 68rpx;
  height: 68rpx;
  background: #e0e5d3;
}
.story-body {
  margin: 40rpx 0;
}
.paragraph {
  display: block;
  font-size: 38.5rpx;
  line-height: 1.9;
  margin-bottom: 34rpx;
  color: #3e372e;
}
.add-photo {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  font-size: 28rpx;
  border: 2rpx dashed #cec1ad;
  border-radius: 16rpx;
  min-height: 130rpx;
  color: var(--muted);
  width: 100%;
}
.story-actions {
  display: flex;
  justify-content: space-around;
  margin-top: 20rpx;
}
.photos {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 20rpx;
}
.photos image {
  width: calc(50% - 5rpx);
  height: 240rpx;
  border-radius: 12rpx;
}

.live-story {
  padding-bottom: 60rpx;
}
.live-stage,
.live-save,
.live-error,
.live-origin,
.live-reviews,
.live-review {
  font-size: 40rpx;
  line-height: 1.7;
}
.live-stage {
  margin: 28rpx 0;
}
.live-save,
.live-version,
.live-source-label {
  color: var(--muted);
  font-size: 34rpx;
  line-height: 1.6;
}
.live-error {
  margin-top: 24rpx;
  color: #8d342b;
}
.live-controls {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin: 32rpx 0;
}
.live-controls .btn {
  min-height: 96rpx;
}
.live-origin {
  padding: 22rpx;
  border-radius: 16rpx;
  background: #eeefe5;
}
.live-version {
  margin-top: 18rpx;
}
.live-story .paragraph {
  font-size: 40rpx;
  margin-bottom: 10rpx;
}
.live-paragraph {
  margin-bottom: 36rpx;
}
.live-reviews {
  padding: 26rpx;
  border: 2rpx solid #ded4c2;
  border-radius: 16rpx;
}
.live-review {
  margin-top: 24rpx;
}
.live-audio-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin: 28rpx 0;
}
.live-audio-card {
  padding: 22rpx 24rpx 14rpx;
  border: 2rpx solid #dce1ce;
  border-radius: 20rpx;
  background: #eeefe5;
}
.live-audio-button {
  display: flex;
  align-items: center;
  gap: 20rpx;
  width: 100%;
  min-height: 112rpx;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  text-align: left;
  line-height: 1.5;
  color: #3e4931;
}
.live-audio-button::after { border: 0; }
.live-audio-card.is-playing { background: #e4e8d8; }
.live-audio-button[disabled] { opacity: 0.65; color: #3e4931; }
.live-audio-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #697657;
}
.live-audio-icon image { width: 32rpx; height: 32rpx; }
.live-audio-copy { flex: 1; min-width: 0; }
.live-audio-label { display: block; font-size: 32rpx; font-weight: 500; }
.live-audio-status { display: block; margin-top: 4rpx; font-size: 24rpx; color: #747c68; }
.live-audio-wave { display: flex; align-items: center; gap: 5rpx; height: 40rpx; }
.live-audio-wave view { width: 5rpx; height: 14rpx; border-radius: 4rpx; background: #899775; }
.live-audio-wave view:nth-child(2n) { height: 28rpx; }
.live-audio-wave view:nth-child(3n) { height: 40rpx; }
.live-audio-timeline { margin-top: 8rpx; }
.live-audio-slider { display: block; width: 100%; margin: 0; min-height: 44rpx; accent-color: #697657; }
.live-audio-times { display: flex; justify-content: space-between; font-size: 24rpx; color: #747c68; font-variant-numeric: tabular-nums; }
.live-transcripts {
  margin-top: 32rpx;
  padding: 26rpx;
  border: 2rpx solid #ded4c2;
  border-radius: 16rpx;
}
.live-transcript {
  margin-top: 24rpx;
}
.live-transcript .paragraph {
  font-size: 34rpx;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
.live-story .btn {
  font-size: 40rpx;
  min-height: 96rpx;
  min-width: 96rpx;
  line-height: 1.5;
  white-space: normal;
  padding: 22rpx;
}
.live-decision {
  font-size: 40rpx;
  line-height: 1.7;
}
.decision-evidence {
  box-sizing: border-box;
  width: 100%;
  min-height: 160rpx;
  border: 2rpx solid #c7bb9e;
  border-radius: 12rpx;
  padding: 22rpx;
  font-size: 40rpx;
  line-height: 1.7;
  margin: 20rpx 0;
}

.live-controls .btn {
  font-size: 32rpx;
}
.live-story .live-stage,
.live-story .live-save,
.live-story .live-version,
.live-story .live-source-label {
  font-size: 27rpx;
}
.live-story .live-reviews,
.live-story .live-review,
.live-story .live-origin,
.live-story .live-decision {
  font-size: 32rpx;
}
.live-story .btn {
  font-size: 34rpx;
}

.live-story .story-title { margin-top: 8rpx; }
.live-story .story-body { margin-top: 36rpx; }
.live-story .link { min-height: 96rpx; font-size: 32rpx; }

.live-story .story-title {
  font-family: var(--serif);
  font-size: 54rpx;
}
.live-story .story-body {
  margin-top: 50rpx;
}
.live-story .paragraph {
  font-family: var(--serif);
  font-size: 40rpx;
  line-height: 2.05;
  letter-spacing: 1rpx;
}
.live-story .live-source-label {
  font-size: 25rpx;
}
.live-decision {
  border-top: 1rpx solid #c9bfaf;
  margin-top: 52rpx;
  padding-top: 40rpx;
}
.decision-copy {
  font-size: 32rpx;
  line-height: 1.9;
}
.decision-footnote {
  margin-top: 22rpx;
  font-size: 25rpx;
  color: var(--muted);
}
.reading-tools {
  margin-top: 30rpx;
  width: 100%;
}
