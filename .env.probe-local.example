# Copy to .env.probe-local, chmod 600, and choose a private absolute path.
NODE_ENV=development
AUDIO_PROBE_ENABLED=local-simulator
AUDIO_PROBE_STORAGE_ROOT=/absolute/path/to/timenook/.probe-local
AUDIO_PROBE_SESSION_TTL=3600
# FFMPEG_PATH=/absolute/path/to/pinned/bin/ffmpeg
# FFPROBE_PATH=/absolute/path/to/pinned/bin/ffprobe
# Later controlled cloud integration: set AUDIO_PROBE_ENABLED=oss and supply independent short-lived STS.
# TIMENOOK_PROBE_OSS_BUCKET=
# TIMENOOK_PROBE_OSS_REGION=cn-hangzhou
# TIMENOOK_PROBE_OSS_ACCESS_KEY_ID=
# TIMENOOK_PROBE_OSS_ACCESS_KEY_SECRET=
# TIMENOOK_PROBE_OSS_SECURITY_TOKEN=
# TIMENOOK_PROBE_OSS_EXPIRES_AT=
# Shared deed long-lived credentials: explicit server-only static mode, with a project prefix.
# Never configure SECURITY_TOKEN/EXPIRES_AT in static mode.
# TIMENOOK_PROBE_OSS_CREDENTIAL_MODE=static
# TIMENOOK_PROBE_OSS_KEY_PREFIX=timenook/probe
# T03 optional candidate AI probe; deliberately no production/model/resource defaults.
# Shared deed OSS/DeepSeek sources and ASR setup: docs/development-shared-services.md.
# Fill TIMENOOK_PROBE_DOUBAO_API_KEY in private .env.probe-local; leave AI disabled until complete.
# Requires AUDIO_PROBE_ENABLED=oss for real provider requests; never use private samples without authorization.
# AI_PROBE_ENABLED=candidate
# TIMENOOK_PROBE_AI_CONFIG_VERSION=
# TIMENOOK_PROBE_DOUBAO_API_KEY=
# TIMENOOK_PROBE_DOUBAO_RESOURCE_ID=
# TIMENOOK_PROBE_DOUBAO_FETCH_WINDOW_SECONDS=
# TIMENOOK_PROBE_DEEPSEEK_API_KEY=
# TIMENOOK_PROBE_DEEPSEEK_BASE_URL=https://cf.api.fan/v1
# TIMENOOK_PROBE_DEEPSEEK_MODEL=
# TIMENOOK_PROBE_DEEPSEEK_MAX_TOKENS=
