.tabs {
  position: fixed;
  z-index: 5;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background: #f8f4ed;
  border-top: 1rpx solid #e5ddcf;
  padding: 12rpx 0 calc(14rpx + env(safe-area-inset-bottom));
}
.tab {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  min-height: 96rpx;
  margin: 0;
  padding: 0;
  background: transparent;
  border: 0;
  border-radius: 0;
  line-height: 1.5;
  font-size: 23rpx;
  color: #827b6d;
}
.tab::after {
  border: 0;
}
.tab.active {
  color: #566143;
  font-weight: 600;
}
.icon {
  width: 40rpx;
  height: 40rpx;
}
.tab-label {
  display: block;
  box-sizing: border-box;
  width: 100%;
  padding: 0 12rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
