.original-audio-page {
  padding: 48rpx 36rpx 80rpx;
  color: #383b35;
  font-size: 40rpx;
  line-height: 1.6;
}
.eyebrow {
  font-size: 26rpx;
  letter-spacing: 3rpx;
  color: #6e7863;
  margin-bottom: 18rpx;
}
.audio-title {
  font-size: 64rpx;
  line-height: 1.3;
  font-weight: 600;
}
.audio-intro {
  margin: 24rpx 0 38rpx;
}
.audio-card {
  padding: 32rpx;
  background: #fffdf8;
  border: 1rpx solid #e7e4d9;
  border-radius: 20rpx;
}
.story-title {
  font-size: 46rpx;
  font-weight: 600;
  overflow-wrap: anywhere;
}
.version-note,
.access-note {
  color: #697260;
  font-size: 30rpx;
  margin-top: 16rpx;
  overflow-wrap: anywhere;
}
.clip-row {
  border-top: 1rpx solid #e7e4d9;
  padding-top: 24rpx;
  margin-top: 28rpx;
}
.clip-label {
  margin-bottom: 18rpx;
}
.audio-button {
  box-sizing: border-box;
  width: 100%;
  min-height: 100rpx;
  padding: 20rpx 24rpx;
  margin-top: 24rpx;
  border-radius: 12rpx;
  border: 0;
  background: #526443;
  color: #fffdf8;
  font-size: 36rpx;
  line-height: 1.6;
  font-weight: 500;
}
.audio-button::after {
  border: 0;
}
.audio-button[disabled] {
  opacity: 0.55;
}
.secondary {
  color: #47563a;
  background: #e8ecdf;
}
.text-button {
  background: transparent;
  color: #626b5a;
}
.locked-title {
  margin-bottom: 20rpx;
  font-weight: 600;
}
.audio-status {
  margin-top: 30rpx;
  padding: 24rpx;
  background: #f1eadc;
  border-radius: 12rpx;
  overflow-wrap: anywhere;
}
.waiting {
  margin-top: 24rpx;
}
.boundary-note {
  color: #6c6e62;
  font-size: 30rpx;
  margin-top: 36rpx;
}
