<view wx:if="{{mode === 'live'}}" class="page">
  <view class="title">邀请与参与管理</view>
  <view class="soft section">{{participation.policyStatus === 'internal-acceptance' ? '内部功能验收 · 无付款，不发起实体书生产。' : '邀请和账号绑定不代替本人用途授权。'}}{{participation.noticeText}}</view>
  <view class="section note">请本人申请后，在线下核对账号再确认。付款和邀请转发都不会授予资料权限。</view>
  <view wx:if="{{status}}" class="soft section">{{status}}</view>
  <button wx:if="{{!loggedIn}}" class="btn section" bindtap="loginLive" disabled="{{busy}}">微信登录后继续邀请</button>
  <button class="link" bindtap="refreshLive" disabled="{{busy}}">重新查询参与状态</button>
  <view wx:if="{{participation}}" class="section">
    <view class="small muted">项目：{{participation.projectId}}</view>
    <view>绑定版本：{{participation.bindingVersion}}</view>
    <button class="btn section" bindtap="share" disabled="{{busy || participation.bindingVersion > 0 || (participation.policyStatus !== 'synthetic-only' && participation.policyStatus !== 'internal-acceptance')}}">准备本人邀请</button>
    <button wx:if="{{inviteToken}}" class="btn secondary section" bindtap="copyInvitation">复制网页邀请链接</button>
    <button wx:if="{{inviteToken}}" class="btn secondary section" open-type="share">发送已准备的邀请</button>
    <view wx:if="{{inviteToken}}" class="note">邀请仅用于申请参与，24小时到期；重新准备会使旧邀请失效。</view>
    <view wx:for="{{requests}}" wx:key="id" class="paper section">
      <view>待核对的申请账号</view><view class="small muted">{{item.applicantUserId}}</view>
      <button class="btn secondary section" data-id="{{item.id}}" bindtap="approve" disabled="{{busy}}">已核对本人，确认绑定</button>
    </view>
    <view wx:if="{{participation.bindingVersion > 0}}" class="section note">已绑定。本人须分别授权采集、AI 和共享；换绑请由本人或发起人提交客服申请。</view>
  </view>
  <button class="link" bindtap="project">返回首页</button>
</view>
<block wx:else="">
<view class="page"
  ><view class="center"
    ><view class="success-icon"
      ><image class="icon" src="/assets/icons/check-light.svg" /></view
    ><view class="title"
      >一本关于{{p.recipient}}的书，<text class="line-break">{{'\n'}}</text>从你的心意开始。</view
    ><view class="subtitle"
      >项目已建立，邀请{{p.recipient}}一起留下回忆</view
    ></view
  ><view class="invitation-card section"
    ><view class="row"
      ><image class="icon" src="/assets/icons/leaf.svg" /><text class="serif"
        >时光里 · 岁月成书</text
      ></view
    ><view class="row section"
      ><image class="cover-mini" src="{{bookImage}}" mode="aspectFill" /><view
        class="grow"
        ><view class="serif section-title">{{p.recipient}}，想更懂你</view
        ><view class="note"
          >想听听你的人生故事，<text class="line-break">{{'\n'}}</text>把它写成一本书，留给我们。</view
        ></view
      ></view
    ><view class="invitation-sign">—— 来自{{p.buyer}}的心意</view></view
  ><view class="stack section"
    ><button class="btn" bindtap="share"
      ><image class="icon" src="/assets/icons/send-light.svg" />
      邀请{{p.recipient}}讲故事</button
    ><button class="btn secondary" bindtap="preview"
      >我陪{{p.recipient}}，一起开始</button
    ></view
  ><button class="link" bindtap="settings"
    >修改书名与资料
    <image class="icon small" src="/assets/icons/chevron-right.svg" /></button
  ><button class="link" bindtap="project">回到我的项目</button
  ><view class="demo-note">本机演示项目 · 尚未真实支付</view></view
>
</block>
