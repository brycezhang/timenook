@import "../../styles/book.wxss";
.book-display { padding: 8px 0 20px; }
.cover-photo-label { display: flex; align-items: center; justify-content: space-between; gap: 12px; font-size: 14px; font-weight: 600; }
.cover-thumbnail, .cover-thumbnail image { width: 72px; height: 72px; border-radius: 12px; overflow: hidden; }
.tn-field { font-size: 13px; }

.cover-thumbnails { display: flex; gap: 12px; }
.cover-thumbnail { border: 2px solid transparent; }
.cover-thumbnail.selected { border-color: #46563c; }
