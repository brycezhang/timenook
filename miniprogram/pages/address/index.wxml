<view class="s-page"><view class="s-title">书寄到哪里</view><label class="s-field">收件人<input class="s-input" value="{{name}}" data-field="name" bindinput="input" maxlength="40" /></label><label class="s-field">手机号码<input class="s-input" type="number" value="{{phone}}" data-field="phone" bindinput="input" maxlength="11" /></label><view class="s-field">所在地区<picker range="{{regions}}" value="{{regionIndex}}" bindchange="region"><view class="s-input">{{regionIndex>=0?regions[regionIndex]:'请选择配送地区'}}　›</view></picker></view><label class="s-field">详细地址<textarea class="s-input address-detail" auto-height value="{{detail}}" data-field="detail" bindinput="input" maxlength="200" placeholder="城市、街道、门牌号" /></label><view class="s-error">{{status}}</view><view class="s-dock"><button class="s-button" bindtap="save" disabled="{{busy}}" loading="{{busy}}">保存地址</button></view></view>
