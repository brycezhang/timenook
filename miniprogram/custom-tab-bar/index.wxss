.tabs { position: fixed; z-index: 5; bottom: 0; left: 0; right: 0; height: calc(70px + env(safe-area-inset-bottom)); display: flex; background: #fff; border-top: 1px solid #ded4c6; padding: 0 0 calc(8px + env(safe-area-inset-bottom)); box-sizing: border-box; }
.tab { flex: 1; min-width: 0; display: flex; align-items: center; justify-content: center; gap: 8px; margin: 0; padding: 0; background: transparent; border: 0; border-radius: 0; line-height: 1.5; font-size: 13px; font-weight: 600; color: #756859; }
.tab::after { border: 0; }
.tab.active { color: #46563c; font-weight: 600; }
.icon { width: 22px; height: 22px; }
