<tn-navigation title="{{displayState === 'processing' ? '整理故事' : displayState === 'failed' ? failureTitle : '故事详情'}}" />
<app-loading wx:if="{{pageLoading}}" variant="story" />
<view wx:else class="tn-page with-dock story-page {{displayState === 'failed' ? 'story-failed' : ''}}">
  <view wx:if="{{story.revision && displayState === 'ready'}}" class="story-toolbar">
    <button class="story-placement" bindtap="assignStory" disabled="{{busy}}"><text>章节：{{placement}}</text><image src="/assets/icons/chevron-right.svg" /></button>
    <button class="tn-link story-edit" bindtap="edit" disabled="{{busy}}">编辑文字<image src="/assets/icons/pencil.svg" /></button>
  </view>
  <view wx:if="{{displayState === 'failed'}}" class="story-state-space" />
  <view wx:if="{{displayState === 'failed'}}" class="story-failure-intro">
    <view class="story-failure-icon"><image src="/assets/icons/rotate-ccw.svg" /></view>
    <view class="story-intro"><view class="story-heading">{{failureTitle}}</view><view class="tn-muted">{{failureHint}}</view></view>
  </view>
  <view wx:elif="{{displayState === 'processing'}}" class="story-intro"><view class="story-heading">正在整理故事</view><view class="tn-muted">录音已保存。</view></view>
  <view wx:else class="story-intro"><view class="story-heading">{{story.revision.title || '新记录的故事'}}</view><view wx:if="{{storyMeta}}" class="tn-muted">{{storyMeta}}</view><view wx:if="{{!story.revision}}" class="tn-muted">{{stage}}</view></view>
  <view wx:if="{{displayState === 'failed'}}" class="story-state-tail" />
  <view wx:if="{{liveAudioSources.length}}" class="live-audio-list">
    <view wx:for="{{liveAudioSources}}" wx:key="clipId" class="story-audio-group">
      <view wx:if="{{liveAudioSources.length > 1}}" class="story-audio-number">第 {{index + 1}} 段原声</view>
      <view class="live-audio-card">
        <button class="live-audio-button" bindtap="playLive" data-id="{{item.clipId}}" disabled="{{busy || audioBusy || privateError}}" aria-label="{{playingClipId === item.clipId ? '暂停播放' : pausedClipId === item.clipId ? '继续播放' : '播放原声'}}">
          <app-loading wx:if="{{loadingClipId === item.clipId}}" variant="spinner" light /><image wx:else src="/assets/icons/{{playingClipId === item.clipId ? 'pause-light' : 'play-light'}}.svg" />
        </button>
        <view class="live-audio-timeline">
          <slider class="live-audio-slider" aria-label="{{'第 ' + (index+1) + ' 段原声播放进度'}}" min="0" max="{{playingClipId === item.clipId || pausedClipId === item.clipId ? audioDuration : item.durationSeconds || 1}}" step="0.1" value="{{playingClipId === item.clipId || pausedClipId === item.clipId ? audioPosition : 0}}" disabled="{{audioBusy || privateError || (playingClipId !== item.clipId && pausedClipId !== item.clipId) || !audioDuration}}" data-id="{{item.clipId}}" bindchanging="draggingLive" bindchange="seekLive" activeColor="#46563C" backgroundColor="#ADB49F" block-color="#46563C" block-size="20" />
          <view class="live-audio-times"><text>{{playingClipId === item.clipId || pausedClipId === item.clipId ? audioPositionLabel : '00:00'}}</text><text>{{playingClipId === item.clipId || pausedClipId === item.clipId ? audioDurationLabel : item.durationLabel}}</text></view>
        </view>
      </view>
    </view>
  </view>
  <view wx:if="{{audioError || error || privateError || saveWarning}}" class="tn-error">{{audioError || error || privateError || saveWarning}}</view>
  <view wx:if="{{displayState === 'processing' && !story.revision}}" class="story-processing-preview" aria-label="正在整理故事"><view class="processing-heading" /><view /><view /><view /><view /><view /><view class="processing-photo" /></view>
  <view wx:if="{{liveParagraphs.length}}" class="story-body"><text wx:for="{{liveParagraphs}}" wx:key="index" selectable>{{item.text}}</text></view>
  <block wx:if="{{liveTranscripts.length}}"><view class="tn-muted">已识别的文字</view><view wx:for="{{liveTranscripts}}" wx:key="clipId" class="story-body"><text selectable>{{item.text}}</text></view></block>
  <view wx:for="{{livePhotos}}" wx:key="photoId" class="live-story-photo"><image wx:if="{{item.image}}" class="live-photo-image" src="{{item.image}}" mode="aspectFill" aria-label="{{item.caption || '讲述的照片'}}" /><view wx:else class="live-photo-placeholder"><app-loading variant="photo" /></view><view wx:if="{{item.caption}}" class="live-photo-caption">{{item.caption}}</view></view>
  <view wx:if="{{photoError}}" class="tn-error">{{photoError}}</view><button wx:if="{{photoError}}" class="tn-link" bindtap="reloadLivePhotos">重新加载照片</button>
  <button wx:if="{{story.revision && displayState === 'ready'}}" class="tn-link" bindtap="editLivePhotos">{{livePhotos.length ? '照片与说明' : '添加照片'}}<image class="tn-icon" src="/assets/icons/image.svg" /></button>
  <button wx:if="{{error}}" class="tn-link" bindtap="refresh">重新查询</button>
  <view class="tn-dock">
    <block wx:if="{{displayState === 'processing'}}"><button class="tn-button tn-secondary" bindtap="returnToProject">回到这本书</button></block>
    <block wx:elif="{{displayState === 'failed'}}"><button wx:if="{{retryable}}" class="tn-button" bindtap="retryLive" disabled="{{busy}}" loading="{{busy}}">重新整理</button><button wx:else class="tn-button" bindtap="recoverInterview" disabled="{{busy}}">{{story.task.errorCode === 'DEPENDENCY_FAILED' ? '返回讲述重试' : '继续讲述'}}</button><button class="tn-link" bindtap="returnToProject">回到这本书</button></block>
    <block wx:else><button wx:if="{{canOrganize && !story.revision}}" class="tn-button" bindtap="submitLive" disabled="{{busy}}" loading="{{busy}}">整理故事</button><button wx:else class="tn-button" bindtap="recoverInterview" disabled="{{busy || !story}}"><image class="tn-icon" src="/assets/icons/mic-light.svg" />继续讲述</button></block>
  </view>
</view>
