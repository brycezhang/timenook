<block wx:if="{{live}}">
  <view class="page with-tabs live-book">
    <view class="title">我的人生书</view>
    <view wx:if="{{status}}" class="section note">{{status}}</view>
    <block wx:if="{{context}}">
      <view wx:if="{{draftAvailable}}" class="section">{{context.eligibleStories.length}} 篇故事已确认并允许入书</view>
      <view wx:if="{{sourceStatus}}" class="section note draft-access-status">{{sourceStatus}}</view>
      <view class="section book-status">{{stateLabel}}</view>
      <block wx:if="{{version}}">
        <view class="live-cover section">
          <view class="eyebrow">时光里 · 岁月成书</view>
          <view class="title serif">{{version.snapshot.cover.title}}</view>
          <view wx:if="{{version.snapshot.cover.salutation}}" class="cover-salutation-display">{{version.snapshot.cover.salutation}}</view>
          <image wx:if="{{coverImage}}" class="book-cover-photo" src="{{coverImage}}" mode="aspectFit" />
          <view wx:if="{{coverStatus}}" class="note section">{{coverStatus}}</view>
          <view wx:if="{{version.snapshot.cover.photo}}" class="note">{{version.snapshot.cover.photo.caption}}</view>
          <view>书稿第 {{version.version}} 版</view>
          <view wx:if="{{version.pageCount}}">{{version.pageCount}} 页 · {{excerpts.length}} 篇故事</view>
        </view>
        <button wx:if="{{version.state === 'ready'}}" class="btn section" bindtap="manuscript">查看完整书稿并确认</button>
        <button wx:if="{{version.state === 'ready' && context.physicalProduction !== false}}" class="btn secondary section" bindtap="print" disabled="{{busy}}">双方确认与首本制作</button>
        <button wx:if="{{context.physicalProduction !== false}}" class="btn secondary section" bindtap="quality" disabled="{{busy}}">质量售后与原单重印</button>
        <view class="section-title section">本版目录</view>
        <view wx:for="{{version.toc}}" wx:key="index" class="toc-row"><text>{{item.title}}</text><text>第 {{item.page}} 页</text></view>
        <view wx:if="{{!version.toc}}" class="section">实际页数将在书稿生成后显示。</view>
        <view class="section-title section">内页节选</view>
        <view wx:for="{{excerpts}}" wx:key="id" class="excerpt-card">
          <view class="section-title">{{item.title}}</view><text class="excerpt-body">{{item.text}}</text>
        </view>
        <button wx:if="{{version.state === 'failed'}}" class="btn section" bindtap="retry" disabled="{{busy || !draftAvailable}}">重试生成本版</button>
        <view class="note section">{{context.physicalProduction === false ? '内部功能验收书稿，无付款或实体书生产。' : '当前为合成测试规格，尚未开放正式生产。'}}</view>
      </block>
      <button class="btn section" bindtap="generate" disabled="{{busy || !draftAvailable || dirty || coverDirty || !context.eligibleStories.length || (version && (version.state === 'queued' || version.state === 'rendering'))}}">生成完整书稿</button>
      <button class="btn secondary section" bindtap="editCover" disabled="{{busy || !draftAvailable}}">{{coverEditing ? '收起书封编辑' : '调整书封'}}</button>
      <view wx:if="{{draftAvailable && coverEditing && coverDraft}}" class="cover-editor section">
        <label>称呼<input class="cover-salutation" data-field="cover-salutation" value="{{coverDraft.salutation}}" bindinput="salutation" maxlength="120" placeholder="可留空，例如：写给一路同行的你" /></label>
        <view class="section">封面照片（可选）</view>
        <view class="note section">从本人已确认并允许入书的照片中选用。</view>
        <button class="btn secondary section" data-asset-id="" bindtap="chooseCoverPhoto" disabled="{{busy}}">{{coverDraft.photoAssetId ? '不使用封面照片' : '已选：不使用封面照片'}}</button>
        <button wx:for="{{coverOptions}}" wx:key="assetId" class="btn secondary section" data-asset-id="{{item.assetId}}" bindtap="chooseCoverPhoto" disabled="{{busy}}">{{item.selected ? '已选封面照片：' : '选用封面照片：'}}{{item.label}}</button>
        <button class="btn section" bindtap="saveCover" disabled="{{busy || !coverDirty}}">保存书封</button>
        <view class="note section">保存后请重新生成，当前书稿保留原书封。</view>
      </view>
      <button class="btn secondary section" bindtap="editDirectory" disabled="{{busy || !draftAvailable}}">{{editing ? '收起目录编辑' : '调整入书目录'}}</button>
      <block wx:if="{{draftAvailable && editing}}">
        <view class="section note">只安排已确认且允许入书的故事。空章节不会印入书稿。</view>
        <view wx:for="{{draftRows}}" wx:for-item="chapter" wx:for-index="chapterIndex" wx:key="key" class="directory-card">
          <label>第 {{chapterIndex + 1}} 章名称<input class="directory-title" data-field="directory-title-{{chapter.key}}" value="{{chapter.title}}" data-chapter="{{chapterIndex}}" bindinput="chapterTitle" maxlength="80" /></label>
          <view class="directory-actions">
            <button class="btn secondary" bindtap="moveChapter" data-chapter="{{chapterIndex}}" data-direction="-1" disabled="{{busy || chapterIndex === 0}}">章节上移</button>
            <button class="btn secondary" bindtap="moveChapter" data-chapter="{{chapterIndex}}" data-direction="1" disabled="{{busy || chapterIndex === draftRows.length - 1}}">章节下移</button>
          </view>
          <view class="section">将故事放入此章</view>
          <button wx:for="{{chapter.choices}}" wx:key="id" class="btn secondary section" data-chapter="{{chapterIndex}}" data-id="{{item.id}}" bindtap="assignStory" disabled="{{busy}}">{{item.selected ? '已选：' : '选择：'}}{{item.title}}</button>
          <view wx:for="{{chapter.stories}}" wx:key="id" class="section">
            <view>{{index+1}}. {{item.title}}</view>
            <view class="directory-actions"><button class="btn secondary" data-chapter="{{chapterIndex}}" data-id="{{item.id}}" data-direction="-1" bindtap="moveStory" disabled="{{busy || index === 0}}">故事上移</button><button class="btn secondary" data-chapter="{{chapterIndex}}" data-id="{{item.id}}" data-direction="1" bindtap="moveStory" disabled="{{busy || index === chapter.stories.length - 1}}">故事下移</button></view>
          </view>
          <button class="btn secondary section" data-chapter="{{chapterIndex}}" bindtap="removeChapter" disabled="{{busy}}">移除此章</button>
        </view>
        <button class="btn secondary section" bindtap="addChapter" disabled="{{busy}}">添加章节</button>
        <button class="btn section" bindtap="saveDirectory" disabled="{{busy || !dirty}}">保存入书目录</button>
      </block>
      <button class="btn secondary section" bindtap="settings">修改书名</button>
      <button class="btn secondary section" bindtap="project">返回项目，核对故事</button>
    </block>
    <button class="btn secondary section" bindtap="refresh" disabled="{{busy}}">{{dirty || coverDirty ? '重新查询，放弃未保存修改' : '重新查询'}}</button>
  </view>
  <view class="tabs live-tabs"><button class="tab" bindtap="project">项目</button><button class="tab active" bindtap="book">成书</button><button class="tab" bindtap="account">我的</button></view>
</block>
<block wx:else="">
<view class="book-page with-tabs"
  ><view class="book-heading center"
    ><view class="title">让故事，成为一本书</view
    ><view class="subtitle">把平凡的日子，装订成岁月的礼物</view></view
  ><view class="book-display"
    ><image src="{{bookImage}}" mode="aspectFill" /><text class="book-label"
      >实体书效果示意</text
    ></view
  ><view class="book-content"
    ><view class="section-head"
      ><view
        ><view class="serif section-title">{{p.title}}</view
        ><view class="small muted">一套经典书封，属于你的故事</view></view
      ><button class="link" bindtap="settings"
        >改书名
        <image
          class="icon small"
          src="/assets/icons/chevron-right.svg" /></button></view
    ><view class="divider" /><view class="section-head"
      ><view class="section-title">章节目录</view
      ><text class="small muted">{{stories.length}}篇故事入书</text></view
    ><button
      wx:for="{{stories}}"
      wx:key="id"
      class="chapter-row"
      data-id="{{item.id}}"
      bindtap="story"
      ><view class="chapter-num serif">0{{index+1}}</view
      ><view class="grow"
        ><view class="chapter-title">{{item.chapter}}</view
        ><view class="small muted">{{item.title}}</view></view
      ><image
        class="icon small"
        src="/assets/icons/chevron-right.svg" /></button
    ><view wx:if="{{!stories.length}}" class="empty"
      ><view>书的第一页，等你来讲。</view
      ><button class="link" bindtap="record"
        >从一段往事开始
        <image
          class="icon small"
          src="/assets/icons/arrow-right.svg" /></button></view
    ><view wx:if="{{stories.length}}" class="section"
      ><view class="book-features"
        ><view
          ><image class="icon" src="/assets/icons/image.svg" /><view
            >照片入书</view
          ><text>留住珍贵瞬间</text></view
        ><view
          ><image class="icon" src="/assets/icons/headphones.svg" /><view
            >原声相伴</view
          ><text>每篇故事都可回听</text></view
        ></view
      ><view wx:if="{{pending}}" class="note pending-note"
        >还有{{pending}}篇故事待本人确认。确认后，才能制作实体书。</view
      ><view class="stack section"
        ><button class="btn" bindtap="manuscript"
          >查看完整书稿
          <image class="icon" src="/assets/icons/book-open-light.svg" /></button
        ><button class="btn secondary" bindtap="print"
          >确认印刷与寄送</button
        ></view
      ><view class="demo-note">当前为前端书稿预览，尚未生成印刷PDF</view></view
    ></view
  ></view
><view class="tabs"
  ><button class="tab" bindtap="project"
    ><image class="icon" src="/assets/icons/book-open.svg" /><text class="tab-label"
      >{{p.title}}</text
    ></button
  ><button class="tab active" bindtap="book"
    ><image class="icon" src="/assets/icons/file-text.svg" /><text
      >成书</text
    ></button
  ><button class="tab" bindtap="account"
    ><image class="icon" src="/assets/icons/user.svg" /><text
      >我的</text
    ></button
  ></view
>
</block>
