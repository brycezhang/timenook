<tn-navigation title="{{title}}"/>
<view class="tn-page with-dock gift-page">
 <block wx:if="{{loading && !gift && screen !== 'invalid'}}"><view class="gift-skeleton tall"/><view class="gift-skeleton line"/></block>
 <block wx:elif="{{screen === 'open' && gift}}">
  <view class="gift-cover-wrap"><view class="mini-book gift-cover"><text class="mini-title">{{gift.bookTitle}}</text><text class="mini-subtitle">那些年，那些我们</text><image class="mini-photo" src="/assets/purchase-cover.jpg" mode="aspectFill" aria-label="封面示例照片"/><text class="mini-brand">时光故事</text></view></view>
  <view class="tn-card"><view class="gift-recipient-name">收礼人：{{gift.recipientName}}</view><view class="gift-phone-caption"><image src="/assets/icons/lock.svg"/>收礼手机号 {{gift.maskedPhone}}</view></view>
  <view class="gift-caption">成书后寄送实体书。</view>
 </block>
 <block wx:elif="{{screen === 'accept' && gift}}"><view class="tn-card"><view class="purchase-book-row"><view class="mini-book"><text class="mini-title">{{gift.bookTitle}}</text><text class="mini-subtitle">那些年，那些我们</text><image class="mini-photo" src="/assets/purchase-cover.jpg" mode="aspectFill"/><text class="mini-brand">时光故事</text></view><view class="purchase-book-copy"><view class="gift-accept-title">{{gift.bookTitle}}</view><view class="purchase-tag">手机号已验证</view></view></view></view></block>
 <block wx:elif="{{screen !== 'open'}}">
  <view class="gift-spacer"/><view class="gift-heading"><view class="gift-icon"><image src="/assets/icons/{{screen === 'verify' ? 'smartphone' : screen === 'mismatch' ? 'lock' : screen === 'claimed' ? 'check' : 'gift'}}.svg"/></view><view class="gift-heading-copy"><view wx:if="{{screen !== 'verify'}}" class="gift-heading-title">{{title}}</view><view wx:if="{{screen === 'verify'}}" class="tn-muted">请使用收礼人微信绑定的手机号。</view><view wx:elif="{{screen === 'invalid'}}" class="tn-muted">领取信息已更改，请联系送礼人获取新卡片。</view></view></view><view class="gift-card-spacer"/>
  <view wx:if="{{screen === 'verify' || screen === 'mismatch'}}" class="tn-card"><view class="gift-detail"><text>收礼手机号</text><text class="gift-detail-value">{{gift.maskedPhone}}</text></view><view wx:if="{{screen === 'mismatch'}}" class="gift-detail"><text>当前手机号</text><text class="gift-detail-value">{{currentMaskedPhone}}</text></view></view>
  <view wx:if="{{screen === 'mismatch'}}" class="gift-caption">换用收礼手机号，或请送礼人更正。</view>
  <view wx:if="{{screen === 'claimed' && gift}}" class="tn-card gift-claimed-title">{{gift.bookTitle}}</view>
  <quick-login wx:if="{{screen === 'verify'}}" embedded="{{true}}" visible="{{loginVisible}}" bind:success="loginSucceeded" bind:close="closeLogin"/>
 </block>
 <view wx:if="{{status}}" class="tn-error" role="alert">{{status}}</view>
</view>
<view wx:if="{{screen !== 'verify'}}" class="tn-dock">
 <button wx:if="{{screen === 'open' && gift}}" class="tn-button" bindtap="verify" loading="{{busy}}" disabled="{{busy || loading}}"><image class="tn-icon" src="/assets/icons/gift-light.svg"/>验证收礼手机号</button>
 <button wx:elif="{{screen === 'mismatch'}}" class="tn-button" bindtap="switchAccount" loading="{{busy}}" disabled="{{busy}}"><image class="tn-icon" src="/assets/icons/rotate-ccw-light.svg"/>更换微信手机号</button>
 <button wx:elif="{{screen === 'accept'}}" class="tn-button" bindtap="accept" loading="{{busy}}" disabled="{{busy || loading}}"><image class="tn-icon" src="/assets/icons/gift-light.svg"/>确认领取</button>
 <button wx:elif="{{screen === 'claimed' && projectId}}" class="tn-button" bindtap="project"><image class="tn-icon" src="/assets/icons/book-open-light.svg"/>进入项目</button>
 <button wx:elif="{{screen === 'claimed' && currentMaskedPhone}}" class="tn-button" bindtap="switchAccount" loading="{{busy}}" disabled="{{busy || loading}}">更换微信手机号</button>
 <button wx:elif="{{screen === 'claimed'}}" class="tn-button" bindtap="verify" loading="{{busy}}" disabled="{{busy || loading}}">验证手机号进入项目</button>
 <button wx:elif="{{screen === 'invalid'}}" class="tn-button tn-secondary" bindtap="home">返回首页</button>
 <button wx:else class="tn-button" bindtap="load" loading="{{loading}}" disabled="{{loading}}">重新读取</button>
 <button wx:if="{{status && gift}}" class="tn-link" bindtap="load">重新读取</button>
</view>
