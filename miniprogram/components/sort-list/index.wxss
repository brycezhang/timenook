.sort-row {
  display: flex;
  align-items: stretch;
  gap: 8rpx;
  background: #f0ece4;
  border-radius: 24rpx;
  margin: 0 0 28rpx;
  min-height: 154rpx;
  transition: box-shadow 0.12s;
}
.sort-row.dragging {
  background: #e6eadf;
  box-shadow: 0 12rpx 24rpx #38452d25;
}
.sort-content {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
  text-align: left;
  padding: 26rpx;
}
.sort-title {
  font-size: 40rpx;
  font-weight: 500;
  overflow-wrap: anywhere;
}
.sort-number {
  font-size: 30rpx;
  color: #756859;
  white-space: nowrap;
}
.sort-handle {
  width: 128rpx;
  min-height: 128rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  color: #46563c;
  border-left: 1rpx solid #dcd7ce;
  touch-action: none;
}
.sort-handle > text {
  font-size: 44rpx;
}
.sort-handle .sort-hint {
  font-size: 26rpx;
}
.sort-action {
  padding: 14rpx;
  font-size: 32rpx;
  color: #46563c;
  min-width: 96rpx;
}
.sort-content image {
  width: 100rpx;
  height: 100rpx;
  flex-shrink: 0;
  border-radius: 10rpx;
}
.sort-caption {
  font-size: 34rpx;
  min-width: 0;
  width: 220rpx;
  height: auto;
  padding: 24rpx 8rpx;
  align-self: center;
}
.sort-image-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 56px;
  min-height: 56px;
  background: #eee9df;
  border-radius: 8px;
}

.sort-copy { min-width: 0; display: flex; flex-direction: column; gap: 6px; }
.sort-subtitle { font-size: 12px; color: #756859; font-weight: 400; }
.modern { border: 1px solid #ded4c6; border-radius: 18px; background: #fff; min-height: 96px; margin-bottom: 12px; padding: 6px 10px; gap: 4px; }
.modern .sort-content { padding: 5px 4px; gap: 12px; background: #fff; }
.modern .sort-title { font-size: 16px; font-weight: 600; line-height: 1.5; }
.modern .sort-number { font-size: 20px; min-width: 23px; }
.modern .sort-handle { width: 44px; min-height: 56px; border: 0; color: #756859; }
.modern .sort-handle > text { font-size: 25px; line-height: 1.2; }
.modern .sort-handle .sort-hint { font-size: 10px; }
.modern .sort-action { padding: 8px 4px; font-size: 13px; min-width: 44px; color: #756859; background: #fff; }
