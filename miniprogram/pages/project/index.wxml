<block wx:if="{{mode === 'live'}}">
<view class="page live-project with-tabs">
 <view class="title">{{overview ? overview.bookTitle : participation && participation.bookTitle ? participation.bookTitle : '我的人生项目'}}</view>
 <view class="subtitle">把生命的故事，温柔收藏</view>
 <view wx:if="{{status}}" class="soft section" role="status">{{status}}</view>
 <view wx:if="{{busy}}" class="note section" role="status">正在打开你的故事书…</view>
 <view wx:if="{{overview}}" class="project-progress"><view class="active">讲述往事</view><view class="line"/><view>整理成书</view><view class="line"/><view>寄到身边</view></view>
 <view wx:if="{{participation}}" class="next-story section">
  <view class="row"><image class="icon small" src="/assets/icons/sprout.svg"/><text class="small muted">今天，聊一件记得的小事</text></view>
  <view class="serif prompt">一段往事，<text class="line-break">{{'\n'}}</text>就是书的开始。</view>
  <button wx:if="{{participation.canCollect}}" class="btn" bindtap="record" disabled="{{busy}}"><image class="icon" src="/assets/icons/mic-light.svg"/>开始一段讲述</button>
  <block wx:else="">
   <button wx:if="{{participation.role === 'initiator' && participation.bindingVersion === 0}}" class="btn" bindtap="invite">邀请家人开始讲述</button>
   <button wx:if="{{participation.role === 'initiator'}}" class="btn secondary section" bindtap="assisted">本人在场，进入同机协助</button>
   <button wx:if="{{participation.role === 'narrator'}}" class="btn" bindtap="participate">选择资料用途，开始讲述</button>
   <view class="note section">由讲述者本人决定资料用途后，就可以开始留下声音。</view>
  </block>
  <button wx:if="{{participation.canRead}}" class="link" bindtap="plan">个人大纲与问题<image class="icon small" src="/assets/icons/chevron-right.svg"/></button>
 </view>
 <view wx:if="{{interviews.length}}" class="section">
  <view class="section-head"><view class="section-title">接着上次，慢慢说</view></view>
  <button wx:for="{{interviews}}" wx:key="id" class="list-row resume-row" data-id="{{item.id}}" bindtap="resume"><image class="icon" src="/assets/icons/mic.svg"/><view class="grow"><view>{{item.resumeLabel}}</view><view class="small muted">继续讲述或查看保存进度</view></view><image class="icon small" src="/assets/icons/chevron-right.svg"/></button>
 </view>
 <view wx:if="{{overview}}" class="section">
  <view class="section-head"><view class="section-title">留下来的故事</view><text class="small muted">{{confirmed}} 篇已确认</text></view>
  <view class="filters"><button class="filter {{filter==='all'?'selected':''}}" data-filter="all" bindtap="filter">全部</button><button class="filter {{filter==='pending'?'selected':''}}" data-filter="pending" bindtap="filter">待本人确认 {{pending}}</button></view>
  <view wx:if="{{!liveStories.length}}" class="empty"><image class="icon" src="/assets/icons/book-open.svg"/><view>{{filter==='pending'?'所有故事都已确认':'故事，正等着你慢慢说'}}</view><view class="subtitle">{{filter==='pending'?'继续留下更多珍贵回忆':'从一段小小的往事开始就好'}}</view></view>
  <button wx:for="{{liveStories}}" wx:key="id" class="story-row live-story-row" data-id="{{item.id}}" bindtap="story"><view class="story-number serif">{{index + 1}}</view><view class="grow"><view class="story-name">{{item.revision ? item.revision.title : '整理中的故事'}}</view><view class="small muted">{{item.decision && item.decision.confirmed ? (item.decision.allowInBook ? '本人已确认 · 允许入书' : '本人已确认 · 暂不入书') : (item.revision ? '待本人确认' : '尚未形成故事版本')}}</view></view><image class="icon small" src="/assets/icons/chevron-right.svg"/></button>
 </view>
 <view wx:if="{{taskRows.length}}" class="section live-tasks"><view class="section-title">处理进度</view><view wx:for="{{taskRows}}" wx:key="id" class="live-task"><view class="row between"><text>{{item.kindLabel}}</text><text class="small muted">{{item.stateLabel}}</text></view><view class="note">{{item.nextActionLabel}}</view></view></view>
 <view class="project-tools section"><button class="link" bindtap="settings">修改书名</button><button wx:if="{{participation && participation.role === 'initiator'}}" class="link" bindtap="invite">邀请与参与授权</button><button wx:if="{{participation && participation.role === 'narrator'}}" class="link" bindtap="participate">本人参与与资料用途</button><button class="link" bindtap="refresh" disabled="{{busy}}">重新查询项目</button></view>
 <view wx:if="{{participation && participation.policyStatus === 'internal-acceptance'}}" class="demo-note">内测项目 · 无真实付款及实体书生产</view>
</view>
<view class="tabs live-tabs"><button class="tab active" bindtap="project"><image class="icon" src="/assets/icons/book-open.svg"/><text class="tab-label">{{overview ? overview.bookTitle : '项目'}}</text></button><button class="tab" bindtap="book"><image class="icon" src="/assets/icons/file-text.svg"/><text>成书</text></button><button class="tab" bindtap="account"><image class="icon" src="/assets/icons/user.svg"/><text>我的</text></button></view>
</block>
<block wx:else="">
<view class="page with-tabs"
  ><view class="project-head"
    ><view class="grow"
      ><view class="eyebrow">把生命的故事，温柔收藏</view
      ><view class="title">{{p.title}}</view
      ><view class="subtitle"
        >{{confirmed}}篇已确认 · {{pending}}篇待确认</view
      ></view
    ><image class="project-book" src="{{bookImage}}" mode="aspectFill" /></view
  ><view class="project-progress"
    ><view class="active">讲述往事</view><view class="line" /><view
      >整理成书</view
    ><view class="line" /><view>寄到身边</view></view
  ><view class="next-story section"
    ><view class="row"
      ><image class="icon" src="/assets/icons/sprout.svg" /><text class="small"
        >今天，聊一件记得的小事</text
      ></view
    ><view class="serif prompt"
      >小时候的家，<text class="line-break">{{'\n'}}</text>是什么样子的？</view
    ><button class="btn" bindtap="record"
      ><image class="icon" src="/assets/icons/mic-light.svg" />
      {{p.stories.length ? '继续讲述' : '开始讲述'}}</button
    ><button class="link" bindtap="photo"
      ><image class="icon small" src="/assets/icons/image.svg" />
      看着老照片，讲一段往事</button
    ></view
  ><view class="section"
    ><view class="section-head"
      ><view class="section-title">留下来的故事</view
      ><button class="link" bindtap="invite"
        >邀请与陪同
        <image
          class="icon small"
          src="/assets/icons/chevron-right.svg" /></button></view
    ><view class="filters"
      ><button
        class="filter {{filter==='all'?'selected':''}}"
        data-filter="all"
        bindtap="filter"
        >全部故事</button
      ><button
        class="filter {{filter==='pending'?'selected':''}}"
        data-filter="pending"
        bindtap="filter"
        >待确认 {{pending}}</button
      ></view
    ><view wx:if="{{!stories.length}}" class="empty"
      ><image class="icon" src="/assets/icons/book-open.svg" /><view
        >{{filter==='pending'?'所有故事都已确认':'故事，正等着你慢慢说'}}</view
      ><view class="subtitle"
        >{{filter==='pending'?'继续留下更多珍贵回忆':'从一段小小的往事开始就好'}}</view
      ></view
    ><button
      wx:for="{{stories}}"
      wx:key="id"
      class="story-row"
      data-id="{{item.id}}"
      bindtap="story"
      ><view class="story-number serif">0{{index+1}}</view
      ><view class="grow"
        ><view class="story-name">{{item.title}}</view
        ><view class="small muted"
          >{{item.chapter}} · {{item.sample?'示例故事':'我的故事'}}</view
        ></view
      ><view class="pill {{item.confirmedVersion!==item.version?'pending':''}}"
        >{{item.confirmedVersion===item.version?'已确认':'待确认'}}</view
      ></button
    ></view
  ><view wx:if="{{p.sample}}" class="demo-note"
    >正在浏览示例项目，人物与故事仅供体验</view
  ></view
><view class="tabs"
  ><button class="tab active" bindtap="project"
    ><image class="icon" src="/assets/icons/book-open.svg" /><text class="tab-label"
      >{{p.title}}</text
    ></button
  ><button class="tab" bindtap="book"
    ><image class="icon" src="/assets/icons/file-text.svg" /><text
      >成书</text
    ></button
  ><button class="tab" bindtap="account"
    ><image class="icon" src="/assets/icons/user.svg" /><text
      >我的</text
    ></button
  ></view
>

</block>
