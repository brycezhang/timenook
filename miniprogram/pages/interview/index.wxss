.interview-page {
  padding: 34rpx 46rpx 180rpx;
  min-height: calc(100vh - 88px);
}
.interview-question {
  font-size: 54rpx;
  line-height: 1.55;
  font-weight: 500;
  white-space: pre-line;
  color: #352d25;
}
.interview-hint {
  font-size: 38rpx;
  line-height: 1.6;
  color: var(--muted);
  margin-top: 44rpx;
}
.record-control {
  display: flex;
  align-items: center;
  flex-direction: column;
  margin-top: 50rpx;
}
.record-button {
  width: 224rpx;
  height: 224rpx;
  border-radius: 50%;
  background: var(--olive);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 0 20rpx #e9ecdf;
}
.record-icon {
  width: 76rpx;
  height: 76rpx;
}
.record-label {
  font-size: 38rpx;
  font-weight: 500;
  margin-top: 40rpx;
}
.recording {
  background: #b95b4c;
  box-shadow: 0 0 0 20rpx #f1e1da;
  animation: breath 2s infinite;
}
.record-timer {
  font-size: 52rpx;
  font-variant-numeric: tabular-nums;
  color: #a34e41;
  margin-bottom: 38rpx;
}
.interview-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 20rpx;
  padding: 20rpx 46rpx env(safe-area-inset-bottom);
  background: var(--paper);
}
.interview-footer .btn {
  font-size: 36rpx;
  min-height: 116rpx;
}
.record-error {
  margin-top: 32rpx;
}
.record-error .error {
  font-size: 32rpx;
}
.interview-followup {
  font-size: 40rpx;
  line-height: 1.6;
  margin: 16rpx 0 32rpx;
}
.saved-state {
  padding-top: 28rpx;
}
.saved-state .interview-question {
  font-size: 46rpx;
}
.saved-state .interview-hint {
  margin-top: 20rpx;
  font-size: 30rpx;
}
.question-photo {
  width: 100%;
  height: 280rpx;
  border-radius: 18rpx;
  margin-bottom: 32rpx;
}
.wave {
  display: flex;
  align-items: center;
  gap: 10rpx;
  height: 60rpx;
  margin-top: 30rpx;
}
.wave > view {
  width: 6rpx;
  height: 20rpx;
  background: #b95b4c;
  border-radius: 6rpx;
  animation: wave 1s ease-in-out infinite alternate;
}
.wave > view:nth-child(3n) {
  animation-delay: 0.3s;
  height: 42rpx;
}
.wave > view:nth-child(2n) {
  animation-delay: 0.5s;
  height: 32rpx;
}
@keyframes wave {
  to {
    height: 10rpx;
  }
}
@keyframes breath {
  50% {
    box-shadow: 0 0 0 28rpx #f1e1da;
  }
}
@media (prefers-reduced-motion: reduce) {
  .recording,
  .wave > view {
    animation: none;
  }
}
