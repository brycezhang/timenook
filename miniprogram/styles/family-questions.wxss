.family-page { gap: 20px; }
.family-tabs { display: flex; gap: 5px; padding: 4px; border: 1px solid #ded4c6; border-radius: 16px; }
.family-tabs button { flex: 1; min-width: 0; min-height: 44px; padding: 10px 6px; border-radius: 12px; color: #756859; font-size: 13px; font-weight: 600; }
.family-tabs .selected { background: #46563c; color: #fff; }
.family-list { display: flex; flex-direction: column; gap: 12px; }
.family-card { width: 100%; padding: 18px; border: 1px solid #ded4c6; border-radius: 18px; display: flex; flex-direction: column; align-items: stretch; gap: 12px; text-align: left; color: #382c24; }
.family-source { color: #46563c; font-size: 12px; line-height: 1.7; overflow-wrap: anywhere; }
.family-text { font-size: 17px; font-weight: 700; line-height: 1.6; overflow-wrap: anywhere; }
.family-meta { display: flex; justify-content: space-between; gap: 12px; font-size: 12px; color: #756859; }
.family-empty { padding: 36px 16px; border: 1px dashed #ded4c6; border-radius: 18px; text-align: center; color: #756859; font-size: 14px; line-height: 1.8; }
.family-badge { align-self: flex-start; max-width: 100%; padding: 5px 9px; border-radius: 8px; background: #edf0e7; color: #46563c; font-size: 12px; font-weight: 600; line-height: 1.5; overflow-wrap: anywhere; }
.family-between { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.family-answer { width: 100%; padding: 18px; border: 1px solid #ded4c6; border-radius: 18px; display: flex; align-items: center; gap: 14px; text-align: left; }
.family-answer-label { font-size: 13px; line-height: 1.7; color: #756859; font-weight: 400; }
.family-actions { display: flex; justify-content: flex-start; gap: 20px; }

.family-card-meta { display: flex; justify-content: space-between; gap: 12px; font-size: 12px; }
.family-card-source { min-width: 0; line-height: 1.6; color: #756859; overflow-wrap: anywhere; }
.family-later { color: #46563c; flex-shrink: 0; }
.family-answer-body { display: flex; flex-direction: column; gap: 10px; }
.family-answer .family-text { font-size: 18px; line-height: 1.5; }
