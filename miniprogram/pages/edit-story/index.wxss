.edit-body {
  min-height: 800rpx;
  font-size: 29rpx;
  line-height: 1.9;
}
.live-edit {
  font-size: 34rpx;
  line-height: 1.7;
  overflow-wrap: anywhere;
}
.live-edit .btn {
  font-size: 34rpx;
  min-width: 96rpx;
  min-height: 96rpx;
  line-height: 1.5;
  white-space: normal;
  padding: 22rpx;
}
.live-input,
.live-textarea {
  box-sizing: border-box;
  width: 100%;
  font-size: 34rpx;
  line-height: 1.7;
  padding: 22rpx;
  border: 2rpx solid #c7bb9e;
  border-radius: 12rpx;
  background: #fffdf8;
}
.live-input {
  min-height: 100rpx;
}
.live-textarea {
  min-height: 180rpx;
  margin-top: 18rpx;
}
.live-row {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-top: 18rpx;
}
.live-row .btn {
  flex: 1;
}
.source-note {
  font-size: 34rpx;
  line-height: 1.6;
  color: var(--muted);
}
