/* Current native design. Opt into tn-* surfaces while individual modules ship. */
.tn-surface, .tn-page { background: #fff; color: #382c24; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif; font-size: 15px; line-height: 1.7; }
.tn-page { min-height: 100vh; padding: 22px 22px calc(26px + env(safe-area-inset-bottom)); display: flex; flex-direction: column; gap: 22px; }
.tn-page.with-tabs { padding-bottom: calc(104px + env(safe-area-inset-bottom)); }
.tn-page.with-dock { padding-bottom: calc(112px + env(safe-area-inset-bottom)); }
.tn-heading { font-size: 22px; line-height: 1.4; font-weight: 600; }
.tn-muted { color: #756859; font-size: 14px; line-height: 1.75; }
.tn-eyebrow { color: #756859; font-size: 12px; font-weight: 600; letter-spacing: 1.3px; }
.tn-card { padding: 18px; border: 1px solid #ded4c6; background: #fff; border-radius: 20px; display: flex; flex-direction: column; gap: 14px; }
.tn-button { width: 100%; min-height: 52px; border: 0; border-radius: 16px; padding: 13px 18px; display: flex; justify-content: center; align-items: center; gap: 9px; font-size: 16px; font-weight: 600; line-height: 1.5; background: #46563c; color: #fff; white-space: normal; }
.tn-button.tn-secondary { color: #46563c; background: #edf0e7; }
.tn-button[disabled] { background: #edf0e7; color: #756859; opacity: .6; }
.tn-link { color: #46563c; min-height: 44px; padding: 10px 2px; display: inline-flex; align-items: center; justify-content: center; gap: 6px; font-size: 14px; font-weight: 600; }
.tn-icon-button { width: 44px; height: 44px; border: 0; border-radius: 14px; background: #fff; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.tn-icon { width: 22px; height: 22px; flex-shrink: 0; }
.tn-icon-tile { width: 40px; height: 40px; border-radius: 13px; background: #edf0e7; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.tn-row { width: 100%; border: 0; border-bottom: 1px solid #ded4c6; display: flex; align-items: center; gap: 13px; padding: 15px 0; text-align: left; min-height: 60px; background: #fff; font-size: 15px; font-weight: 600; }
.tn-grow { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.tn-arrow { color: #756859; font-size: 24px; line-height: 1; }
.tn-field { display: flex; flex-direction: column; gap: 9px; font-size: 14px; font-weight: 600; }
.tn-input { width: 100%; height: 52px; min-height: 52px; border: 1px solid #ded4c6; border-radius: 14px; padding: 13px 14px; background: #fff; color: #382c24; font-size: 16px; line-height: 1.5; font-weight: 400; }
.tn-dock { position: fixed; bottom: 0; left: 0; right: 0; z-index: 4; background: #fff; border-top: 1px solid #ded4c6; padding: 14px 22px calc(20px + env(safe-area-inset-bottom)); display: flex; flex-direction: column; gap: 8px; }
.tn-dock.above-tabs { bottom: calc(74px + env(safe-area-inset-bottom)); padding-bottom: 20px; }
.tn-error { color: #984b39; font-size: 14px; line-height: 1.7; }
