@import "../../styles/family-questions.wxss";
.optional { font-size: 12px; color: #756859; font-weight: 400; }
.relation-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 9px; }
.relation { min-height: 48px; border: 1px solid #ded4c6; border-radius: 14px; padding: 10px 8px; font-size: 14px; font-weight: 600; color: #382c24; }
.relation.selected { border-color: #46563c; background: #edf0e7; color: #46563c; }
.question-input { width: 100%; height: 170px; padding: 16px; border: 1px solid #ded4c6; border-radius: 16px; background: #fff; color: #382c24; font-size: 17px; font-weight: 400; line-height: 1.8; }
.chapter-picker { display: flex; justify-content: space-between; font-size: 15px; }

.family-source { font-size: 13px; }
