.original-audio-page { min-height: calc(100vh - 88px); }
.audio-intro { display: flex; flex-direction: column; gap: 9px; }
.audio-title { font-size: 24px; font-weight: 700; line-height: 1.5; overflow-wrap: anywhere; }
.audio-version { font-size: 12px; color: #756859; }
.audio-photo { width: 100%; height: 240px; border-radius: 22px; overflow: hidden; }
.audio-clip { display: flex; flex-direction: column; gap: 8px; }
.voice-player { width: 100%; min-width: 0; padding: 16px; border: 1px solid #ded4c6; background: #edf0e7; border-radius: 20px; display: flex; align-items: center; gap: 12px; }
.audio-play { width: 48px; height: 48px; border-radius: 50%; background: #46563c; color: #fff; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.audio-play image { width: 21px; height: 21px; }
.audio-timeline { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.audio-slider { width: 100%; height: 44px; margin: 0; padding: 0; }
.audio-times { display: flex; justify-content: space-between; gap: 12px; padding: 0 2px; font-size: 12px; line-height: 1.5; font-variant-numeric: tabular-nums; color: #756859; }
.audio-note { font-size: 12px; line-height: 1.75; color: #756859; }
.audio-logout { align-self: center; }
