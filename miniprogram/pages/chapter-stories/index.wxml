<app-loading wx:if="{{pageLoading}}" variant="list" />
<block wx:else>
<view class="s-page"><view class="s-title">{{title}}</view><view class="s-subtitle">已放入本章 · {{selected.length}} 个</view><view class="s-muted">按下面的顺序排入书中。</view><view class="s-space"><sort-list items="{{selected}}" action-label="移出" disabled="{{busy}}" bindaction="remove" bindreorder="reorder" /></view><view wx:if="{{!selected.length}}" class="s-empty">从下方选择故事加入本章。</view><view class="s-subtitle s-space">可以加入的故事</view><view wx:for="{{available}}" wx:key="id" class="s-row"><view class="s-grow">{{item.title}}</view><button class="story-add" bindtap="add" data-id="{{item.id}}" disabled="{{busy}}">{{item.elsewhere?'移到本章':'＋ 加入'}}</button></view><view wx:if="{{!available.length}}" class="s-muted s-space">没有其他可加入的故事。</view><view class="s-error" wx:if="{{status}}">{{status}}</view><view class="s-dock"><button class="s-button" bindtap="done" disabled="{{busy}}">完成，返回正文</button></view></view>

</block>
