.invitation-card {
  padding: 36rpx;
  background: #eee6d8;
  border: 1rpx solid #ded2c1;
  border-radius: 14rpx;
  box-shadow: 0 16rpx 30rpx #65523d0d;
}
.invitation-sign {
  text-align: right;
  margin-top: 34rpx;
  font-family: "Songti SC", serif;
  color: var(--brown);
}

.live-invite .letter-body {
  font-size: 38rpx;
  line-height: 1.85;
  margin-top: 28rpx;
  color: var(--brown-dark);
}
.live-invite .title {
  font-size: 50rpx;
}
