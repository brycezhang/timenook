page { background: #fff; }
.profile { display: flex; gap: 14px; align-items: center; }
.profile-title, .nickname-trigger { font-size: 19px; font-weight: 600; line-height: 1.5; }
.nickname-trigger { display: flex; align-items: center; gap: 8px; width: 100%; min-height: 44px; text-align: left; }
.nickname-text { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.nickname-edit-icon { width: 44px; height: 44px; padding: 11px; flex-shrink: 0; }
.nickname-info { display: flex; flex-direction: column; gap: 8px; }
.avatar.account-avatar { width: 56px; height: 56px; }
.avatar { width: 54px; height: 54px; background: #edf0e7; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.avatar image { width: 28px; height: 28px; }
.profile-phone { font-size: 12px; line-height: 1.4; font-weight: 400; color: #756859; }
.nickname-mask { position: fixed; inset: 0; z-index: 20000; display: flex; align-items: flex-end; justify-content: center; background: #382c2459; }
.nickname-dialog { width: 100%; max-width: 600px; padding: 22px 22px calc(24px + env(safe-area-inset-bottom)); border-radius: 26px 26px 0 0; display: flex; flex-direction: column; gap: 16px; }
.nickname-heading { display: flex; align-items: center; justify-content: space-between; }
.nickname-heading button { font-size: 28px; font-weight: 400; }

.account-arrow { width: 18px; height: 18px; flex-shrink: 0; }
.tn-icon-tile .tn-icon { width: 20px; height: 20px; }
