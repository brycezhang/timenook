<app-loading wx:if="{{pageLoading}}" variant="list" />
<block wx:else>
<view class="s-page"><view class="s-title">已记录的故事</view><button wx:for="{{rows}}" wx:key="id" class="s-row" bindtap="open" data-id="{{item.id}}"><view class="s-grow"><view class="s-subtitle">{{item.title}}</view><view class="s-muted">{{item.state}}</view></view><text class="s-arrow">›</text></button><view class="s-empty" wx:if="{{!rows.length && !busy}}">从一件想说的往事开始。</view><view class="s-error">{{status}}</view><view class="s-dock"><button class="s-button" bindtap="record">再记一个故事</button></view></view>
</block>
