<view wx:if="{{mode === 'live'}}" class="live-interview">
  <view class="step-progress">第 {{stepNumber}} 步 · 留下一段讲述</view>
  <view class="title step-title">{{stepTitle}}</view>
  <view class="section" role="status">{{status}}</view>
  <view wx:if="{{question}}" class="interview-question section">{{question}}</view>

  <view wx:if="{{flowStep === 'choose'}}" class="section">
    <view wx:if="{{canRecord}}">
      <button class="btn" bindtap="selectQuestion" disabled="{{busy}}">就从这个问题开始</button>
      <button class="btn secondary section" data-kind="free-narration" bindtap="selectQuestion" disabled="{{busy}}">自由讲述</button>
      <button class="btn secondary section" data-kind="photo" bindtap="selectQuestion" disabled="{{busy}}">看着照片讲一讲</button>
      <view class="section">也可以写下这次想讲的问题</view>
      <textarea class="input section" placeholder="想讲的问题" value="{{customText}}" bindinput="customText" maxlength="2000" disabled="{{busy}}"/>
      <input class="input section" placeholder="想记录什么" value="{{customIntent}}" bindinput="customIntent" maxlength="500" disabled="{{busy}}"/>
      <button class="btn secondary section" data-kind="custom" bindtap="selectQuestion" disabled="{{busy || !customText || !customIntent}}">从自拟问题开始</button>
    </view>
    <button wx:if="{{interview}}" class="btn secondary section" bindtap="prepareCurrent" disabled="{{busy}}">返回这段讲述</button>
    <button wx:for="{{pendingInterviews}}" wx:key="*this" class="btn secondary section" data-id="{{item}}" bindtap="resumeLocal" disabled="{{busy}}">恢复本机采访 {{index + 1}}</button>
  </view>

  <view wx:if="{{interview && flowStep !== 'choose'}}" class="record-timer section">{{timer}}</view>
  <view wx:if="{{interview && flowStep === 'prepare'}}" class="section">
    <view class="interview-hint">想好再开始。录音时可以暂停，说完后先听一听，再决定提交。</view>
    <button class="btn secondary section" bindtap="photos" disabled="{{busy}}">查看照片或事后补图</button>
    <button class="btn section" bindtap="record" disabled="{{busy || !canRecord}}">开始说</button>
    <button wx:if="{{localClips.length}}" class="btn secondary section" bindtap="reviewCurrent" disabled="{{busy}}">回听已保存片段</button>
    <button class="link section" bindtap="chooseAnother" disabled="{{busy}}">另选一个问题</button>
  </view>

  <view wx:if="{{interview && flowStep === 'record'}}" class="section recording-step">
    <view wx:if="{{state === 'paused'}}" class="interview-hint">已暂停，休息一下再继续。</view>
    <button wx:if="{{state === 'recording' || state === 'paused'}}" class="btn secondary section" bindtap="togglePause" disabled="{{busy}}">{{state === 'paused' ? '继续说' : '暂停一下'}}</button>
    <button wx:if="{{state === 'recording' || state === 'paused' || state === 'requesting'}}" class="btn section" bindtap="record" disabled="{{busy}}">说完了，停止录音</button>
    <button wx:if="{{state === 'device-error'}}" class="btn secondary section" bindtap="retry" disabled="{{busy}}">重试录音或保存</button>
  </view>

  <view wx:if="{{interview && (flowStep === 'review' || flowStep === 'processing')}}" class="section">
    <view wx:for="{{localClips}}" wx:key="clientClipId" class="soft section local-recording">
      <view>{{item.sealed ? '已确认保存，这台设备也保留了一份' : item.serverId ? '已保存在这台设备，上传结果还待确认' : '已保存在这台设备，还未上传'}}</view>
      <view class="small muted">片段 {{index + 1}}</view>
      <button wx:if="{{flowStep === 'review'}}" class="btn secondary section" bindtap="playLocal" data-id="{{item.clientClipId}}" disabled="{{busy}}">{{playingId === item.clientClipId ? '停止回听' : '回听这段录音'}}</button>
      <button wx:if="{{item.sealed}}" class="btn secondary section" bindtap="upload" data-id="{{item.clientClipId}}" disabled="{{busy}}">重新核对保存结果</button>
      <button wx:if="{{!item.sealed}}" class="btn section" bindtap="upload" data-id="{{item.clientClipId}}" disabled="{{busy}}">提交这段讲述</button>
      <button wx:if="{{!item.sealed && flowStep === 'review'}}" class="btn secondary section" bindtap="rerecordLocal" data-id="{{item.clientClipId}}" disabled="{{busy || !canRecord}}">重新录这一段</button>
    </view>
    <view wx:for="{{interview.clips}}" wx:key="id" class="section">{{item.state === 'sealed' ? '这段讲述已保存，文字处理状态可查询' : '这段讲述还在等待上传完成'}}</view>
    <button class="btn secondary section" bindtap="photos" disabled="{{busy}}">查看照片或事后补图</button>
    <button class="btn secondary section" bindtap="prepareCurrent" disabled="{{busy || !canRecord}}">再说一小段</button>
    <button wx:if="{{flowStep === 'review'}}" class="link section" bindtap="chooseAnother" disabled="{{busy}}">另选一个问题</button>
    <button wx:if="{{flowStep === 'processing' && localClips.length}}" class="btn secondary section" bindtap="reviewCurrent" disabled="{{busy}}">回听已保存片段</button>
  </view>

  <view wx:if="{{interview && flowStep === 'processing'}}" class="section processing-step">
    <view wx:if="{{taskRows.length || taskError}}" class="section" role="status">
      <view wx:for="{{taskRows}}" wx:key="id" class="soft section">
        <view>{{item.label}}</view>
        <button wx:if="{{item.retryable}}" class="btn secondary section" data-id="{{item.id}}" bindtap="retryTranscription" disabled="{{busy}}">重试这段转写</button>
      </view>
      <view wx:if="{{taskError}}" class="section">{{taskError}}</view>
    </view>
    <button class="btn secondary section" bindtap="refreshTasks" disabled="{{busy}}">重新查询转写状态</button>
    <view class="section optional-followup">
      <view class="section" role="status">{{followupStatus || '可选追问可以跳过；等待时仍可继续讲或直接整理。'}}</view>
      <button class="btn secondary section" bindtap="requestFollowup" disabled="{{busy}}">请求一条可选追问</button>
      <button class="btn secondary section" bindtap="refreshFollowup" disabled="{{busy}}">查询可选追问</button>
      <button wx:if="{{followup && followup.task && followup.task.state === 'failed'}}" class="btn secondary section" bindtap="retryFollowup" disabled="{{busy}}">重试本次追问</button>
      <view wx:if="{{interview.currentQuestion && interview.currentQuestion.source && interview.currentQuestion.source.kind === 'follow-up'}}" class="section">
        <textarea class="input section" value="{{followupText}}" bindinput="followupText" placeholder="也可以按自己的问法改写这一题" maxlength="2000" disabled="{{busy}}"/>
        <button class="btn secondary section" bindtap="rewriteFollowup" disabled="{{busy || !followupText}}">保存实际改写的问题</button>
      </view>
      <button class="btn secondary section" bindtap="skipFollowup" disabled="{{busy}}">跳过追问，继续原问题或整理</button>
    </view>
    <button class="btn section" bindtap="openStory" disabled="{{busy || state === 'device-error'}}">整理或查看故事</button>
    <button class="link section" bindtap="chooseAnother" disabled="{{busy}}">另选一个问题</button>
  </view>
  <button wx:if="{{interview && flowStep !== 'processing' && flowStep !== 'record'}}" class="btn secondary section" bindtap="showProcessing" disabled="{{busy}}">查看处理与追问</button>
  <button wx:if="{{flowStep !== 'record'}}" class="link section" bindtap="refresh" disabled="{{busy}}">重新查询与恢复</button>
  <button class="link section" bindtap="finish" disabled="{{busy || state === 'recording' || state === 'paused' || state === 'requesting' || state === 'saving' || state === 'device-error'}}">今天先到这里</button>
</view>
<block wx:else="">
<view class="interview-page"
  ><view
    wx:if="{{state==='idle' || state==='recording' || state==='requesting' || state==='saving' || state==='error'}}"
    ><image
      wx:if="{{photo}}"
      class="question-photo"
      src="{{photo}}"
      mode="aspectFill"
    /><view class="interview-question">{{question}}</view
    ><view class="interview-hint"
      >{{state==='recording'?'正在录音 · 尚未保存':state==='saving'?'正在保存，请先别退出':state==='requesting'?'正在打开麦克风':'点一下开始，说完再点一下。'}}</view
    ><view class="record-control"
      ><view wx:if="{{state==='recording'}}" class="record-timer"
        >{{timer}}</view
      ><button
        class="record-button {{state==='recording'?'recording':''}}"
        disabled="{{state==='requesting'||state==='saving'}}"
        aria-label="{{state==='recording'?'结束录音':'开始说'}}"
        bindtap="record"
        ><image
          class="record-icon"
          src="/assets/icons/{{state==='recording'?'square-light':'mic-light'}}.svg" /></button
      ><view class="record-label"
        >{{state==='recording'?'说完了，点一下':state==='saving'?'正在保存':state==='requesting'?'请稍候':'开始说'}}</view
      ><view wx:if="{{state==='recording'}}" class="wave"
        ><view /><view /><view /><view /><view /><view /><view /><view /><view /></view></view
    ><view wx:if="{{error}}" class="record-error"
      ><view class="error">{{error}}</view
      ><button class="btn secondary" bindtap="retry">重试</button
      ><button wx:if="{{permission}}" class="link" bindtap="settings"
        >打开麦克风设置</button
      ></view
    ></view
  ><view wx:if="{{state==='saved'}}" class="saved-state"
    ><view class="success-icon"
      ><image class="icon" src="/assets/icons/check-light.svg" /></view
    ><view class="interview-question center">这段声音，留下来了。</view
    ><view class="interview-hint center">已保存到本机，尚未上传云端</view
    ><view class="soft section"
      ><view class="small muted">还想听你说说</view
      ><view class="interview-followup"
        >那时候，家里最热闹的<text class="line-break">{{'\n'}}</text>是什么时候？</view
      ><button class="btn secondary" bindtap="continue"
        >再说一小段</button
      ></view
    ><view class="demo-note"
      >AI整理尚未接入。可先查看示例故事，<text class="line-break">{{'\n'}}</text>示例文字不代表本次录音内容。</view
    ><button class="btn" bindtap="example">看看整理后的故事示例</button
    ><button class="link" bindtap="finish">今天先到这里</button></view
  ></view
><view wx:if="{{state==='idle'}}" class="interview-footer"
  ><button class="btn quiet" bindtap="change"
    ><image class="icon small" src="/assets/icons/rotate-ccw.svg" />
    换一个问题</button
  ></view
>

</block>
