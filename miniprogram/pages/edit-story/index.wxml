<block wx:if="{{live}}">
<view class="page live-edit">
 <view class="eyebrow">校对故事</view><view class="title">把记忆里的细节，写准确。</view><view class="section">保留本人原意。保存将追加新版本，需要本人重新确认，原声与正式转录保留。</view>
 <view wx:if="{{busy}}" class="section">正在查询或保存，请稍候…</view>
 <view wx:if="{{error}}" class="error section">{{error}}</view>
 <button wx:if="{{!story}}" class="btn secondary section" bindtap="onShow" disabled="{{busy}}">重新读取故事</button>
 <block wx:if="{{story}}">
  <view class="section">故事标题</view><input class="live-input" value="{{title}}" data-field="title" bindinput="input" maxlength="200" />
  <view class="section">主题</view><input class="live-input" value="{{theme}}" data-field="theme" bindinput="input" maxlength="200" />
  <view wx:for="{{paragraphs}}" wx:key="index" class="section">
   <view>第 {{index+1}} 段</view><textarea class="live-textarea" value="{{item.text}}" data-index="{{index}}" bindinput="paragraphText" maxlength="-1" auto-height="{{true}}" />
   <view class="source-note">原有来源保留，新增事实请添加本人说明。</view>
   <view class="live-row"><button class="btn secondary" data-index="{{index}}" data-direction="-1" bindtap="moveParagraph" disabled="{{index===0 || busy}}">上移本段</button><button class="btn secondary" data-index="{{index}}" data-direction="1" bindtap="moveParagraph" disabled="{{index===paragraphs.length-1 || busy}}">下移本段</button></view>
  </view>
  <view wx:for="{{reviews}}" wx:key="index" class="section"><view>请核对：{{item.item}}</view><textarea class="live-textarea" value="{{item.reason}}" bindinput="reviewReason" data-index="{{index}}" auto-height="{{true}}" maxlength="2000" placeholder="逐项填写处理理由；未处理的核对项会阻止本人确认" /></view>
  <view class="section">本人校对说明</view>
  <view wx:for="{{notes}}" wx:key="id" class="section"><textarea class="live-textarea" value="{{item.text}}" data-index="{{index}}" bindinput="noteText" maxlength="2000" auto-height="{{true}}" /></view>
  <textarea class="live-textarea section" value="{{noteText}}" data-field="noteText" bindinput="input" maxlength="2000" auto-height="{{true}}" placeholder="添加本次本人补充的事实或说明" />
  <button wx:for="{{paragraphs}}" wx:key="index" class="btn secondary section" data-index="{{index}}" bindtap="addNote" disabled="{{busy}}">将说明关联到第 {{index+1}} 段</button>
  <button class="btn secondary section" bindtap="addNote" data-index="-1" disabled="{{busy}}">将说明另加为一段</button>
  <view class="section">原声清单与顺序</view>
  <view wx:for="{{audioClips}}" wx:key="clipId" class="section"><view>第 {{index+1}} 段原声</view><button class="btn secondary" data-index="{{index}}" bindtap="toggleAudio">{{item.included?'已选用：点击移出本版':'未选用：点击加入本版'}}</button><view class="live-row"><button class="btn secondary" data-index="{{index}}" data-direction="-1" bindtap="moveAudio" disabled="{{index===0 || busy}}">上移原声</button><button class="btn secondary" data-index="{{index}}" data-direction="1" bindtap="moveAudio" disabled="{{index===audioClips.length-1 || busy}}">下移原声</button></view></view>
  <view class="section">本版照片：{{photoSnapshot ? '已选第 '+photoSnapshot.revision+' 版' : '不附照片'}}</view>
  <view wx:for="{{photoSnapshot ? photoSnapshot.entries : []}}" wx:key="photoId" class="section">照片 {{index+1}}：{{item.caption || '无说明'}}</view>
  <button class="btn secondary section" bindtap="applyPhotos" disabled="{{busy}}">选用已保存的最新照片清单</button><button class="btn secondary section" bindtap="removePhotos" disabled="{{busy}}">本版不附照片</button>
  <button class="btn section" bindtap="save" disabled="{{busy}}">{{busy?'正在保存…':'保存为新版本'}}</button>
 </block>
</view>
</block>
<block wx:else="">
<view class="page with-dock"
  ><view class="note"
    >保留讲述者的本意。保存修改后，这篇故事需要本人重新确认。</view
  ><view class="field"
    ><text class="label">故事标题</text
    ><input
      value="{{title}}"
      data-field="title"
      bindinput="input"
      maxlength="40" /></view
  ><view class="field"
    ><text class="label">故事正文</text
    ><textarea
      class="edit-body"
      value="{{body}}"
      data-field="body"
      bindinput="input"
      maxlength="10000"
      auto-height="{{true}}"
    /></view
  ><view class="error">{{error}}</view></view
><view class="dock"
  ><button class="btn" bindtap="save">保存修改，重新确认</button></view
>
</block>
