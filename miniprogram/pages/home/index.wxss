.project-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.project-heading .s-link {
  font-size: 34rpx;
}
.landing {
  padding-bottom: calc(340rpx + env(safe-area-inset-bottom));
}
.landing-hero {
  position: relative;
  height: 760rpx;
  max-height: 54vh;
  background: #efe4d6;
  overflow: hidden;
}
.landing-hero > image {
  position: absolute;
  /* The 825 × 1100 image fills the width; crop at 20% to keep text clear. */
  top: calc(20% - 200rpx);
  left: 0;
  width: 100%;
  height: 1000rpx;
}
.landing-copy {
  position: absolute;
  left: 44rpx;
  right: 30rpx;
  top: 28rpx;
}
.landing-copy .serif {
  font-size: 48rpx;
  line-height: 1.4;
  font-weight: 600;
}
.landing-copy text {
  display: block;
}
.landing-sub {
  font-size: 30rpx;
  color: #795239;
  margin-top: 14rpx;
}
.benefits {
  display: flex;
  margin: 26rpx 22rpx;
  text-align: center;
}
.benefits > view {
  flex: 1;
  border-right: 1rpx solid var(--line);
  padding: 8rpx;
}
.benefits > view:last-child {
  border: 0;
}
.benefits image {
  width: 56rpx;
  height: 56rpx;
  margin: 0 auto 20rpx;
}
.benefits text {
  white-space: pre-line;
  font-size: 34rpx;
  line-height: 1.5;
}
.benefits > view > view {
  font-size: 27rpx;
  color: var(--muted);
  margin-top: 12rpx;
}
.landing-note {
  text-align: center;
  font-size: 38rpx;
  margin-top: 48rpx;
}
.purchase-dock {
  position: fixed;
  bottom: calc(140rpx + env(safe-area-inset-bottom));
  left: 0;
  right: 0;
  background: var(--paper);
  padding: 20rpx 38rpx;
  z-index: 3;
}
.purchase-card {
  display: flex;
  align-items: center;
  gap: 26rpx;
  width: 100%;
  height: 138rpx;
  background: #efe2d3;
  border-radius: 24rpx;
  overflow: hidden;
  text-align: left;
  font-size: 32rpx;
}
.purchase-card > image {
  width: 140rpx;
  height: 138rpx;
}
.amount {
  font-size: 48rpx;
  color: #895a3e;
}
.included {
  border-left: 1rpx solid #b69c86;
  margin-left: 14rpx;
  padding-left: 16rpx;
}
.purchase-label {
  color: var(--olive);
  font-weight: 600;
  font-size: 38rpx;
}
.s-term {
  padding: 0 24rpx;
}
