<app-loading wx:if="{{pageLoading}}" variant="book" />
<block wx:else>
<view class="s-page"><view class="s-book"><view class="s-subtitle">{{title}}</view><view class="s-muted">{{salutation}}</view><image wx:if="{{image}}" src="{{image}}" mode="aspectFill" /><view wx:elif="{{hasPhoto}}"><app-loading wx:if="{{busy}}" variant="photo" /><view wx:else class="s-muted">封面照片暂未加载</view></view></view><label class="s-field">书名<input class="s-input" value="{{title}}" data-field="title" bindinput="input" maxlength="80" /></label><label class="s-field">封面寄语（选填）<input class="s-input" value="{{salutation}}" data-field="salutation" bindinput="input" maxlength="80" /></label><button class="s-row" bindtap="choose" disabled="{{busy}}"><text>封面图片</text><text>{{hasPhoto?'更换照片':'选择照片'}}　›</text></button><view class="s-error" wx:if="{{status}}">{{status}}</view><view class="s-dock"><button class="s-button" bindtap="save" disabled="{{busy}}" loading="{{busy}}">保存书封</button></view></view>

</block>
