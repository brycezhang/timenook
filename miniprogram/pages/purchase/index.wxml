<tn-navigation title="确认购买"/>
<view class="tn-page with-dock">
 <view class="tn-card"><view class="purchase-book-row"><view class="mini-book"><text class="mini-title">{{bookTitle}}</text><text class="mini-subtitle">那些年，那些我们</text><image class="mini-photo" src="/assets/purchase-cover.jpg" mode="aspectFill"/><text class="mini-brand">时光故事</text></view><view class="purchase-book-copy"><view class="purchase-book-title">{{bookTitle}}</view><view class="purchase-tag">{{purchaseKind === 'self' ? '送给自己' : '送给' + relationship}}</view><view class="purchase-book-meta">时光故事 · 1 本实体书</view></view></view></view>
 <view class="tn-card purchase-benefits"><view class="tn-row"><view class="tn-icon-tile"><image class="tn-icon" src="/assets/icons/mic.svg"/></view><text class="tn-grow">语音记录与故事整理</text></view><view class="tn-row"><view class="tn-icon-tile"><image class="tn-icon" src="/assets/icons/image.svg"/></view><text class="tn-grow">照片、文字与原声</text></view><view class="tn-row"><view class="tn-icon-tile"><image class="tn-icon" src="/assets/icons/package.svg"/></view><text class="tn-grow">完成书稿后寄送</text></view></view>
 <view wx:if="{{loading && !packagePrice}}" class="purchase-skeleton line" aria-label="正在读取套餐价格"/>
 <view wx:elif="{{packagePrice}}" class="purchase-total"><text>应付金额</text><view class="purchase-price">¥{{packagePrice}}</view></view>
 <view wx:if="{{!loading && !purchasable && !hasOrderIntent && !error}}" class="tn-muted">套餐准备中，暂未开放购买</view>
 <view wx:if="{{error}}" class="tn-error" role="alert">{{error}}<button wx:if="{{!packageVersionId}}" class="tn-link" bindtap="retry">重新加载</button></view>
</view>
<view class="tn-dock"><button class="tn-button" bindtap="pay" loading="{{busy}}" disabled="{{busy || loading || (!hasOrderIntent && !purchasable)}}">{{hasOrderIntent ? '查询购买结果' : '微信支付 ¥' + packagePrice}}</button></view>
<quick-login id="quick-login" visible="{{loginVisible}}" bind:success="loginSucceeded" bind:close="closeLogin"/>
