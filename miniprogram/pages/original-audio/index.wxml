<view class="original-audio-page">
  <view class="eyebrow">岁月成书 · 纸书原声</view>
  <view class="audio-title">书中原声</view>
  <view class="audio-intro">每一段，都是本人留下的真实讲述。</view>
  <view wx:if="{{entry}}" class="audio-card">
    <view class="story-title">{{entry.story.title}}</view>
    <view class="version-note">对应纸书故事第 {{entry.story.version}} 版 · {{entry.clips.length}} 段原声</view>
    <view wx:for="{{entry.clips}}" wx:key="clipId" class="clip-row">
      <view class="clip-label">第 {{index + 1}} 段原声</view>
      <button wx:if="{{playingClipId === item.clipId}}" class="audio-button secondary" bindtap="toggle">{{paused?'继续播放':'暂停播放'}}</button>
      <button wx:else="" class="audio-button" data-id="{{item.clipId}}" bindtap="play" disabled="{{busy}}">播放第 {{index + 1}} 段</button>
      <view wx:if="{{playingClipId===item.clipId}}"><slider min="0" max="{{duration || 1}}" value="{{position}}" bindchange="seek" activeColor="#46563c" /><view class="s-muted">{{positionLabel}} / {{durationLabel}}</view></view>
    </view>
    <view wx:if="{{entry.accessExpiresAt}}" class="access-note">在线回听有效至 {{entry.accessExpiresAt}}</view>
  </view>
  <view wx:else="" class="audio-card empty-card">
    <view class="locked-title">原声仅向获授权的账号开放</view>
    <view>请使用已加入这个项目的微信账号登录。</view>
    <button wx:if="{{!loggedIn}}" class="audio-button" bindtap="login" disabled="{{busy}}">微信登录后回听</button><view class="s-term">登录即表示同意<text bindtap="terms">《使用条款》</text></view>
  </view>
  <view wx:if="{{status}}" class="audio-status" role="status">{{status}}</view>
  <view wx:if="{{busy}}" class="waiting">正在核对，请稍候…</view>
  <button wx:if="{{loggedIn}}" class="audio-button secondary" bindtap="refresh" disabled="{{busy}}">重新查询</button>
  <button wx:if="{{loggedIn}}" class="audio-button text-button" bindtap="logout" disabled="{{busy}}">退出登录</button>
  <view class="s-muted">此入口对应纸书中的故事版本，后续改稿不会替换纸书原声。</view>
</view>