<view class="s-page live-story"><view class="s-title">{{story.revision.title || '新记录的故事'}}</view><view class="s-muted">{{stage}}</view>    <view wx:if="{{story && story.task && story.task.sources.length}}" class="live-audio-list">
      <view wx:for="{{liveAudioSources}}" wx:key="clipId" class="live-audio-card {{playingClipId === item.clipId ? 'is-playing' : ''}}">
      <button class="live-audio-button"
        aria-label="{{playingClipId === item.clipId ? '暂停回听' : pausedClipId === item.clipId ? '继续回听第 ' + (index+1) + ' 段原声' : '回听第 ' + (index+1) + ' 段原声'}}"
        bindtap="playLive" data-id="{{item.clipId}}" disabled="{{busy || audioBusy || privateError}}">
        <view class="live-audio-icon"><image src="/assets/icons/{{playingClipId === item.clipId ? 'pause-light' : 'play-light'}}.svg" /></view>
        <view class="live-audio-copy">
          <text class="live-audio-label">{{loadingClipId === item.clipId ? '正在加载原声…' : playingClipId === item.clipId ? '暂停试听' : pausedClipId === item.clipId ? '继续试听' : story.task.sources.length > 1 ? '试听第 ' + (index+1) + ' 段原声' : '试听原声'}}</text>
          <text class="live-audio-status">{{playingClipId === item.clipId ? '正在播放 · 点击暂停' : pausedClipId === item.clipId ? '已暂停 · 点击继续' : '原声已保存'}}</text>
        </view>
        <view class="live-audio-wave" aria-hidden="true"><view /><view /><view /><view /><view /><view /><view /></view>
      </button>
      <view class="live-audio-timeline">
        <slider class="live-audio-slider" aria-label="{{'第 ' + (index+1) + ' 段原声播放进度'}}"
          min="0" max="{{playingClipId === item.clipId || pausedClipId === item.clipId ? audioDuration : item.durationSeconds}}" step="0.1"
          value="{{playingClipId === item.clipId || pausedClipId === item.clipId ? audioPosition : 0}}"
          disabled="{{audioBusy || privateError || (playingClipId !== item.clipId && pausedClipId !== item.clipId) || !audioDuration}}"
          data-id="{{item.clipId}}" bindchanging="draggingLive" bindchange="seekLive" activeColor="#697657" backgroundColor="#d4dac7" block-color="#697657" block-size="16" />
        <view class="live-audio-times"><text>{{playingClipId === item.clipId || pausedClipId === item.clipId ? audioPositionLabel : '00:00'}}</text><text>{{playingClipId === item.clipId || pausedClipId === item.clipId ? audioDurationLabel : item.durationLabel}}</text></view>
      </view>
      </view>
    </view>
<view class="s-error">{{audioError || error || privateError || saveWarning}}</view><view class="s-body s-space" wx:for="{{liveParagraphs}}" wx:key="index"><text selectable>{{item.text}}</text></view><view wx:if="{{needsReview}}" class="s-muted s-space">整理可能有遗漏，可以直接修改文字。</view><block wx:if="{{liveTranscripts.length}}"><view class="s-subtitle s-space">已识别的文字</view><view class="s-body s-space" wx:for="{{liveTranscripts}}" wx:key="clipId">{{item.text}}</view></block><block wx:if="{{story.revision}}"><button class="s-row" bindtap="editLivePhotos"><text>照片与说明</text><text>›</text></button><button class="s-row" bindtap="audioSelection"><text>入书原声</text><text>›</text></button><button class="s-link" disabled="{{busy}}" bindtap="toggleInclusion">{{story.included===false?'将这篇放入书中':'这篇暂不入书'}}</button></block><button wx:if="{{retryable}}" class="s-button secondary s-space" bindtap="retryLive" disabled="{{busy}}">重新整理</button><button class="s-link" bindtap="recoverInterview">继续补充讲述</button><button wx:if="{{error}}" class="s-link" bindtap="refresh">重新查询</button><view class="s-dock" wx:if="{{story.revision}}"><button class="s-button" bindtap="edit" disabled="{{busy}}">修改文字</button></view></view>