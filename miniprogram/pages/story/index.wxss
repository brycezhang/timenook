.story-title {
  margin-top: 18rpx;
  font-size: 52rpx;
}
.story-meta {
  margin: 24rpx 0 32rpx;
}
.audio-row {
  display: flex;
  align-items: center;
  text-align: left;
  gap: 20rpx;
  background: #eeefe5;
  border-radius: 18rpx;
  padding: 20rpx 24rpx;
  width: 100%;
  font-size: 30rpx;
}
.audio-row .badge-icon {
  width: 68rpx;
  height: 68rpx;
  background: #e0e5d3;
}
.story-body {
  margin: 40rpx 0;
}
.paragraph {
  display: block;
  font-size: 38.5rpx;
  line-height: 1.9;
  margin-bottom: 34rpx;
  color: #3e372e;
}
.add-photo {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  font-size: 28rpx;
  border: 2rpx dashed #cec1ad;
  border-radius: 16rpx;
  min-height: 130rpx;
  color: var(--muted);
  width: 100%;
}
.story-actions {
  display: flex;
  justify-content: space-around;
  margin-top: 20rpx;
}
.photos {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 20rpx;
}
.photos image {
  width: calc(50% - 5rpx);
  height: 240rpx;
  border-radius: 12rpx;
}
