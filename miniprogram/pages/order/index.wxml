<view wx:if="{{mode === 'live'}}" class="page">
 <view class="title">我的订单与项目</view><view class="section note">本地合成验证 · 不会产生真实扣款，正式购买尚未开放。</view>
 <view wx:if="{{loading}}" class="section">正在查询服务端订单…</view>
 <view wx:if="{{paymentError}}" class="soft section">{{paymentError}}</view>
 <button class="link" bindtap="restoreOrders" disabled="{{loading}}">重新查询订单</button>
 <view wx:if="{{!loading && !orders.length && !paymentError}}" class="section">当前账号还没有订单。</view>
 <button wx:for="{{orders}}" wx:key="id" class="btn secondary section" data-id="{{item.id}}" bindtap="chooseOrder">{{item.bookTitle}} · 送给{{item.recipient.relationshipLabel}}</button>
 <view wx:if="{{activeOrder}}" class="paper section"><view class="section-title">{{activeOrder.bookTitle}}</view><view class="note">{{paymentStatus}}</view><view class="small muted">订单：{{activeOrder.outTradeNo}}</view>
 <view wx:if="{{activeOrder.project}}" class="section"><view>首本制作权益：1本</view><view class="note">项目已恢复。付款不代表讲述者已授权；请邀请本人分别选择资料用途。</view><view class="small muted">项目：{{activeOrder.project.id}}</view><button class="btn secondary section" bindtap="invite">邀请与参与管理</button></view></view>
 <view wx:if="{{activeOrder && activeOrder.state === 'pending'}}" class="section"><button class="btn" disabled="{{loading}}" bindtap="retryPayment">继续本地验证并查询</button><button class="link" disabled="{{loading}}" bindtap="closeOrder">关闭此验证订单</button></view>
 <button class="btn secondary section" bindtap="catalog">查看套餐与赠礼称呼</button>
</view>
<block wx:else="">
<view class="page"
  ><view class="success-icon"
    ><image class="icon" src="/assets/icons/gift-light.svg" /></view
  ><view class="title center"
    >{{p.printRevision?'心意，已准备好成书':'故事，正在慢慢生长'}}</view
  ><view class="subtitle center"
    >{{p.printRevision?'已保存演示订单，尚未提交真实制作':'首本实体书，已包含在你的套餐中'}}</view
  ><view class="paper section"
    ><view class="row"
      ><image class="cover-mini" src="{{bookImage}}" mode="aspectFill" /><view
        class="grow"
        ><view class="serif section-title">{{p.title}}</view
        ><view class="note">1本专属故事书</view
        ><view class="pill pending"
          >{{p.printRevision?'本机演示订单':'等待完成书稿'}}</view
        ></view
      ></view
    ><view class="divider" /><view class="order-step active"
      ><view class="step-dot" /><view
        ><view>项目已建立</view
        ><view class="small muted">演示套餐 ¥999 · 未真实扣款</view></view
      ></view
    ><view class="order-step {{p.printRevision?'active':''}}"
      ><view class="step-dot" /><view
        ><view>书稿确认与收货信息</view
        ><view class="small muted"
          >{{p.printRevision?'已保存在本机':'等待故事与完整书稿确认'}}</view
        ></view
      ></view
    ><view class="order-step"
      ><view class="step-dot" /><view
        ><view>印制与寄送</view
        ><view class="small muted">暂未接入生产与物流服务</view></view
      ></view
    ></view
  ><view wx:if="{{p.printRevision}}" class="soft section"
    ><view class="row"
      ><image class="icon" src="/assets/icons/map-pin.svg" /><text
        >{{p.address.name}} · {{p.address.phone}}</text
      ></view
    ><view class="note" style="margin-top: 14rpx"
      >{{p.address.detail}}</view
    ></view
  ><view class="stack section"
    ><button class="btn" bindtap="book">回看这本书</button
    ><button class="btn secondary" bindtap="project">继续记录故事</button></view
  ><button class="link" bindtap="support">需要帮助？联系时光里</button></view
>

</block>
