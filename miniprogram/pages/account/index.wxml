<view class="s-page with-tabs"><view class="profile"><view class="avatar"><image src="/assets/icons/user.svg"/></view><view><view class="s-subtitle">{{loggedIn ? '我的时光故事' : '欢迎来到时光故事'}}</view><view class="s-muted">把珍贵的回忆，慢慢留下。</view></view></view>
 <block wx:if="{{!loggedIn}}"><button class="s-button s-space" bindtap="login" loading="{{busy}}" disabled="{{busy}}">微信登录</button><view class="s-term">登录即表示同意<text bindtap="terms">《使用条款》</text></view></block>
 <view class="s-space"><button wx:if="{{loggedIn}}" class="s-row" bindtap="projects"><text>项目</text><text class="s-arrow">›</text></button><button class="s-row" bindtap="purchase"><text>新购一本书</text><text class="s-arrow">›</text></button><button class="s-row" bindtap="terms"><text>使用条款</text><text class="s-arrow">›</text></button></view>
 <view wx:if="{{status}}" class="s-error">{{status}}</view><button wx:if="{{loggedIn}}" class="s-link s-space" bindtap="logout" disabled="{{busy}}">退出登录</button><view class="s-term s-space">时光故事 · 岁月成书</view></view>
 <view wx:if="{{!nativeTabs}}" class="tabs"><button class="tab" bindtap="home"><image class="icon" src="/assets/icons/book-open.svg"/>岁月成书</button><button class="tab active"><image class="icon" src="/assets/icons/user.svg"/>我的</button></view>
