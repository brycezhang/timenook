.interview-focus {
  padding: 38rpx 46rpx 36rpx;
  min-height: calc(100vh - 50px);
  display: flex;
  flex-direction: column;
  color: var(--ink);
  font-size: 34rpx;
  line-height: 1.6;
}
.focus-topic { color: var(--muted); font-size: 27rpx; margin-bottom: 40rpx; }
.interview-question { font-size: 52rpx; font-weight: 600; line-height: 1.55; color: var(--ink); overflow-wrap: anywhere; }
.question-hint { color: var(--muted); font-size: 36rpx; line-height: 1.65; margin-top: 38rpx; }
.record-guide { background: var(--surface); border-radius: 34rpx; margin-top: 40rpx; padding: 30rpx 34rpx; font-size: 34rpx; }
.guide-detail { color: var(--muted); font-size: 28rpx; margin-top: 22rpx; line-height: 1.65; }
.focus-recorder { display: flex; flex-direction: column; align-items: center; justify-content: center; margin: 48rpx 0 28rpx; }
.record-button { display: flex; align-items: center; justify-content: center; width: 224rpx; height: 224rpx; min-width: 112px; min-height: 112px; border-radius: 50%; background: var(--olive); flex-shrink: 0; }
.record-icon { width: 76rpx; height: 76rpx; }
.record-label { margin-top: 28rpx; font-size: 34rpx; font-weight: 500; }
.microphone-note { text-align: center; color: var(--muted); font-size: 27rpx; line-height: 1.7; }
.focus-link { min-height: 96rpx; padding: 18rpx 10rpx; font-size: 32rpx; line-height: 1.6; background: transparent; color: var(--brown-dark); display: flex; align-items: center; justify-content: center; width: 100%; }
.focus-bottom { margin-top: auto; padding-top: 30rpx; }
.focus-bottom > .btn { font-size: 36rpx; min-height: 112rpx; }
.focus-bottom > .focus-link { margin-top: 8rpx; }
.focus-error { font-size: 30rpx; color: #9a3f2e; line-height: 1.7; margin: 24rpx 0; }
.record-timer { font-size: 56rpx; text-align: center; font-variant-numeric: tabular-nums; color: #a34e41; margin-top: 52rpx; }
.recording { background: #b95b4c; box-shadow: 0 0 0 18rpx #f1e1da; animation: breath 2s infinite; }
.record .focus-recorder { margin-top: 42rpx; }
.pause-control { margin-top: 16rpx; }
.state-icon { width: 88rpx; height: 88rpx; margin: 24rpx 0 40rpx; }
.step-title { font-size: 48rpx; line-height: 1.55; }
.review-question { color: var(--muted); font-size: 32rpx; margin-top: 24rpx; }
.review-player { margin: 44rpx 0 24rpx; padding: 36rpx 24rpx; background: var(--surface); border-radius: 28rpx; display: flex; flex-direction: column; align-items: center; gap: 28rpx; text-align: center; }
.review-duration { font-size: 64rpx; color: var(--brown-dark); font-variant-numeric: tabular-nums; }
.play-recording { width: 128rpx; height: 128rpx; min-width: 64px; min-height: 64px; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #eeefe5; }
.play-recording .icon { width: 50rpx; height: 50rpx; }
.processing-content { margin-top: 48rpx; text-align: center; }
.processing-emblem { width: 132rpx; height: 132rpx; display: flex; align-items: center; justify-content: center; margin: 0 auto 40rpx; background: #e8ecdf; border-radius: 50%; }
.processing-emblem .icon { width: 66rpx; height: 66rpx; }
.processing-description { font-size: 36rpx; line-height: 1.8; color: var(--muted); margin-top: 28rpx; }
.processing-detail { color: var(--muted); font-size: 29rpx; line-height: 1.7; margin-top: 28rpx; }
.saving-indicator { width: 48rpx; height: 48rpx; border: 4rpx solid var(--line); border-top-color: var(--olive); border-radius: 50%; animation: spin 1s linear infinite; margin: 36rpx auto; }
.focus-sheet { position: fixed; inset: 0; z-index: 12; padding: 32rpx 40rpx calc(32rpx + env(safe-area-inset-bottom)); background: var(--paper); overflow-y: auto; }
.sheet-heading { display: flex; justify-content: space-between; align-items: center; gap: 20rpx; border-bottom: 1rpx solid var(--line); margin-bottom: 32rpx; padding-bottom: 14rpx; }
.sheet-heading .focus-link { width: auto; font-size: 28rpx; flex-shrink: 0; }
.question-preview { font-size: 46rpx; line-height: 1.65; margin: 44rpx 0; }
.followup-editor { margin-top: 30rpx; }
.followup-editor .btn { margin-top: 24rpx; }
.input { font-size: 36rpx; }
@keyframes spin { to { transform: rotate(360deg); } }
@keyframes breath { 50% { box-shadow: 0 0 0 26rpx #f1e1da; } }
@media (prefers-reduced-motion: reduce) { .recording, .saving-indicator { animation: none; } }
@media (max-height: 720px) { .interview-focus { padding-top: 24rpx; } .focus-topic { margin-bottom: 24rpx; } .question-hint { margin-top: 24rpx; } .record-guide { margin-top: 28rpx; padding: 24rpx 30rpx; } .focus-recorder { margin-top: 36rpx; margin-bottom: 24rpx; } .focus-bottom { padding-top: 16rpx; } }

.interview-focus { position: relative; }
.focus-more { position:absolute; right:32rpx; top:18rpx; font-size:16px; min-width:48px; min-height:48px; color:var(--muted); }
.focus-topic { font-size:14px; }
.interview-question { font-size:28px; }
.question-hint { font-size:20px; }
.record-guide { font-size:19px; }
.guide-detail { font-size:16px; }
.record-label { font-size:18px; }
.microphone-note { font-size:14px; }
