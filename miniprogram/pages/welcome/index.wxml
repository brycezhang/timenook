<view wx:if="{{mode === 'live'}}" class="page">
  <view class="title">本人参与与资料用途</view>
  <view class="soft section">隔离合成验证 · 当前告知和核验证据仅供工程测试；真实服务规则待冻结。</view>
  <view wx:if="{{accountId}}" class="small muted section">当前账号：{{accountId}}</view>
  <view wx:if="{{status}}" class="soft section">{{status}}</view>
  <view wx:if="{{invitation}}" class="paper section">
    <view class="section-title">{{invitation.inviter}} 邀请你</view>
    <view wx:for="{{invitation.process}}" wx:key="*this" class="section">{{index + 1}}. {{item}}</view>
    <view class="note section">{{invitation.choice}}</view>
    <view class="note section">申请只表示愿意参与，须发起人核对后绑定。采集保存、AI 处理和向发起人共享各自选择；哪些故事入书需之后另行确认。</view>
    <button wx:if="{{loggedIn}}" class="btn section" bindtap="accept" disabled="{{busy || invitation.policyStatus !== 'synthetic-only'}}">已读说明，申请本人参与</button>
  </view>
  <button wx:if="{{!loggedIn}}" class="btn section" bindtap="loginLive" disabled="{{busy}}">微信登录后参与</button>
  <button class="link" bindtap="refreshLive" disabled="{{busy}}">重新查询参与状态</button>
  <button wx:for="{{memberships}}" wx:key="projectId" class="btn secondary section" data-id="{{item.projectId}}" bindtap="openParticipation">{{item.state === 'pending' ? '等待发起人核对' : '查看本人的用途选择'}} · {{item.projectId}}</button>
  <view wx:if="{{participation}}" class="section">
    <button wx:if="{{participation.canRead}}" class="btn section" bindtap="project" disabled="{{busy}}">进入本人参与的项目</button>
    <button wx:if="{{participation.canRead}}" class="btn secondary section" bindtap="plan" disabled="{{busy}}">编辑个人大纲与问题</button>
    <button wx:if="{{participation.role === 'initiator'}}" class="btn section" bindtap="assisted">无个人微信？本人在场同机协助</button>
    <view class="small muted">项目：{{participation.projectId}}</view>
    <view class="note section">拒绝或撤回不取消已付款订单，仍可联系服务。已下载到设备的副本无法远程回收。本人入书确认是之后的独立决定。</view>
    <view wx:if="{{participation.role === 'narrator'}}">
      <view wx:for="{{participation.choices}}" wx:key="purpose" class="paper section">
        <view>{{item.purpose === 'collection' ? '采集并保存讲述和照片' : item.purpose === 'ai' ? '交由AI处理素材' : '向本项目发起人共享资料'}}</view>
        <view class="note">{{item.granted === null ? '尚未选择' : item.granted ? '已同意' : '已拒绝或撤回'}}</view>
        <button class="btn secondary section" data-purpose="{{item.purpose}}" data-granted="true" bindtap="chooseConsent" disabled="{{busy || participation.policyStatus !== 'synthetic-only'}}">同意此用途</button>
        <button class="link" data-purpose="{{item.purpose}}" data-granted="false" bindtap="chooseConsent" disabled="{{busy || participation.policyStatus !== 'synthetic-only'}}">{{item.granted ? '撤回此用途' : '拒绝此用途'}}</button>
      </view>
      <view class="soft section">{{participation.canCollect ? '已授权采集，可以进入项目开始讲述。' : '未获采集许可，不能开始录音。'}}{{participation.canProcessAi ? '已单独授权AI处理。' : 'AI处理未获许可。'}}</view>
    </view>
    <view class="paper section"><view class="section-title">联系服务与本人账号绑定</view><view class="note section">目标账号先微信登录，再提供其账号编号。客服核验本人后换绑；新账号须重新选择资料用途。</view>
      <input class="input section" placeholder="目标账号编号" value="{{targetUserId}}" bindinput="targetInput" disabled="{{busy}}"/>
      <button class="btn secondary section" bindtap="requestRebind" disabled="{{busy || !targetUserId || participation.policyStatus !== 'synthetic-only'}}">{{participation.bindingVersion === 0 ? '提交客服本人账号绑定申请' : '提交客服换绑申请'}}</button>
      <view wx:if="{{supportCaseRef}}" class="note section">工单：{{supportCaseRef}}</view>
      <view wx:for="{{careRequests}}" wx:key="id" class="section"><view class="small muted">{{item.kind === 'rebind' ? '换绑工单' : item.kind === 'withdraw' ? '撤回工单' : item.kind === 'export' ? '资料导出工单' : item.kind === 'correction' ? '故事限时校对工单' : item.kind === 'production_handoff' ? '生产交接工单' : item.kind === 'first_copy_expiry' ? '制作期限审核工单' : item.kind === 'quality' ? '质量售后工单' : item.kind === 'refund' ? '退款工单' : '删除工单'}}：record:{{item.id}}</view><view class="note">处理状态：{{item.state === 'open' ? '待客服核验' : item.kind === 'withdraw' ? '当前访问已撤销，后续联动待处理' : item.state === 'verified' ? '已核验，后续交付或执行待完成' : '已完成'}}</view></view>
    </view>
  </view>
  <button class="link" bindtap="back">返回首页</button>
</view>
<block wx:else="">
<view wx:if="{{missing}}" class="page"
  ><view class="title">这是一张示例邀请</view
  ><view class="subtitle"
    >跨设备邀请尚未接入。请先在本机体验创建一个项目。</view
  ><button class="btn section" bindtap="decline">前往首页</button></view
><view wx:else="" class="page with-dock welcome"
  ><view class="welcome-leaf"
    ><image class="icon" src="/assets/icons/leaf.svg" /></view
  ><view class="title large"
    >你收到了一份<text class="line-break">{{'\n'}}</text>特别的礼物</view
  ><view class="subtitle">TA想听听你的人生故事，把它写成一本书。</view
  ><view class="letter section"
    ><view class="small muted">来自{{p.buyer}}的心意</view
    ><view class="letter-body serif"
      >{{p.recipient}}，<text class="line-break">{{'\n'}}</text>想更了解你，<text
        class="line-break"
      >
      </text
      >也想把你的故事<text class="line-break">{{'\n'}}</text>留给我们。</view
    ><view class="letter-heart"
      ><image class="icon" src="/assets/icons/heart.svg" /></view></view
  ><view class="welcome-steps section"
    ><view
      ><image class="icon" src="/assets/icons/mic.svg" /><text
        >说一段往事</text
      ></view
    ><view
      ><image class="icon" src="/assets/icons/clipboard-check.svg" /><text
        >确认你的故事</text
      ></view
    ><view
      ><image class="icon" src="/assets/icons/book-open.svg" /><text
        >珍藏成一本书</text
      ></view
    ></view
  ><view class="participation note"
    >你的讲述、照片和故事会与赠礼的子女共享。哪些内容入书，由你决定；你可以暂停或退出。</view
  ><button class="check-row" bindtap="agree"
    ><view class="check-box {{agreed?'on':''}}"
      ><image class="icon" src="/assets/icons/check-light.svg" /></view
    ><text>我了解并愿意参与，保存我的讲述与照片</text></button
  ><button class="link" bindtap="privacy">查看完整资料与隐私说明</button></view
><view wx:if="{{!missing}}" class="dock"
  ><button class="btn" disabled="{{!agreed}}" bindtap="accept"
    >开始讲我的故事
    <image class="icon" src="/assets/icons/arrow-right-light.svg" /></button
  ><button class="link" bindtap="back">暂时不参加</button></view
>
</block>

<view wx:if="{{participation}}" class="page withdrawal-status">
  <button class="btn secondary section" bindtap="showWithdrawal" disabled="{{busy}}">查看撤回处置进度</button>
  <view wx:if="{{withdrawal}}" class="paper section">
    <view class="section-title">撤回与账号变更处置</view>
    <view class="note section">{{productionDisposition}}</view>
    <view class="note">{{withdrawal.boundary}}</view>
    <view wx:if="{{withdrawal.production}}" class="note section">处理工单：{{withdrawal.production.caseId}}。处理人：{{withdrawal.production.ownerAdminId}}。处理期限：{{withdrawal.production.dueAt}}</view>
  </view>
</view>
