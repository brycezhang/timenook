.recipients {
  display: flex;
  gap: 20rpx;
}
.recipient {
  flex: 1;
  display: flex;
  align-items: center;
  flex-direction: column;
  gap: 14rpx;
  padding: 28rpx 10rpx;
  border: 2rpx solid var(--line);
  border-radius: 22rpx;
  background: var(--surface);
}
.recipient.selected {
  border-color: var(--terracotta);
  background: #f6eae0;
}
.recipient .icon {
  width: 64rpx;
  height: 64rpx;
}
.recipient .small {
  font-size: 22rpx;
}
.purchase-book {
  width: 190rpx;
  height: 230rpx;
  border-radius: 12rpx;
}
.pay-btn {
  width: 390rpx;
}
