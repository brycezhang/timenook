<app-loading wx:if="{{pageLoading}}" variant="list" />
<block wx:else>
<view class="s-page"><view class="s-title">照片与说明</view><view class="s-muted" wx:if="{{!rows.length}}">给故事添一张照片。</view><view class="s-space"><sort-list items="{{rows}}" editable disabled="{{busy}}" bindopen="showPhoto" bindcaption="editCaption" bindreorder="sort" /></view><view wx:for="{{photos}}" wx:key="clientPhotoId" wx:if="{{item.state!=='sealed'}}" class="s-card"><image wx:if="{{item.path}}" src="{{item.path}}" mode="aspectFit" class="s-cover" /><app-loading wx:if="{{item.state==='uploading' || item.state==='verifying' || item.state==='saving'}}" variant="spinner" /><view class="s-muted">{{item.state==='failed'||item.state==='save-error'?'上传未完成，请重试':'正在上传照片…'}}</view><button wx:if="{{item.state==='failed'||item.state==='local'}}" class="s-link" data-id="{{item.clientPhotoId}}" bindtap="upload">重新上传</button><button wx:if="{{item.state==='save-error'}}" class="s-link" data-id="{{item.clientPhotoId}}" bindtap="retrySave">重新保存照片</button></view><button class="s-button secondary s-space" bindtap="choose" disabled="{{busy}}">添加照片</button><view class="s-error">{{status}}</view><view class="s-dock"><button class="s-button" bindtap="back" disabled="{{busy}}" loading="{{busy}}">完成，返回故事</button></view></view>
</block>
