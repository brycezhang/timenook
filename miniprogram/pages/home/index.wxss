page { background: #fff; }
.project-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.project-heading .s-link {
  font-size: 34rpx;
}

.landing { gap: 16px; padding-bottom: calc(240px + env(safe-area-inset-bottom)); }
.landing-intro { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.landing-headline { font-size: 32px; line-height: 1.3; letter-spacing: -.8px; font-weight: 700; }
@media (max-width: 350px) { .landing-headline { font-size: 30px; } }
.landing-sub { margin-top: -7px; }
.landing-photo { margin: 0 -22px; position: relative; background: #f1e9de; }
.landing-photo image { width: 100%; height: 220px; }
.landing-photo text { position: absolute; bottom: 12px; left: 22px; background: #ffffffe8; border-radius: 8px; padding: 5px 8px; font-size: 10px; color: #756859; }
.landing-benefits { display: flex; gap: 12px; align-items: flex-start; text-align: center; padding: 2px 0 4px; }
.landing-benefits > view { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 8px; }
.landing-benefits image { width: 24px; height: 24px; margin: 4px; }
.landing-benefit-title { font-size: 14px; font-weight: 600; line-height: 1.5; min-height: 42px; }
.landing-benefits text { color: #756859; font-size: 12px; line-height: 1.6; }
.landing-price { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; margin-bottom: 4px; font-size: 13px; line-height: 1.2; color: #756859; }
.landing-amount { font-size: 22px; font-weight: 600; color: #382c24; }

.sample-arrow { width: 16px; height: 16px; }
