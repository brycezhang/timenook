.project-head {
  display: flex;
  gap: 22rpx;
  align-items: center;
}
.project-head .title {
  font-size: 50rpx;
  margin-top: 16rpx;
}
.project-head .eyebrow {
  font-size: 21rpx;
  letter-spacing: 2rpx;
}
.project-book {
  width: 172rpx;
  height: 208rpx;
  border-radius: 12rpx;
  box-shadow: 0 8rpx 18rpx #64503f18;
}
.project-progress {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 23rpx;
  color: #9c9486;
  margin-top: 32rpx;
}
.project-progress .active {
  color: var(--olive);
  font-weight: 600;
}
.project-progress .line {
  flex: 1;
  height: 1rpx;
  background: #d9d6c9;
}
.next-story {
  background: #eeefe5;
  border-radius: 26rpx;
  padding: 30rpx;
}
.prompt {
  font-size: 46rpx;
  line-height: 1.5;
  color: var(--brown-dark);
  margin: 24rpx 0 32rpx;
}
.filters {
  display: flex;
  gap: 32rpx;
  border-bottom: 1rpx solid var(--line);
}
.filter {
  font-size: 27rpx;
  color: var(--muted);
  padding: 0 0 16rpx;
}
.filter.selected {
  color: var(--brown);
  border-bottom: 3rpx solid var(--brown);
}
.story-row {
  display: flex;
  gap: 18rpx;
  align-items: center;
  width: 100%;
  text-align: left;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.story-number {
  font-size: 39rpx;
  color: #b7a68c;
}
.story-name {
  font-size: 30rpx;
  margin-bottom: 8rpx;
}

.live-project {
  font-size: 32rpx;
  line-height: 1.7;
}
.live-project > .title {
  font-size: 50rpx;
}
.live-story-row {
  overflow-wrap: anywhere;
}
.resume-row {
  font-size: 30rpx;
}
.live-task {
  margin-top: 20rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.project-tools {
  display: flex;
  flex-wrap: wrap;
  gap: 0 24rpx;
}
.project-tools .link {
  width: auto;
  font-size: 26rpx;
}

.live-project > .title {
  overflow-wrap: anywhere;
  line-height: 1.4;
}
.live-project .project-progress {
  margin-top: 24rpx;
}
.live-project .next-story {
  border-radius: 18rpx;
  padding: 36rpx;
}
.live-project .prompt {
  font-size: 48rpx;
  margin: 22rpx 0 28rpx;
}
.live-project .resume-card {
  border: 1rpx solid var(--line);
  background: var(--surface);
  padding: 30rpx;
  border-radius: 18rpx;
}
.resume-row {
  min-width: 0;
  white-space: normal;
  overflow-wrap: anywhere;
}
.resume-row .grow {
  min-width: 0;
}
.recovery-tasks {
  border-top: 1rpx solid var(--line);
  padding-top: 32rpx;
}
.recovery-tasks .link {
  justify-content: flex-start;
  min-height: 44px;
}
.history-toggle {
  min-height: 48px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  gap: 24rpx;
  border-top: 1rpx solid var(--line);
  border-bottom: 1rpx solid var(--line);
  padding: 22rpx 0;
  font-size: 30rpx;
  color: var(--brown-dark);
}
.history-toggle text {
  font-size: 26rpx;
  color: var(--muted);
  flex-shrink: 0;
}
.live-story-row {
  white-space: normal;
}
.live-story-row .grow {
  min-width: 0;
}
.live-project .filters {
  gap: 32rpx;
  flex-wrap: wrap;
}
.live-project .filter {
  min-height: 48px;
}

.live-project { font-size: 16px; }
.live-project > .title { font-size: 28px; }
.live-project .prompt { font-size: 28px; }
.live-project .resume-row, .live-project .story-name { font-size: 16px; }
.live-project .small, .live-project .note { font-size: 14px; }
.live-project .filter { font-size: 15px; }
