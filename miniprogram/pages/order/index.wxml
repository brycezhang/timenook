<view class="s-page"><view class="s-title">项目购买</view><view class="s-error">{{paymentError}}</view><view wx:if="{{activeOrder}}" class="s-card"><view class="s-subtitle">{{activeOrder.bookTitle}}</view><view class="s-muted">{{paymentStatus}}</view><view class="s-space">{{activeOrder.state==='paid'?'已付':'金额'}} ¥{{actualPrice}}</view></view><view wx:if="{{!activeOrder && !loading}}" class="s-empty">暂时没有这次购买的记录。</view><button wx:if="{{activeOrder.project}}" class="s-button" bindtap="project">进入项目</button><view wx:if="{{activeOrder.state==='pending'}}"><button class="s-button" disabled="{{loading}}" bindtap="retryPayment">继续微信付款</button><button class="s-link" disabled="{{loading}}" bindtap="closeOrder">取消这次购买</button></view><button class="s-link" disabled="{{loading}}" bindtap="restoreOrders">查询购买结果</button><button wx:if="{{activeOrder.state==='closed'}}" class="s-button secondary" bindtap="catalog">重新购买</button><view class="s-dock"><button class="s-button secondary" bindtap="account">返回我的</button></view></view>