@import "../../styles/book.wxss";
.pdf-card { padding: 22px; border: 1px solid #ded4c6; border-radius: 22px; display: flex; flex-direction: column; gap: 18px; }
.pdf-file { display: flex; align-items: center; gap: 14px; }
.pdf-file-icon { width: 52px; height: 60px; border-radius: 12px; background: #edf0e7; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }
.pdf-file-icon image { width: 25px; height: 25px; }
.pdf-file > text { font-size: 18px; font-weight: 700; line-height: 1.5; min-width: 0; overflow-wrap: anywhere; }
.pdf-cover { min-height: 200px; border: 1px solid #ded4c6; display: flex; overflow: hidden; }
.pdf-cover-copy { width: 48%; padding: 18px 14px; display: flex; flex-direction: column; justify-content: space-between; gap: 12px; }
.pdf-cover-copy.full { width: 100%; }
.pdf-brand { font-size: 10px; color: #756859; letter-spacing: 1px; }
.pdf-cover-title { font-size: 16px; line-height: 1.5; font-weight: 700; overflow-wrap: anywhere; }
.pdf-message { font-size: 10px; line-height: 1.6; color: #756859; overflow-wrap: anywhere; }
.pdf-cover-image { width: 52%; height: 200px; }
.pdf-viewer-note { font-size: 12px; line-height: 1.7; color: #756859; text-align: center; }
