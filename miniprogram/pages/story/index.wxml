<block wx:if="{{live}}">
  <view class="page live-story">
    <view class="eyebrow">原声成稿</view>
    <view class="title story-title">{{story && story.revision ? story.revision.title : '整理这段讲述'}}</view>
    <view class="live-stage">{{stage}}</view>
    <view wx:if="{{saveWarning}}" class="live-error">{{saveWarning}}</view>
    <view wx:if="{{context}}" class="live-save">{{context.clipCount}} 段原声云端已保存</view>
    <view wx:if="{{error}}" class="live-error">{{error}}</view>
    <view wx:if="{{privateError}}" class="live-error">{{privateError}}</view>
    <view wx:if="{{liveTranscripts.length}}" class="live-transcripts">
      <view class="title section-title">已识别的内容</view>
      <view class="live-source-label">以下为语音转写，尚未整理成故事。</view>
      <view wx:for="{{liveTranscripts}}" wx:key="clipId" class="live-transcript">
        <view class="live-source-label">{{item.label}}</view>
        <text class="paragraph" selectable="{{true}}">{{item.text}}</text>
      </view>
    </view>
    <view wx:if="{{!story || !story.revision}}" class="live-controls">
      <button wx:if="{{error}}" class="btn secondary" bindtap="refresh" disabled="{{busy}}">重新尝试</button>
      <button wx:if="{{canOrganize}}" class="btn" bindtap="submitLive" disabled="{{busy}}">{{story && story.version?'重新整理故事':'整理故事'}}</button>
      <button wx:if="{{story && story.task && story.task.state==='failed' && retryable}}" class="btn" bindtap="retryLive" disabled="{{busy}}">从原素材重试</button>
      <button class="link" bindtap="recoverInterview" disabled="{{busy}}">{{pendingLocal || !context || !context.cloudSaved?'回采访页恢复保存':'回采访页继续讲'}}</button>
    </view>
    <block wx:if="{{story && story.revision}}">
      <view class="live-origin">{{story.revision.origin==='ai'?'AI 整理 · 待本人核对':'已保存的文字版本 · 待本人核对'}}</view>
      <view class="live-version">第 {{story.version}} 版</view>
      <view class="story-body">
        <view wx:for="{{liveParagraphs}}" wx:key="index" class="live-paragraph">
          <text class="paragraph">{{item.text}}</text>
          <view class="live-source-label">来源：{{item.sourceLabel}}</view>
        </view>
      </view>
      <view wx:if="{{story.revision.reviewItems.length}}" class="live-reviews">
        <view class="title section-title">请本人核对</view>
        <view wx:if="{{!story.revision.reviewItems.length}}">整理稿没有列出核对项，仍请阅读全文。</view>
        <view wx:for="{{story.revision.reviewItems}}" wx:key="index" class="live-review">{{index+1}}. {{item}}</view>
        <view wx:for="{{story.revision.reviewResolutions}}" wx:key="index" class="live-review">已处理：{{item.item}}；依据：{{item.reason}}</view>
      </view>
      <view wx:if="{{showCare && story.revision.notes && story.revision.notes.length}}" class="live-reviews section"><view>校对说明</view><view wx:for="{{story.revision.notes || []}}" wx:key="id" class="live-review">{{item.text}}</view></view>
      <view wx:if="{{showAudio && story.revision.photoSnapshot}}" class="live-reviews section"><view>本版照片清单（第 {{story.revision.photoSnapshot.revision}} 版）</view><view wx:for="{{story.revision.photoSnapshot.entries}}" wx:key="photoId" class="live-review">照片 {{index+1}}：{{item.caption || '未填写说明'}}</view></view>
      <view wx:if="{{showAudio}}" class="live-reviews section"><view>本版关联的原声顺序</view><view wx:for="{{story.revision.audioManifest || story.revision.sourceManifest}}" wx:key="clipId" class="live-review">第 {{index+1}} 段：{{item.question && item.question.snapshot ? item.question.snapshot.text : '已保存的本人原声'}}</view><view wx:if="{{story.revision.audioManifest && !story.revision.audioManifest.length}}">这版未关联原声；原始素材仍保留。</view></view>
      <view class="live-controls">
        <view wx:if="{{decisionStatus}}" class="live-stage">{{decisionStatus}}</view>
        <button class="btn" bindtap="prepareDecision" disabled="{{busy}}">本人确认或调整这版决定</button>
        <button class="link" bindtap="moreActions" disabled="{{busy}}">修改、照片与原声</button>
        <button wx:if="{{decisionReady && !canDecide}}" class="btn secondary" bindtap="participation" disabled="{{busy}}">本人在场，申请当次故事确认协助</button>
      </view>
      <view wx:if="{{decisionReady && canDecide}}" class="live-decision">
        <view wx:if="{{needsReview}}" class="section"><view>还有待核对的事项。补充说明后，才能确认这版内容和入书许可。</view><button class="btn section" bindtap="edit" disabled="{{busy}}">先核对待确认事项</button></view>
        <view>请讲述者本人阅读全文后分别选择。确认内容与允许入书是两项决定。</view>
        <view class="section">一、这版故事的内容是否确认？</view>
        <button class="btn secondary section" data-value="true" bindtap="chooseConfirmation" disabled="{{needsReview}}">{{confirmedChoice===true?'已选：':''}}确认这版内容</button>
        <button class="btn secondary section" data-value="false" bindtap="chooseConfirmation">{{confirmedChoice===false?'已选：':''}}不确认／撤回确认</button>
        <view class="section">二、是否允许这版故事入书？</view>
        <button class="btn secondary section" data-value="true" bindtap="chooseInclusion" disabled="{{needsReview}}">{{includeChoice===true?'已选：':''}}允许这版入书</button>
        <button class="btn secondary section" data-value="false" bindtap="chooseInclusion">{{includeChoice===false?'已选：':''}}暂不入书／撤回入书许可</button>
        <view class="section">本次独立说明</view><textarea class="decision-evidence" value="{{evidence}}" bindinput="decisionEvidence" maxlength="160" auto-height="{{true}}" placeholder="请记录本人本次核对和选择的说明" />
        <view class="live-source-label">{{noticeText}}</view>
        <button class="btn section" bindtap="decideLive" disabled="{{busy}}">保存本人这次的两项决定</button>
        <block wx:if="{{showCare}}"><view class="section">申请限时人工校对</view><view>请本人明确选择授权有效期和本次独立说明。运营校对后的故事仍需本人确认。</view>
        <input class="decision-evidence" value="{{careExpiry}}" data-field="careExpiry" bindinput="correctionInput" placeholder="ISO 有效期，如 YYYY-MM-DDTHH:mm:ss+08:00" maxlength="40" />
        <textarea class="decision-evidence" value="{{careEvidence}}" data-field="careEvidence" bindinput="correctionInput" auto-height="{{true}}" maxlength="160" placeholder="本人本次申请人工校对的独立说明" />
        <button class="btn secondary section" bindtap="requestCorrection" disabled="{{busy}}">按所选期限申请人工校对</button><view wx:if="{{careStatus}}" class="live-stage">{{careStatus}}</view></block>
      </view>
    </block>
    <view wx:if="{{story && story.task && (showAudio || !story.revision)}}" class="live-sources">
      <view class="title section-title">已保存的原声</view>
      <view wx:if="{{audioError}}" class="live-error">{{audioError}}</view>
      <view wx:for="{{story.task.sources}}" wx:key="clipId" class="live-source-row">第 {{index+1}} 段 · 云端已保存
        <button wx:if="{{!privateError}}" class="btn secondary section" bindtap="playLive" data-id="{{item.clipId}}" disabled="{{busy || audioBusy}}">{{playingClipId === item.clipId ? '停止回听' : '回听第 ' + (index+1) + ' 段原声'}}</button>
      </view>
    </view>
  </view>
</block>
<block wx:else="">
<view class="page story-page with-dock"
  ><view class="eyebrow">{{s.chapter}}</view
  ><view class="title story-title">{{s.title}}</view
  ><view class="row story-meta"
    ><text class="pill {{s.confirmedVersion===s.version?'':'pending'}}"
      >{{s.confirmedVersion===s.version?'已确认入书':'等待你确认'}}</text
    ><text class="small muted"
      >第{{s.version}}版 · {{s.sample?'示例整理稿':'请您核对'}}</text
    ></view
  ><button class="audio-row" bindtap="play"
    ><view class="badge-icon"
      ><image class="icon" src="/assets/icons/volume-2.svg" /></view
    ><view class="grow"
      ><view>{{playing?'暂停原声':'听听这段原声'}}</view
      ><view class="small muted"
        >{{s.recordings.length?s.recordings.length+'段原始录音':'示例暂无原声'}}</view
      ></view
    ><image class="icon" src="/assets/icons/play.svg" /></button
  ><view class="story-body"
    ><text wx:for="{{paragraphs}}" wx:key="index" class="paragraph"
      >{{item}}</text
    ></view
  ><view class="photos"
    ><image
      wx:for="{{s.photos}}"
      wx:key="*this"
      src="{{item}}"
      mode="aspectFill" /></view
  ><button class="add-photo" bindtap="photos"
    ><image class="icon" src="/assets/icons/image.svg" />
    添一张照片，让回忆更完整</button
  ><view wx:if="{{s.sample}}" class="demo-note"
    >示例故事用于体验，不对应您刚才的录音</view
  ><view class="story-actions"
    ><button class="link" bindtap="supplement"
      ><image class="icon small" src="/assets/icons/mic.svg" />
      再补充几句</button
    ><button class="link" bindtap="edit"
      ><image class="icon small" src="/assets/icons/pencil.svg" />
      修改文字</button
    ></view
  ><button class="link" bindtap="exclude"
    >{{s.included?'这篇暂不入书':'将这篇放入书中'}}</button
  ></view
><view class="dock"
  ><button
    class="btn"
    disabled="{{s.confirmedVersion===s.version && s.included}}"
    bindtap="confirm"
    >{{s.confirmedVersion===s.version&&s.included?'已确认，允许入书':'没问题，同意入书'}}</button
  ><view class="dock-note">修改文字或照片后，需要重新确认</view></view
>

</block>
