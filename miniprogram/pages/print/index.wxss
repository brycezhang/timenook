.print-product {
  align-items: flex-start;
}
.print-book {
  width: 230rpx;
  height: 284rpx;
  border-radius: 12rpx;
}
.print-product .section-title {
  font-size: 38rpx;
}
.spec-line {
  font-size: 28rpx;
  margin: 26rpx 0 10rpx;
}
.entitlement {
  padding: 26rpx 0;
  border-top: 1rpx solid var(--line);
  border-bottom: 1rpx solid var(--line);
}
.entitlement .row > text.muted {
  font-size: 25rpx;
}
.entitlement .price {
  font-size: 48rpx;
}
