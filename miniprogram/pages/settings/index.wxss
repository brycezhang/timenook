.live-settings {
  font-size: 40rpx;
  line-height: 1.7;
}
.live-title {
  box-sizing: border-box;
  width: 100%;
  min-height: 104rpx;
  padding: 22rpx;
  font-size: 40rpx;
  border: 2rpx solid #c7bb9e;
  border-radius: 12rpx;
}
.live-settings .btn {
  font-size: 40rpx;
  min-width: 96rpx;
  min-height: 96rpx;
  line-height: 1.5;
  padding: 22rpx;
  white-space: normal;
}
