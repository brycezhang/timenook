{
  "name": "timenook",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm run build:frontend && pnpm --filter @timenook/contracts build && pnpm --filter @timenook/api build && pnpm --filter @timenook/admin build && pnpm run build:website && pnpm run build:web",
    "typecheck": "pnpm run typecheck:frontend && pnpm --filter @timenook/contracts build && pnpm --filter @timenook/api typecheck && pnpm --filter @timenook/admin typecheck && pnpm run typecheck:website && pnpm run typecheck:web",
    "test": "pnpm run test:frontend && pnpm --filter @timenook/api test && pnpm run test:print && pnpm run test:release",
    "check": "pnpm run typecheck && pnpm test && pnpm run build",
    "check:native": "node scripts/check-native.mjs",
    "build:frontend": "node scripts/build.mjs && vite build --outDir dist/preview",
    "typecheck:frontend": "tsc --noEmit && tsc -p tsconfig.preview.json --noEmit",
    "test:frontend": "tsx --test --test-timeout=30000 tests/*.test.ts",
    "dev:api": "pnpm -r --filter @timenook/api... build && pnpm --filter @timenook/api start",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down",
    "db:generate": "pnpm --filter @timenook/api db:generate",
    "db:migrate": "pnpm --filter @timenook/api db:migrate",
    "api:openapi": "pnpm --filter @timenook/contracts build && pnpm --filter @timenook/api openapi",
    "test:admin-browser": "node --env-file-if-exists=.env node_modules/@playwright/test/cli.js test -c playwright.admin.config.mjs",
    "dev:admin": "pnpm --filter @timenook/admin dev",
    "admin:create": "pnpm --filter @timenook/api admin:create",
    "probe:identity": "pnpm --filter @timenook/api probe:identity",
    "probe:api": "pnpm --filter @timenook/api probe:api",
    "test:print": "node --test tests/print-probe/*.test.mjs",
    "test:release": "node --test tests/release/*.test.mjs",
    "release:candidate": "node scripts/release/package.mjs create",
    "probe:print": "node --env-file-if-exists=.env scripts/print-probe/cli.mjs",
    "setup:print-font": "node scripts/setup-print-font.mjs",
    "check:commerce": "pnpm -r --filter @timenook/api... build && node apps/api/dist/commerce/admission-cli.js",
    "dev:website": "pnpm --filter @timenook/website dev",
    "build:website": "pnpm --filter @timenook/website build",
    "typecheck:website": "pnpm --filter @timenook/website typecheck",
    "test:website": "pnpm --filter @timenook/website test",
    "package:website": "pnpm --filter @timenook/website package",
    "dev:web": "pnpm --filter @timenook/web dev",
    "build:web": "pnpm --filter @timenook/web build",
    "typecheck:web": "pnpm --filter @timenook/web typecheck",
    "test:web": "pnpm exec playwright test tests/admin/web-entry.spec.mjs tests/admin/web-session.spec.mjs tests/admin/web-product-session.spec.mjs -c playwright.admin.config.mjs"
  },
  "devDependencies": {
    "@napi-rs/canvas": "0.1.100",
    "@playwright/test": "1.58.2",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "fontkit": "2.0.4",
    "jsqr": "1.4.0",
    "libheif-js": "1.23.5",
    "lucide-static": "^0.468.0",
    "miniprogram-api-typings": "^4.0.0",
    "pdfjs-dist": "5.4.624",
    "prettier": "^3.9.10",
    "qrcode": "1.5.4",
    "sharp": "0.34.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.23.4 <23",
    "pnpm": ">=10.34.7 <11"
  }
}
