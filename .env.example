# Local disposable development services from compose.yaml only.
# Production must provide independent credentials and TLS-enabled URLs.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3417
DATABASE_URL=postgresql://timenook:local-development-only@127.0.0.1:54329/timenook?connect_timeout=2&pool_timeout=2
REDIS_URL=redis://127.0.0.1:63791
