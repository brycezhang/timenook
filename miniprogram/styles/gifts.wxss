@import "./purchase.wxss";
page { background:#fff; }
.gift-page.tn-page { min-height:0;gap:22px;padding-top:22px; }
.gift-caption { font-size:12px;line-height:1.75;color:#756859; }
.gift-page .tn-field { font-size:13px; }
.gift-page .tn-input { height:56px;min-height:56px;padding:15px; }
.gift-spacer { height:22px;flex-shrink:0; }
.gift-heading { display:flex;flex-direction:column;align-items:center;gap:20px;text-align:center; }
.gift-icon { width:82px;height:82px;border-radius:26px;background:#edf0e7;display:flex;align-items:center;justify-content:center; }
.gift-icon image { width:36px;height:36px; }
.gift-heading-copy { display:flex;flex-direction:column;gap:9px; }
.gift-heading-title { font-size:26px;line-height:1.3;letter-spacing:-.8px;font-weight:700; }
.gift-card-spacer { height:8px;flex-shrink:0; }
.gift-detail { display:flex;gap:12px;justify-content:space-between;font-size:14px;color:#756859; }
.gift-detail-value { color:#382c24;font-weight:600; }
.gift-skeleton { height:225px;border-radius:20px;background:linear-gradient(100deg,#f1f2ed 20%,#fafbf8 45%,#f1f2ed 70%);background-size:200% 100%;animation:gift-shimmer 1.4s ease-in-out infinite; }
.gift-skeleton.line { height:44px;width:75%; }
.gift-skeleton.tall { height:300px; }
@keyframes gift-shimmer { from { background-position:100% 0; } to { background-position:-100% 0; } }
