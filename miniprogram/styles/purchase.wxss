.tn-page { min-height:0; }
.purchase-caption { font-size:13px;line-height:1.7;color:#756859; }
.mini-book { width:78px;height:109px;border-left:5px solid #46563c;background:#fff;border-radius:2px 7px 7px 2px;box-shadow:7px 10px 24px #382c2420;box-sizing:border-box;padding:10px 7px;display:flex;flex-direction:column;gap:8px;flex-shrink:0;transform:rotate(-5deg);overflow:hidden; }
.mini-title { font-size:9px;font-weight:600;line-height:1.4;overflow-wrap:anywhere;max-height:26px;overflow:hidden;flex-shrink:0; }
.mini-subtitle,.mini-brand { font-size:5px;color:#756859;line-height:1.2; }
.mini-photo { width:100%;height:48px;min-height:0;flex:1;display:block;background:#e8ded0; }
.mini-book.simple { width:72px;height:102px;border-radius:2px 6px 6px 2px;box-shadow:4px 7px 18px #382c241a;gap:9px;transform:none; }
.mini-book.simple .mini-title { font-size:8px; }
.mini-book.simple .mini-photo { height:59px; }
.purchase-book-row { display:flex;gap:20px;align-items:center; }
.purchase-book-copy { display:flex;flex-direction:column;gap:9px;min-width:0; }
.purchase-book-title { font-size:19px;font-weight:600;line-height:1.5;overflow-wrap:anywhere; }
.purchase-tag { align-self:flex-start;border-radius:7px;padding:4px 8px;font-size:11px;font-weight:600;line-height:1.5;color:#46563c;background:#edf0e7; }
.purchase-book-meta { font-size:12px;color:#756859;line-height:1.75; }
.purchase-skeleton { height:150px;border-radius:20px;background:#f1f2ed; }
.purchase-skeleton.line { height:44px;width:75%; }
