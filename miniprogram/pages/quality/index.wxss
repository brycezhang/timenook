.quality-page {
  padding: 24rpx 32rpx 64rpx;
  font-size: 20px;
  line-height: 1.7;
}
.quality-page .btn {
  font-size: 20px;
  min-width: 48px;
  min-height: 48px;
  margin-top: 20rpx;
  white-space: normal;
}
.quality-page textarea {
  width: 100%;
  min-height: 220rpx;
  box-sizing: border-box;
  background: #fffaf3;
  padding: 16rpx;
  font-size: 20px;
}
.quality-page input {
  min-height: 48px;
  font-size: 20px;
  border-bottom: 2rpx solid #c8bdad;
}
.quality-page .case {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #d9d0c2;
  overflow-wrap: anywhere;
}
.quality-page .selected {
  border-left: 8rpx solid #95674b;
  padding-left: 18rpx;
}
.quality-page .note {
  font-size: 20px;
}
.quality-page .choice {
  background: #fffaf3;
}
