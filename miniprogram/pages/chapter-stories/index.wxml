<tn-navigation title="本章故事" />
<app-loading wx:if="{{pageLoading}}" variant="list" />
<block wx:else>
<view class="tn-page with-dock"><view class="tn-muted">第 {{number}} 章 · {{title}}</view><view class="chapter-subtitle">已放入本章 · {{selected.length}} 篇</view><view class="tn-muted">拖动右侧调整故事顺序</view><view class="outline-list"><sort-list modern numbered compact items="{{selected}}" action-label="移出" disabled="{{busy}}" bindaction="remove" bindreorder="reorder" /></view><view wx:if="{{!selected.length}}" class="outline-empty">从下方选择故事加入本章。</view><view class="chapter-subtitle outline-list">可以加入的故事</view><view wx:for="{{available}}" wx:key="id" class="story-option"><view class="tn-grow"><view>{{item.title}}</view><view class="story-source">{{item.source}}</view></view><button class="story-add" bindtap="add" data-id="{{item.id}}" disabled="{{busy}}">{{item.elsewhere?'移到本章':'加入本章'}}</button></view><view wx:if="{{!available.length}}" class="tn-muted outline-list">没有其他可加入的故事。</view><view class="tn-error" wx:if="{{status}}">{{status}}</view><view class="tn-dock"><button class="tn-button" bindtap="done" disabled="{{busy}}">完成</button></view></view>

</block>
