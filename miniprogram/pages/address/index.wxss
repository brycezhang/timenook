.photo-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  margin-top: 32rpx;
}
.photo-option,
.photo-none {
  border: 3rpx solid #d4cbbc;
  border-radius: 22rpx;
  padding: 20rpx;
  font-size: 34rpx;
}
.photo-option image,
.photo-loading {
  width: 100%;
  height: 280rpx;
  margin-bottom: 20rpx;
}
.chosen {
  border-color: #46563c;
  background: #e8ecdf;
}
.photo-none {
  width: 100%;
  text-align: left;
  min-height: 120rpx;
}
.address-detail {
  min-height: 180rpx;
}
