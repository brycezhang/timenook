<view class="s-page"><block wx:if="{{invitation}}"><view class="s-muted">家人邀请你一起记录</view><view class="s-title s-space">{{invitation.bookTitle}}</view><view class="s-book"><view class="s-subtitle serif">{{invitation.bookTitle}}</view><view class="s-muted s-space">时光故事</view></view><view class="s-muted">加入后，可以一起记录、编辑故事，预览并印刷这本书。</view></block><view wx:elif="{{expired}}" class="s-title">邀请已失效</view><view wx:if="{{status}}" class="s-error">{{status}}</view><view wx:if="{{busy && !invitation}}" class="s-muted">正在读取邀请…</view></view><view class="s-dock"><block wx:if="{{invitation}}"><button class="s-button" bindtap="accept" loading="{{busy}}" disabled="{{busy}}">{{loggedIn ? '接受邀请，加入项目' : '微信登录并接受邀请'}}</button><view class="s-term">接受邀请即表示同意<text bindtap="terms">《使用条款》</text></view></block><button wx:else class="s-button secondary" bindtap="home">返回首页</button></view>
