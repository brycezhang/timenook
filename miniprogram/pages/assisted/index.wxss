.assisted-page {
  font-size: 40rpx;
  overflow-wrap: anywhere;
}
.story-evidence {
  box-sizing: border-box;
  width: 100%;
  min-height: 180rpx;
  font-size: 40rpx;
  line-height: 1.7;
  border: 2rpx solid #c7bb9e;
  border-radius: 12rpx;
  padding: 22rpx;
}
.assisted-page .note,
.assisted-page .soft,
.assisted-page .section-title {
  font-size: 40rpx;
  line-height: 1.6;
}
.assisted-page button {
  min-width: 48px;
  min-height: 48px;
  height: auto;
  white-space: normal;
  line-height: 1.5;
  padding: 24rpx;
}
