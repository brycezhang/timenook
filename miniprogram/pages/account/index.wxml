<view class="s-page with-tabs"><view class="profile"><view class="avatar"><image src="/assets/icons/user.svg"/></view><view class="profile-info"><button wx:if="{{loggedIn}}" class="nickname-trigger s-subtitle" bindtap="editNickname" disabled="{{busy}}" aria-label="修改昵称"><text class="nickname-text">{{nickname}}</text><image class="nickname-edit-icon" src="/assets/icons/pencil.svg"/></button><view wx:else class="s-subtitle">欢迎来到时光故事</view><view class="s-muted">把珍贵的回忆，慢慢留下。</view></view></view>
 <block wx:if="{{!loggedIn}}"><button class="s-button s-space" bindtap="login" loading="{{busy}}" disabled="{{busy}}">微信登录</button><view class="s-term">登录即表示同意<text bindtap="terms">《使用条款》</text></view></block>
 <view class="s-space"><button wx:if="{{loggedIn}}" class="s-row" bindtap="projects"><text>我的项目</text><text class="s-arrow">›</text></button><button class="s-row" bindtap="purchase"><text>新购一本书</text><text class="s-arrow">›</text></button><button class="s-row" bindtap="terms"><text>使用条款</text><text class="s-arrow">›</text></button></view>
 <view wx:if="{{status && !editing}}" class="s-error">{{status}}</view><button wx:if="{{loggedIn}}" class="s-link s-space" bindtap="logout" disabled="{{busy}}">退出登录</button><view class="s-term s-space">时光故事 · 岁月成书</view></view>
 <view wx:if="{{!nativeTabs}}" class="tabs"><button class="tab" bindtap="home"><image class="icon" src="/assets/icons/book-open.svg"/>岁月成书</button><button class="tab active"><image class="icon" src="/assets/icons/user.svg"/>我的</button></view>

<view wx:if="{{loggedIn && editing}}" class="nickname-mask" catchtouchmove="preventMove">
 <form class="nickname-dialog" bindsubmit="saveNickname" role="dialog" aria-modal="true" aria-label="修改昵称">
  <view class="s-subtitle">修改昵称</view>
  <input class="nickname-input s-space" type="nickname" name="nickname" value="{{nickname}}" maxlength="32" placeholder="选择或填写昵称" focus="{{editing}}" disabled="{{busy}}"/>
  <view wx:if="{{status}}" class="s-error">{{status}}</view>
  <button class="s-button s-space" form-type="submit" loading="{{busy}}" disabled="{{busy}}">保存昵称</button>
  <button class="s-link" bindtap="cancelEdit" disabled="{{busy}}">取消</button>
 </form>
</view>
<quick-login visible="{{loginVisible}}" bindsuccess="loginSucceeded" bindclose="closeLogin"/>
