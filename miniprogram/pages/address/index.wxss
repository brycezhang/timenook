@import "../../styles/print.wxss";
.address-page .tn-field {
  font-size: 13px;
}
.address-page .tn-input {
  height: 56px;
  min-height: 56px;
  padding: 15px;
}
.address-region {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
}
.address-region.placeholder {
  color: #756859;
}
.address-region image {
  width: 16px;
  height: 16px;
  flex-shrink: 0;
}
