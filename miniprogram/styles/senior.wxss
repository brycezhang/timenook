page {
  --paper: #faf6ef;
  --ink: #382c24;
  --muted: #756859;
  --olive: #46563c;
  --line: #ded4c6;
  font-size: 40rpx;
}
.s-page {
  padding: 42rpx 46rpx 190rpx;
  min-height: 100vh;
}
.s-page.with-tabs {
  padding-bottom: calc(190rpx + env(safe-area-inset-bottom));
}
.s-title {
  font-family: "Songti SC", "STSong", serif;
  font-size: 60rpx;
  line-height: 1.4;
  font-weight: 600;
  margin: 0 0 30rpx;
}
.s-subtitle {
  font-size: 46rpx;
  line-height: 1.5;
  font-weight: 600;
}
.s-muted {
  color: var(--muted);
  font-size: 36rpx;
  line-height: 1.7;
}
.s-space {
  margin-top: 40rpx;
}
.s-card {
  background: #f1ece3;
  border-radius: 26rpx;
  padding: 32rpx;
  margin-bottom: 28rpx;
}
.s-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  width: 100%;
  min-height: 112rpx;
  text-align: left;
  border-bottom: 1rpx solid var(--line);
  padding: 24rpx 0;
  font-size: 40rpx;
}
.s-button {
  min-height: 116rpx;
  padding: 24rpx 32rpx;
  background: var(--olive);
  color: #fff;
  border-radius: 26rpx;
  width: 100%;
  font-size: 42rpx;
  line-height: 1.5;
  font-weight: 600;
  display: flex;
  justify-content: center;
  align-items: center;
}
.s-button.secondary {
  border: 1rpx solid #adb49f;
  color: var(--olive);
  background: transparent;
  font-weight: 400;
}
.s-link {
  color: var(--olive);
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 18rpx 0;
  font-size: 38rpx;
}
.s-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 28rpx 46rpx calc(30rpx + env(safe-area-inset-bottom));
  background: var(--paper);
  border-top: 1rpx solid var(--line);
  z-index: 4;
}
.s-field {
  margin: 32rpx 0;
  display: block;
  font-size: 40rpx;
}
.s-input {
  margin-top: 16rpx;
  width: 100%;
  min-height: 116rpx;
  border: 1rpx solid #b9af9f;
  border-radius: 22rpx;
  padding: 24rpx;
  background: #fffdf8;
  color: var(--ink);
  font-size: 42rpx;
}
.s-body {
  white-space: pre-wrap;
  font-size: 42rpx;
  line-height: 1.85;
}
.s-error {
  color: #984b39;
  font-size: 36rpx;
  margin: 24rpx 0;
  line-height: 1.7;
}
.s-empty {
  padding: 56rpx 0;
  color: var(--muted);
  line-height: 1.8;
}
.s-arrow {
  color: var(--muted);
  font-size: 48rpx;
  flex-shrink: 0;
}
.s-term {
  font-size: 30rpx;
  line-height: 1.7;
  color: var(--muted);
  margin-top: 24rpx;
  text-align: center;
}
.s-term text {
  color: var(--olive);
  text-decoration: underline;
}
.s-book {
  width: 310rpx;
  min-height: 420rpx;
  padding: 50rpx 30rpx;
  background: #eee4d4;
  box-shadow: 12rpx 14rpx 24rpx #382c2415;
  border-left: 12rpx solid #cbbda6;
  text-align: center;
  display: flex;
  flex-direction: column;
  justify-content: center;
  margin: 40rpx auto;
}
.s-book image {
  width: 100%;
  height: 280rpx;
  margin-top: 24rpx;
}
.s-cover {
  width: 100%;
  height: 520rpx;
  border-radius: 22rpx;
}
.s-grow {
  flex: 1;
  min-width: 0;
  overflow-wrap: anywhere;
}
