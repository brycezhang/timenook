.story-title {
  margin-top: 18rpx;
  font-size: 52rpx;
}
.story-meta {
  margin: 24rpx 0 32rpx;
}
.audio-row {
  display: flex;
  align-items: center;
  text-align: left;
  gap: 20rpx;
  background: #eeefe5;
  border-radius: 18rpx;
  padding: 20rpx 24rpx;
  width: 100%;
  font-size: 30rpx;
}
.audio-row .badge-icon {
  width: 68rpx;
  height: 68rpx;
  background: #e0e5d3;
}
.story-body {
  margin: 40rpx 0;
}
.paragraph {
  display: block;
  font-size: 38.5rpx;
  line-height: 1.9;
  margin-bottom: 34rpx;
  color: #3e372e;
}
.add-photo {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  font-size: 28rpx;
  border: 2rpx dashed #cec1ad;
  border-radius: 16rpx;
  min-height: 130rpx;
  color: var(--muted);
  width: 100%;
}
.story-actions {
  display: flex;
  justify-content: space-around;
  margin-top: 20rpx;
}
.photos {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 20rpx;
}
.photos image {
  width: calc(50% - 5rpx);
  height: 240rpx;
  border-radius: 12rpx;
}

.live-story {
  padding-bottom: 60rpx;
}
.live-stage,
.live-save,
.live-error,
.live-origin,
.live-reviews,
.live-review {
  font-size: 40rpx;
  line-height: 1.7;
}
.live-stage {
  margin: 28rpx 0;
}
.live-save,
.live-version,
.live-source-label {
  color: var(--muted);
  font-size: 34rpx;
  line-height: 1.6;
}
.live-error {
  margin-top: 24rpx;
  color: #8d342b;
}
.live-controls {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin: 32rpx 0;
}
.live-controls .btn {
  min-height: 96rpx;
}
.live-origin {
  padding: 22rpx;
  border-radius: 16rpx;
  background: #eeefe5;
}
.live-version {
  margin-top: 18rpx;
}
.live-story .paragraph {
  font-size: 40rpx;
  margin-bottom: 10rpx;
}
.live-paragraph {
  margin-bottom: 36rpx;
}
.live-reviews {
  padding: 26rpx;
  border: 2rpx solid #ded4c2;
  border-radius: 16rpx;
}
.live-review {
  margin-top: 24rpx;
}
.live-sources {
  margin-top: 40rpx;
}
.live-source-row {
  font-size: 38.5rpx;
  line-height: 1.7;
  margin: 20rpx 0;
}
