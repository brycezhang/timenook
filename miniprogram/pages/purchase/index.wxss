.recipients {
  display: flex;
  gap: 20rpx;
}
.recipient {
  flex: 1;
  display: flex;
  align-items: center;
  flex-direction: column;
  gap: 14rpx;
  padding: 28rpx 10rpx;
  border: 2rpx solid var(--line);
  border-radius: 22rpx;
  background: var(--surface);
}
.recipient.selected {
  border-color: var(--terracotta);
  background: #f6eae0;
}
.recipient .icon {
  width: 64rpx;
  height: 64rpx;
}
.recipient .small {
  font-size: 22rpx;
}
.purchase-book {
  width: 190rpx;
  height: 230rpx;
  border-radius: 12rpx;
}
.pay-btn {
  width: 390rpx;
}

.live-recipients {
  flex-wrap: wrap;
}
.live-recipients .recipient {
  flex: 0 1 calc(50% - 12rpx);
  padding: 26rpx 14rpx;
}
.custom-label {
  background: var(--surface);
  border: 2rpx solid var(--line);
  border-radius: 14rpx;
  padding: 22rpx;
  min-height: 48rpx;
  font-size: 28rpx;
}
.catalog-term {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.term-label {
  font-weight: 600;
  margin-bottom: 10rpx;
}
.live-pay {
  width: 310rpx;
}
.live-pay[disabled] {
  color: #624b3d;
  background: #e7d6c9;
  opacity: 1;
}
