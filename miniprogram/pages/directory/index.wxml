<tn-navigation title="大纲目录" />
<app-loading wx:if="{{pageLoading}}" variant="list" />
<view wx:else class="tn-page with-dock directory-page">
  <view class="tn-muted">拖动右侧调整章节顺序</view>
  <view class="outline-between"><text class="tn-muted">{{rows.length}} 章 · {{storyCount}} 篇故事</text><button class="tn-link" bindtap="add" disabled="{{busy}}">＋ 新增章节</button></view>
  <button wx:if="{{unassigned}}" class="unassigned-card" bindtap="unassigned"><text>{{unassigned}} 篇故事未归章</text><text>›</text></button>
  <sort-list id="chapters" items="{{rows}}" numbered modern disabled="{{busy}}" bindopen="open" bindreorder="reorder" />
  <view wx:if="{{!rows.length}}" class="outline-empty">暂无章节，可添加自己的章节</view>
  <view wx:if="{{status}}" class="tn-error">{{status}}</view>
  <view class="tn-dock"><button class="tn-button" bindtap="book"><image class="tn-icon" src="/assets/icons/book-open-light.svg" />查看书稿</button><button class="tn-link" bindtap="free" disabled="{{busy}}"><image class="outline-small-icon" src="/assets/icons/mic.svg" />自由讲述</button></view>
</view>
