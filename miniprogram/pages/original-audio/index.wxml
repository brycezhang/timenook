<tn-navigation title="书中原声" />
<app-loading wx:if="{{busy && !entry}}" variant="story" />
<view wx:else class="tn-page original-audio-page">
  <block wx:if="{{entry}}">
    <view class="audio-intro"><view class="audio-title">{{entry.story.title}}</view><view class="audio-version">纸书原声 · 故事第 {{entry.story.version}} 版</view></view>
    <image wx:if="{{image}}" class="audio-photo" src="{{image}}" mode="aspectFill" aria-label="{{entry.photo.caption || '故事照片'}}" /><view wx:elif="{{photoLoading}}" class="audio-photo"><app-loading variant="photo" /></view>
    <view wx:if="{{photoError}}" class="tn-muted">{{photoError}}</view>
    <view wx:for="{{clips}}" wx:key="clipId" class="audio-clip">
      <view wx:if="{{clips.length > 1}}" class="audio-version">第 {{index + 1}} 段原声</view>
      <view class="voice-player">
        <button wx:if="{{playingClipId === item.clipId}}" class="audio-play" bindtap="toggle" disabled="{{busy}}" aria-label="{{paused ? '继续播放' : '暂停播放'}}"><image src="/assets/icons/{{paused ? 'play-light' : 'pause-light'}}.svg" /></button>
        <button wx:else class="audio-play" bindtap="play" data-id="{{item.clipId}}" disabled="{{busy}}" aria-label="播放原声"><app-loading wx:if="{{loadingClipId === item.clipId}}" variant="spinner" light /><image wx:else src="/assets/icons/play-light.svg" /></button>
        <view class="audio-timeline"><slider class="audio-slider" min="0" max="{{playingClipId === item.clipId ? duration : item.durationSeconds || 1}}" step="0.1" value="{{playingClipId === item.clipId ? position : 0}}" disabled="{{busy || playingClipId !== item.clipId || !duration}}" bindchanging="dragging" bindchange="seek" activeColor="#46563C" backgroundColor="#ADB49F" block-color="#46563C" block-size="20" aria-label="原声播放进度" /><view class="audio-times"><text>{{playingClipId === item.clipId ? positionLabel : '00:00'}}</text><text>{{playingClipId === item.clipId ? durationLabel : item.durationLabel}}</text></view></view>
      </view>
    </view>
    <view class="audio-note">对应所印版本原声，仅项目成员可回听。</view>
  </block>
  <view wx:else class="tn-card audio-locked"><view class="tn-heading">登录后回听原声</view><view class="tn-muted">请使用已加入这本书的账号。</view><button wx:if="{{!loggedIn}}" class="tn-button" bindtap="login" disabled="{{busy}}">微信登录后回听</button></view>
  <view wx:if="{{status}}" class="tn-error" role="status">{{status}}</view>
  <button wx:if="{{loggedIn && !entry}}" class="tn-button tn-secondary" bindtap="refresh" disabled="{{busy}}" loading="{{busy}}">重新查询</button>
  <button wx:if="{{loggedIn}}" class="tn-link audio-logout" bindtap="logout" disabled="{{busy}}">退出登录</button>
</view>
<quick-login id="quick-login" visible="{{loginVisible}}" bindsuccess="loginSucceeded" bindclose="closeLogin"/>
