<tn-navigation title="选择封面照片" />
<app-loading wx:if="{{pageLoading}}" variant="list" />
<view wx:else class="tn-page with-dock photo-picker">
  <button class="photo-none {{!selected ? 'chosen' : ''}}" data-id="" bindtap="choose"><text>不用照片</text><image wx:if="{{!selected}}" class="tn-icon" src="/assets/icons/check.svg" /></button>
  <view wx:if="{{!rows.length && !busy}}" class="tn-muted">暂时没有项目照片。</view>
  <view class="photo-grid"><button wx:for="{{rows}}" wx:key="id" class="photo-option {{selected === item.id ? 'chosen' : ''}}" data-id="{{item.id}}" bindtap="choose" aria-label="{{selected === item.id ? '已选照片' : '选择照片'}}"><image wx:if="{{item.image}}" class="photo-image" src="{{item.image}}" mode="aspectFill" /><view wx:else class="photo-loading"><app-loading variant="photo" /></view><view wx:if="{{selected === item.id}}" class="photo-check"><image src="/assets/icons/check-light.svg" /></view></button></view>
  <view wx:if="{{status}}" class="tn-error">{{status}}</view>
  <view class="tn-dock"><button class="tn-button" bindtap="save" loading="{{busy}}" disabled="{{busy}}">使用这张照片</button></view>
</view>
