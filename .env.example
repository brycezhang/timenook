# Local disposable development services from compose.yaml only.
# Production must provide independent credentials and TLS-enabled URLs.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3417
DATABASE_URL=postgresql://timenook:local-development-only@127.0.0.1:54329/timenook?connect_timeout=2&pool_timeout=2
REDIS_URL=redis://127.0.0.1:63791

# TimeNook's own mini-program only. Supply both via a Git-ignored mode-600 file.
# Empty in development: login returns 503. Production refuses missing values.
TIMENOOK_WECHAT_APP_ID=
TIMENOOK_WECHAT_APP_SECRET=
SESSION_TTL_SECONDS=604800

# Ordinary merchant APIv3. Keep every field blank to disable payments.
# Enable only after the independent AppID/Secret and actual merchant binding exist.
# Paths are absolute server files, read-only to the service (e.g. root:timenook 640).
# Merchant certificate is checked against its private key; serial derives from X509.
# Platform file is an X509 PEM for certificate serial IDs, or an SPKI PEM for PUB_KEY_ID_.
# Wiring credentials does not authorize sales or turn local previews into real orders.
TIMENOOK_WECHAT_PAY_MODE=
TIMENOOK_WECHAT_PAY_MERCHANT_ID=
TIMENOOK_WECHAT_PAY_API_V3_KEY=
TIMENOOK_WECHAT_PAY_MERCHANT_PRIVATE_KEY_PATH=
TIMENOOK_WECHAT_PAY_MERCHANT_CERT_PATH=
TIMENOOK_WECHAT_PAY_PLATFORM_KEY_ID=
TIMENOOK_WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH=
# When enabled: https://timenookapi.threeminreading.com/api/v1/webhooks/wechat-pay/payments
TIMENOOK_WECHAT_PAY_NOTIFY_URL=

# Build-time public API base, including /v1. Empty disables real login.
# Local: http://127.0.0.1:3417/v1
# Public API: https://timenookapi.threeminreading.com/api/v1
TIMENOOK_API_BASE_URL=

# Independent admin authentication. Leave both blank to disable local login.
# Production requires HTTPS origin (no path) + a random 32-byte base64 key.
# Target admin origin: https://timenookapi.threeminreading.com (see ADR 0015).
ADMIN_ORIGIN=
ADMIN_SESSION_KEY=
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_CHALLENGE_TTL_SECONDS=300
# Feishu login; reuse wutong app credentials, keep TimeNook authority independent.
# Server only; add the TimeNook callback alongside the existing wutong callback.
ADMIN_FEISHU_APP_ID=
ADMIN_FEISHU_APP_SECRET=
ADMIN_FEISHU_TENANT_KEY=
REDIS_KEY_PREFIX=timenook

# Vben development only: put local HTTPS cert/key paths in .env.admin-local.
# Build does not read these paths. Never prefix secrets with VITE_.
ADMIN_TLS_CERT=
ADMIN_TLS_KEY=
