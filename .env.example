# Local disposable development services from compose.yaml only.
# Production must provide independent credentials and TLS-enabled URLs.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3417
DATABASE_URL=postgresql://timenook:local-development-only@127.0.0.1:54329/timenook?connect_timeout=2&pool_timeout=2
REDIS_URL=redis://127.0.0.1:63791

# TimeNook's own mini-program only. Supply both via a Git-ignored mode-600 file.
# Empty in development: login returns 503. Production refuses missing values.
TIMENOOK_WECHAT_APP_ID=
TIMENOOK_WECHAT_APP_SECRET=
SESSION_TTL_SECONDS=604800

# Build-time public API base, including /v1. Empty disables real login.
# Local: http://127.0.0.1:3417/v1
# Deployment target (not yet deployed): https://lawyerapi.threeminreading.com/timenook/v1
TIMENOOK_API_BASE_URL=
