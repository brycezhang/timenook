<tn-navigation title="{{overview ? '故事书首页' : '首页'}}" brand="{{true}}"/>
<view wx:if="{{overview}}" class="s-page with-tabs">
 <view class="project-heading"><text class="s-muted">当前项目</text><button class="s-link" bindtap="switchProject">切换项目 ⇄</button></view>
 <view class="s-title">{{overview.bookTitle}}</view>
 <view class="s-book"><text class="s-subtitle serif">{{overview.bookTitle}}</text><text class="s-muted s-space">时光故事 · 岁月成书</text></view>
 <button wx:if="{{overview.canInvite}}" class="s-link" bindtap="invite">邀请一起记录</button>
 <view class="s-card s-space"><view class="s-subtitle">{{overview.canRecord ? '今天，想聊些什么？' : '故事仍然为你保留'}}</view><view class="s-muted s-space">{{overview.canRecord ? '从一段难忘的往事开始。' : '当前项目暂不能新增或制作，可切换其他项目继续记录。已有资料仍可查看。'}}</view><button wx:if="{{overview.canRecord}}" class="s-button s-space" bindtap="record">开始讲述</button></view>
 <button class="s-row" bindtap="stories"><text>已记录的故事 · {{overview.stories.length}}</text><text class="s-arrow">›</text></button>
 <button class="s-row book-entry" bindtap="book"><text>我的书 · 预览与印刷</text><text class="s-arrow">›</text></button>
 <view wx:if="{{status}}" class="s-error">{{status}}<button class="s-link" bindtap="refresh">重新读取</button></view>
</view>
<app-loading wx:elif="{{pageLoading || busy}}" variant="project" />
<view wx:elif="{{status}}" class="s-page"><view class="s-error">{{status}}</view><button class="s-button" bindtap="refresh">重新打开</button></view>
<view wx:else class="tn-page landing">
 <view class="landing-intro"><text class="tn-eyebrow">时光故事书</text><button class="tn-link sample-trigger" bindtap="sample">看看样书<image class="sample-arrow" src="/assets/icons/modern-arrow-right.svg"/></button></view>
 <view class="landing-headline"><view>送给重要的人</view><view>一本专属时光故事书</view></view>
 <view class="tn-muted landing-sub">把散落的时光，变成一本温暖的书</view>
 <view class="landing-photo"><image src="/assets/storybook-example.jpg" mode="aspectFill"/><text>书籍效果示例</text></view>
 <view class="landing-benefits">
  <view><image src="/assets/icons/modern-mic.svg"/><view class="landing-benefit-title">只需要说<view>不需要写</view></view><text>自动整理成文</text></view>
  <view><image src="/assets/icons/modern-image.svg"/><view class="landing-benefit-title">照片与原声<view>一起珍藏</view></view><text>原声随时回听</text></view>
  <view><image src="/assets/icons/modern-book.svg"/><view class="landing-benefit-title">把时光故事<view>做成实体书</view></view><text>留给最爱的人</text></view>
 </view>
</view>
<view wx:if="{{!overview && !pageLoading && !busy && !status}}" class="tn-dock above-tabs landing-dock tn-surface"><view class="landing-price"><text>时光故事 · 含首本实体书</text><text class="landing-amount">¥999</text></view><button class="tn-button gift-trigger" bindtap="purchase"><image class="tn-icon" src="/assets/icons/gift-white.svg"/>送出一份礼物</button></view>
<view wx:if="{{!nativeTabs}}" class="tabs"><button class="tab active"><image class="icon" src="/assets/icons/modern-book.svg"/>时光故事</button><button class="tab" bindtap="account"><image class="icon" src="/assets/icons/modern-user.svg"/>我的</button></view>

<quick-login id="quick-login" visible="{{loginVisible}}" bindsuccess="loginSucceeded" bindclose="closeLogin"/>
