page { background:#fff; }
.recording-page { min-height:calc(100vh - 88px); }
.recording-page.with-dock { padding-bottom:calc(144px + env(safe-area-inset-bottom)); }
.question-source { letter-spacing:1.3px; overflow-wrap:anywhere; }
.record-question { font-size:28px; line-height:1.3; letter-spacing:-.8px; font-weight:700; overflow-wrap:anywhere; }
.recording .record-question,.paused .record-question { font-size:25px; }
.photo-section { display:flex; flex-direction:column; gap:10px; }
.photo-heading { display:flex; align-items:center; justify-content:space-between; gap:12px; color:#756859; font-size:13px; }
.photo-heading .tn-link { flex-shrink:0; padding:10px 0 10px 12px; }
.recording-photos,.record-photo { width:100%; height:190px; }
.recording .recording-photos,.paused .recording-photos,.recording .record-photo,.paused .record-photo { height:154px; }
.record-photo { overflow:hidden; border-radius:18px; position:relative; background:#edf0e7; }
.photo-image { width:100%; height:100%; }
.photo-placeholder { height:100%; display:flex; align-items:center; justify-content:center; font-size:14px; color:#756859; }
.remove-photo { position:absolute; top:8px; right:8px; border:1px solid #ded4c6; }
.add-photo { width:100%; min-height:88px; border:1px dashed #ded4c6; border-radius:18px; background:#fff; color:#46563c; display:flex; align-items:center; justify-content:center; gap:10px; padding:18px; font-size:15px; font-weight:600; }
.photo-error { display:flex; align-items:center; justify-content:space-between; gap:10px; }
.change-question { background:#fff; color:#382c24; border:1px solid #ded4c6; }
.record-hint { font-size:12px; line-height:1.75; color:#756859; }
.record-stage { flex:1;justify-content:center;min-height:190px;display:flex; flex-direction:column; gap:16px; align-items:center; padding:12px 0; }
.wave { height:64px; width:100%; display:flex; align-items:center; justify-content:center; gap:3px; overflow:hidden; }
.wave-bar { width:3px; flex-shrink:0; border-radius:4px; background:#46563c; }
.wave-paused { opacity:.45; }
.record-time { font-size:46px; font-weight:500; line-height:1.3; letter-spacing:-1.5px; font-variant-numeric:tabular-nums; }
.record-state { font-size:13px; color:#756859; }
.start-recording { width:100%; min-height:76px; padding:0; border:0; border-radius:18px; background:#fff; color:#382c24; display:flex; align-items:center; gap:16px; text-align:left; font-size:20px; font-weight:600; }
.start-recording[disabled] { opacity:.6; }
.microphone { width:76px; height:76px; border-radius:50%; background:#46563c; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
.microphone image { width:32px; height:32px; }
.record-actions { display:flex; gap:12px; }
.record-actions .tn-button { flex:1; min-width:0; padding:13px 10px; }
.dock-hint { text-align:center; }
.state-heading { display:flex; flex-direction:column; align-items:center; gap:20px; text-align:center; margin:22px 0 8px; }
.state-icon { width:82px; height:82px; border-radius:26px; background:#edf0e7; display:flex; align-items:center; justify-content:center; }
.state-icon image { width:36px; height:36px; }
.state-copy { display:flex; flex-direction:column; gap:9px; }
.state-title { font-size:26px; line-height:1.3; letter-spacing:-.8px; font-weight:700; }
.saved-heading { display:flex; justify-content:space-between; font-size:14px; }
.saved-heading text:first-child { font-weight:600; }
.compact-wave { height:32px; }
.compact-wave .wave-bar { background:#899775; }
.upload-track { height:6px; border-radius:10px; background:#f1e9de; overflow:hidden; }
.upload-progress { height:100%; border-radius:10px; background:#46563c; }
.upload-indeterminate { width:28%; animation:saving 1.3s ease-in-out infinite alternate; }
@keyframes saving { from { transform:translateX(0); } to { transform:translateX(255%); } }
@media (prefers-reduced-motion:reduce) { .upload-indeterminate { animation:none; } }
@media (max-width:350px) { .record-actions .tn-button { font-size:15px; gap:6px; } }

@media (max-height:740px) {
 .recording-photos,.record-photo,.recording .recording-photos,.paused .recording-photos,.recording .record-photo,.paused .record-photo { width:120px;height:90px; }
 .record-stage { height:150px;min-height:150px;flex:0 0 150px;gap:10px; }
 .recording .record-stage { height:66px;min-height:66px;flex-basis:66px;padding:0;gap:4px;justify-content:flex-start; }
 .recording .wave { height:20px;flex-shrink:0; }
 .recording .record-time { font-size:38px;line-height:1.1; }
 .recording .record-state { display:none; }
}
