{
  "name": "@timenook/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "test": "tsc -p tsconfig.test.json && node --env-file-if-exists=../../.env --test dist-test/test/*.test.js",
    "db:generate": "prisma generate",
    "db:migrate": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate deploy",
    "openapi": "pnpm build && node --env-file-if-exists=../../.env dist/openapi.js",
    "admin:create": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.admin-local dist/admin/admin-cli.js create",
    "probe:identity": "node --env-file-if-exists=../../.env --env-file=../../.env.probe-local dist/probe/probe-cli.js",
    "probe:api": "node --env-file-if-exists=../../.env --env-file=../../.env.probe-local dist/main.js",
    "start:worker": "node --env-file-if-exists=../../.env dist/tasks/worker-main.js"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/multipart": "9.4.0",
    "@fastify/static": "10.1.3",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-fastify": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@prisma/client": "6.19.3",
    "@timenook/contracts": "workspace:*",
    "ali-oss": "6.23.0",
    "bullmq": "5.81.5",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "fastify": "5.11.3",
    "ioredis": "5.11.1",
    "otplib": "13.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/ali-oss": "6.23.3",
    "@types/node": "22.19.15",
    "nock": "14.0.10",
    "prisma": "6.19.3",
    "typescript": "5.9.3"
  }
}
