.quick-login-mask { position: fixed; inset: 0; z-index: 20000; background: #382c2459; display: flex; align-items: flex-end; justify-content: center; }
.quick-login-sheet { width: 100%; max-width: 600px; padding: 22px 22px calc(22px + env(safe-area-inset-bottom)); border-radius: 26px 26px 0 0; display: flex; flex-direction: column; gap: 18px; }
.quick-login-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.quick-login-close { font-size: 28px; font-weight: 400; }
.quick-login-agreement { display: flex; gap: 2px; align-items: center; min-height: 44px; }
.quick-login-check { flex-shrink: 0; width: 44px; height: 44px; margin-right: -14px; display: flex; align-items: center; justify-content: flex-start; }
.quick-login-box { width: 20px; height: 20px; line-height: 18px; text-align: center; border: 1px solid #756859; border-radius: 4px; font-size: 14px; }
.quick-login-box.checked { background: #46563c; color: white; border-color: #46563c; }
.quick-login-terms { flex: 1; min-width: 0; font-size: 13px; line-height: 1.8; }
.quick-login-terms button, .quick-consent-terms { display: inline; white-space: normal; background: transparent; color: #46563c; font-size: 13px; line-height: 1.8; text-align: left; padding: 10px 0; }
