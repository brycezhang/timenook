<app-loading wx:if="{{mode === 'live' && loading && !packageVersionId}}" variant="book" />
<block wx:else>
<view class="s-page"><view class="s-title">{{bookTitle}}</view><view class="s-book"><view class="s-subtitle serif">{{bookTitle}}</view><view class="s-muted s-space">岁月成书</view></view><view class="s-subtitle">故事记录与整理</view><view class="s-muted">含首本纸质书 1 本</view><view class="s-row"><text>合计</text><text>¥{{packagePrice || '999.00'}}</text></view><view class="s-space"><view class="s-muted" wx:for="{{packageTerms}}" wx:key="label">{{item.label}}：{{item.text}}</view></view><button class="s-link" bindtap="privacy">使用条款与客服</button><view wx:if="{{!purchasable && !loading}}" class="s-muted">套餐暂未开放购买，请稍后再来。</view><view wx:if="{{catalogError || verificationError}}" class="s-error">{{catalogError || verificationError}}</view><button wx:if="{{catalogError}}" class="s-link" bindtap="onShow">重新查询</button><button wx:if="{{restoredOrder}}" class="s-link" bindtap="orders">查看这次购买的结果</button></view><view class="s-dock"><block wx:if="{{!loggedIn}}"><button class="s-button" bindtap="login">微信登录</button><view class="s-term">登录即表示同意<text bindtap="privacy">《使用条款》</text></view></block><button wx:else class="s-button" bindtap="pay" loading="{{verificationBusy}}" disabled="{{verificationBusy || loading || (!hasOrderIntent && !purchasable)}}">{{hasOrderIntent ? '查询购买结果' : '购买，开始记录'}}</button></view>

</block>
