.stories-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 25px;
}
.story-card {
  width: 100%;
  padding: 0;
  border: 1px solid #ded4c6;
  border-radius: 22px;
  background: #fff;
  overflow: hidden;
  text-align: left;
  color: #382c24;
}
.story-card-photo {
  display: block;
  width: 100%;
  height: 160px;
}
.story-card-copy {
  padding: 18px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.story-card-meta {
  font-size: 11px;
  color: #756859;
  font-weight: 400;
}
.story-card-title {
  font-size: 21px;
  line-height: 1.5;
  font-weight: 700;
  overflow-wrap: anywhere;
}
.story-card-excerpt {
  font-size: 14px;
  line-height: 1.7;
  color: #756859;
  font-weight: 400;
}
.story-card-audio {
  display: flex;
  gap: 7px;
  align-items: center;
  color: #46563c;
  font-size: 12px;
  font-weight: 400;
}
.story-card-audio image {
  width: 15px;
  height: 15px;
}
.stories-empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20px;
  padding-top: 22px;
}
.stories-empty-icon {
  width: 82px;
  height: 82px;
  background: #edf0e7;
  border-radius: 26px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.stories-empty-icon image {
  width: 36px;
  height: 36px;
}
.stories-empty-heading {
  font-size: 26px;
  line-height: 1.3;
  font-weight: 700;
}
.unassigned-intro {
  font-size: 13px;
}
.unassigned-card {
  padding: 18px;
  border: 1px solid #ded4c6;
  border-radius: 18px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}
.unassigned-title {
  padding: 0;
  width: 100%;
  min-height: 44px;
  text-align: left;
  font-size: 18px;
  line-height: 1.5;
  font-weight: 600;
  color: #382c24;
  overflow-wrap: anywhere;
}
.unassigned-actions {
  display: flex;
  gap: 10px;
  align-items: center;
  flex-wrap: wrap;
}
.unassigned-actions .tn-button {
  width: auto;
  padding-inline: 16px;
}
.stories-empty {
  padding: 36px 16px;
  border: 1px dashed #ded4c6;
  border-radius: 18px;
  text-align: center;
  color: #756859;
  font-size: 14px;
}
.excluded-heading {
  font-size: 18px;
  font-weight: 600;
}
.excluded-row {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 16px;
  border: 1px solid #ded4c6;
  border-radius: 16px;
}
.excluded-title {
  padding: 0;
  min-height: 44px;
  text-align: left;
  font-size: 15px;
  line-height: 1.6;
  font-weight: 600;
  color: #382c24;
}
.excluded-row .tn-link {
  flex-shrink: 0;
}
