<block wx:if="{{live}}">
  <view class="page live-first-copy">
    <view class="title">确认书稿与首本制作</view>
    <view class="note section">隔离合成验证，尚未开放正式生产。请双方分别核对同一版完整 PDF；付款不能代替讲述者本人确认。</view>
    <view wx:if="{{status}}" class="soft section" role="alert">{{status}}</view>
    <view wx:if="{{busy}}" class="note section" role="status">正在查询或保存，请稍候…</view>
    <block wx:if="{{context}}">
      <view class="paper section">
        <view class="section-title">首本实体书</view>
        <view class="section">已付 ¥999 · 制作 {{context.payment.copies}} 本</view>
        <view class="section">本次无需支付 · ¥0</view>
        <view class="note">以上付款与配送信息来自本项目购买时的销售快照；当前仅为合成测试。</view>
        <view wx:for="{{context.shipping.terms}}" wx:key="index" class="section"><view>{{item.label}}</view><view class="note">{{item.text}}</view></view>
        <view wx:if="{{context.creation.expiresAt}}" class="note section">约定制作截止时间：{{context.creation.expiresAt}}</view>
      </view>
      <view wx:if="{{context.book}}" class="paper section">
        <view class="section-title">{{context.book.snapshot.cover.title}}</view>
        <view class="section">书稿第 {{context.book.version}} 版 · {{context.book.pageCount || '待核对'}} 页</view>
        <button class="btn section" bindtap="review" disabled="{{busy || context.book.state !== 'ready'}}">查看本版完整 PDF</button>
        <view class="note">请从完整书稿页打开 PDF，逐页核对全文、照片、原声入口及页数，再作本次确认。</view>
      </view>
      <view class="paper section">
        <view class="section-title">双方确认</view>
        <view class="section">讲述者内容：{{context.confirmations.narrator ? '已确认本版' : '待本人确认本版'}}</view>
        <view class="section">发起人 PDF 与地址：{{context.confirmations.initiator && !addressDirty ? '已确认当前版本与地址' : '待确认当前版本与地址'}}</view>
        <view class="note">更改书稿须重新确认；更改地址须由发起人重新确认，讲述者的同版内容确认保留。</view>
      </view>
      <view wx:if="{{canConfirmNarrator && !context.production}}" class="paper section narrator-confirmation">
        <view class="section-title">由讲述者本人选择</view>
        <button class="check-row section" data-role="narrator" bindtap="chooseConfirmation" disabled="{{busy || versionMismatch || !context.book || context.book.state !== 'ready'}}"><view class="check-box {{narratorChecked ? 'on' : ''}}"><image class="icon" src="/assets/icons/check-light.svg" /></view><text>我已逐页核对本版完整 PDF，确认内容</text></button>
        <textarea class="first-copy-evidence section" value="{{narratorEvidence}}" data-role="narrator" bindinput="evidenceInput" maxlength="160" auto-height="{{true}}" placeholder="记录本人核对本版内容的独立说明" />
        <button class="btn section" bindtap="confirmNarrator" disabled="{{busy || !narratorChecked || !narratorEvidence || versionMismatch || !context.book || context.book.state !== 'ready'}}">保存本人内容确认</button>
      </view>
      <button wx:if="{{context.role === 'initiator' && !canConfirmNarrator && !context.production}}" class="btn secondary section" bindtap="assist" disabled="{{busy || !context.book || versionMismatch}}">本人在场，开始当次书稿确认协助</button>
      <view wx:if="{{context.role === 'initiator' && !context.production}}" class="paper section">
        <view class="section-title">收货信息</view>
        <view class="field"><text class="label">收件人</text><input value="{{name}}" data-field="name" bindinput="input" maxlength="30" placeholder="填写收件人姓名" disabled="{{busy}}" /></view>
        <view class="field"><text class="label">手机号</text><input value="{{phone}}" data-field="phone" bindinput="input" maxlength="11" type="number" placeholder="填写11位手机号" disabled="{{busy}}" /></view>
        <view class="field"><text class="label">配送地区</text><button wx:for="{{regionOptions}}" wx:key="index" class="btn secondary region-option section" data-index="{{index}}" bindtap="chooseRegion" disabled="{{busy}}">{{item.selected ? '已选配送地区：' : '选择配送地区：'}}{{item.label}}</button></view>
        <view class="field"><text class="label">完整地址</text><textarea value="{{detail}}" data-field="detail" bindinput="input" maxlength="200" auto-height="{{true}}" placeholder="省、市、区、街道及门牌号" disabled="{{busy}}" /></view>
        <view wx:if="{{addressDirty}}" class="note section">地址已修改，尚未保存；当前不能确认或提交制作。</view>
        <button class="btn section" bindtap="saveAddress" disabled="{{busy || !addressDirty}}">保存收货地址</button>
        <button class="check-row section" data-role="initiator" bindtap="chooseConfirmation" disabled="{{busy || addressDirty || versionMismatch || !context.address.hash || !context.book || context.book.state !== 'ready'}}"><view class="check-box {{initiatorChecked ? 'on' : ''}}"><image class="icon" src="/assets/icons/check-light.svg" /></view><text>我已逐页核对本版完整 PDF 和当前收货地址</text></button>
        <textarea class="first-copy-evidence section" value="{{initiatorEvidence}}" data-role="initiator" bindinput="evidenceInput" maxlength="160" auto-height="{{true}}" placeholder="记录发起人核对本版与地址的独立说明" />
        <button class="btn section" bindtap="confirmInitiator" disabled="{{busy || addressDirty || versionMismatch || !initiatorChecked || !initiatorEvidence || !context.address.hash || !context.book || context.book.state !== 'ready'}}">保存排版与地址确认</button>
      </view>
      <view wx:if="{{blockerLabels.length && !context.production}}" class="soft section"><view wx:for="{{blockerLabels}}" wx:key="index" class="note section">{{item}}</view></view>
      <button wx:if="{{context.role === 'initiator' && !context.production}}" class="btn section" bindtap="submit" disabled="{{busy || !canSubmit || addressDirty || versionMismatch}}">使用首本权益提交制作</button>
      <button wx:if="{{context.expiryReview.available}}" class="btn secondary section" bindtap="requestExpiryReview" disabled="{{busy}}">申请制作期限人工审核</button>
      <view wx:if="{{context.expiryReview.caseId}}" class="soft section">制作期限人工审核工单已记录，等待核验。工单不能替代书稿确认，也不会自动放行制作或删除资料。</view>
      <view wx:if="{{context.production}}" class="paper section"><view class="section-title">首本制作已预留</view><view class="section">{{context.production.state === 'approved' ? '已审核' : '等待审核'}} · 制作 {{context.production.copies}} 本 · 本次无需支付</view><view class="note">生产单：{{context.production.id}}</view><view class="note section">审核后按约定安排制作与寄送。</view></view>
    </block>
    <button wx:if="{{context && context.production}}" class="btn section" bindtap="production" disabled="{{busy}}">查看生产与物流</button>
    <button class="btn secondary section" bindtap="refresh" disabled="{{busy}}">重新查询确认与制作状态</button>
    <button class="btn secondary section" bindtap="book" disabled="{{busy}}">返回成书总览</button>
  </view>
</block>
<block wx:else="">
<view class="page with-dock"
  ><view class="row print-product"
    ><image class="print-book" src="{{bookImage}}" mode="aspectFill" /><view
      class="grow"
      ><view class="serif section-title">{{p.title}}</view
      ><view class="subtitle">爱与岁月的故事</view
      ><view class="spec-line">专属故事书 · 1本</view
      ><view class="small muted">书稿第{{p.revision}}版</view
      ><view class="small muted">装帧与页数以最终打样为准</view></view
    ></view
  ><view class="entitlement section"
    ><view class="row between"
      ><view class="section-title">首本实体书</view
      ><view class="pill">已含在套餐中</view></view
    ><view class="row between" style="margin-top: 22rpx"
      ><text class="muted">套餐 ¥999 · 本次无需再次支付</text
      ><text class="price">¥0</text></view
    ><view class="small muted">当前为本机演示权益，尚未实际付款</view></view
  ><view class="paper section"
    ><view class="row section-title"
      ><image class="icon" src="/assets/icons/map-pin.svg" /> 收货信息</view
    ><view class="field"
      ><text class="label">收件人</text
      ><input
        placeholder="填写收件人姓名"
        value="{{name}}"
        data-field="name"
        bindinput="input"
        maxlength="30" /></view
    ><view class="field"
      ><text class="label">手机号</text
      ><input
        type="number"
        placeholder="填写11位手机号"
        value="{{phone}}"
        data-field="phone"
        bindinput="input"
        maxlength="11" /></view
    ><view class="field"
      ><text class="label">完整地址</text
      ><textarea
        placeholder="省、市、区、街道及门牌号"
        value="{{detail}}"
        data-field="detail"
        bindinput="input"
        maxlength="200"
      /></view></view
  ><view class="soft section"
    ><view class="row"
      ><image class="icon" src="/assets/icons/clipboard-check.svg" /><view
        class="grow"
        ><view>书稿确认</view
        ><view class="small muted"
          >{{ready?'本人内容与子女校对均已确认':'请先阅读并确认完整书稿'}}</view
        ></view
      ></view
    ><button class="link" bindtap="review"
      >{{ready?'查看已确认的书稿':'去确认完整书稿'}}
      <image
        class="icon small"
        src="/assets/icons/chevron-right.svg" /></button></view
  ><view class="row section note"
    ><image class="icon" src="/assets/icons/truck.svg" /><text
      >书稿锁定并审核后开始制作。实际印制与配送时间将在接入生产服务后公示。</text
    ></view
  ><view class="error">{{error}}</view></view
><view class="dock"
  ><button
    wx:if="{{!submitted}}"
    class="btn brown"
    disabled="{{!ready}}"
    bindtap="submit"
    >体验确认印刷与寄送</button
  ><button wx:else="" class="btn" bindtap="order">查看演示订单</button
  ><view class="dock-note">本次无需支付 · 不会创建真实印刷订单</view></view
>
</block>
