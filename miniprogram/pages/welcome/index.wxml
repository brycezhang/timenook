<tn-navigation title="加入项目"/>
<app-loading wx:if="{{busy && !invitation}}" variant="book" />
<view wx:else class="tn-page with-dock family-page">
 <block wx:if="{{invitation}}">
  <view class="tn-muted">加入「{{invitation.bookTitle}}」</view>
  <view class="family-photo join-photo"><image src="/assets/invite-family.jpg" mode="aspectFill" aria-label="父女合影示例照片"/></view>
  <view class="tn-card family-notice">加入后可记录、编辑和制作，内容仅成员可见。</view>
  <view class="family-relations"><view class="tn-field">你是主讲人的谁 <text class="family-required">必选</text></view>
   <view class="family-options"><button wx:for="{{relationships}}" wx:key="*this" class="family-option {{relationship === item ? 'selected' : ''}}" data-relationship="{{item}}" bindtap="chooseRelationship" aria-pressed="{{relationship === item}}">{{item}}</button></view>
   <input wx:if="{{relationship === '自定义'}}" class="tn-input" value="{{customRelationship}}" bindinput="customRelationshipInput" maxlength="32" placeholder="例如：外孙女、学生" adjust-position="{{true}}" cursor-spacing="28" aria-label="自定义成员关系"/>
  </view>
  <view><checkbox-group bindchange="agreementChange"><label class="family-agreement"><checkbox value="agree" checked="{{agreed}}" color="#46563c"/><text>我已阅读并同意《使用条款与隐私说明》</text></label></checkbox-group><button class="tn-link family-terms" bindtap="terms">阅读使用条款</button></view>
 </block>
 <view wx:elif="{{expired}}" class="tn-heading">邀请已失效</view>
 <view wx:if="{{status}}" class="tn-error">{{status}}</view>
 <button wx:if="{{!invitation && !expired && !busy}}" class="tn-link" bindtap="retry">重新读取</button>
</view>
<view class="tn-dock"><button wx:if="{{invitation}}" class="tn-button" bindtap="accept" loading="{{busy}}" disabled="{{busy}}"><image class="tn-icon" src="/assets/icons/family-white.svg"/>{{loggedIn ? '接受邀请' : '登录并接受邀请'}}</button><button wx:else class="tn-button tn-secondary" bindtap="home">返回首页</button></view>
<quick-login id="quick-login" visible="{{loginVisible}}" bindsuccess="loginSucceeded" bindclose="closeLogin"/>
