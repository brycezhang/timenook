.quick-login-mask, .quick-consent-mask { position: fixed; inset: 0; z-index: 20000; background: #382c2459; display: flex; align-items: flex-end; justify-content: center; }
.quick-login-sheet { width: 100%; max-width: 600px; padding: 22px 22px calc(24px + env(safe-area-inset-bottom)); border-radius: 26px 26px 0 0; display: flex; flex-direction: column; gap: 16px; }
.quick-login-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.quick-login-close { font-size: 28px; font-weight: 400; }
.quick-login-agreement { display: flex; gap: 2px; align-items: center; min-height: 44px; }
.quick-login-check { flex-shrink: 0; width: 44px; height: 44px; display: flex; align-items: center; justify-content: flex-start; }
.quick-login-box { width: 20px; height: 20px; line-height: 18px; text-align: center; border: 1px solid #756859; border-radius: 4px; font-size: 14px; }
.quick-login-box.checked { background: #46563c; color: white; border-color: #46563c; }
.quick-login-terms { font-size: 13px; line-height: 1.8; }
.quick-login-terms button, .quick-consent-terms { display: inline; background: transparent; color: #46563c; font-size: 13px; line-height: 1.8; text-align: left; padding: 10px 0; }
.quick-consent-mask { z-index: 20001; align-items: center; padding: 22px; background: #382c2470; }
.quick-consent-dialog { width: 100%; max-width: 360px; padding: 24px; border-radius: 22px; display: flex; flex-direction: column; gap: 16px; }
.quick-consent-actions { display: flex; gap: 12px; }
.quick-consent-actions .tn-button { flex: 1; min-width: 0; }
