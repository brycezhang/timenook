<tn-navigation title="{{openFailed ? '打开书稿' : 'PDF 书稿'}}" />
<app-loading wx:if="{{pageLoading}}" variant="book" />
<view wx:else class="tn-page with-dock book-page">
  <block wx:if="{{openFailed}}">
    <view class="book-state-space" /><view class="book-state-intro"><view class="book-state-icon"><image src="/assets/icons/modern-book.svg" /></view><view class="book-heading">PDF 打开失败</view></view><view class="book-state-tail" />
    <view class="tn-dock"><button class="tn-button" bindtap="openPdf" disabled="{{busy}}" loading="{{busy}}"><image wx:if="{{!busy}}" class="tn-icon" src="/assets/icons/rotate-ccw-light.svg" />重新打开 PDF</button></view>
  </block>
  <block wx:elif="{{version.state === 'ready'}}">
    <view class="tn-muted">第 {{version.version}} 版 · 共 {{version.pageCount}} 页</view>
    <view class="pdf-card">
      <view class="pdf-file"><view class="pdf-file-icon"><image src="/assets/icons/file-text.svg" /></view><text>{{version.snapshot.cover.title}}.pdf</text></view>
      <view class="pdf-cover"><view class="pdf-cover-copy {{coverImage ? '' : 'full'}}"><text class="pdf-brand">时光故事</text><text class="pdf-cover-title">{{version.snapshot.cover.title}}</text><text class="pdf-message">{{version.snapshot.cover.salutation}}</text></view><image wx:if="{{coverImage}}" class="pdf-cover-image" src="{{coverImage}}" mode="aspectFill" /></view>
      <button id="open-pdf" class="tn-button" bindtap="openPdf" loading="{{busy}}" disabled="{{busy}}"><image wx:if="{{!busy}}" class="tn-icon" src="/assets/icons/file-text-light.svg" />打开完整 PDF</button>
      <view class="pdf-viewer-note">使用微信文档查看器打开</view>
    </view>
    <view class="tn-dock"><button class="tn-button" bindtap="print" disabled="{{busy}}"><image class="tn-icon" src="/assets/icons/book-white.svg" />去制作</button></view>
  </block>
  <block wx:elif="{{version}}"><view class="book-state-space" /><view class="book-state-intro"><view class="book-state-icon"><image src="/assets/icons/modern-book.svg" /></view><view class="book-intro"><view class="book-heading">书稿待更新</view><view class="tn-muted">重新生成 PDF 后即可预览和制作。</view></view></view><view class="tn-dock"><button class="tn-button" bindtap="edit">返回书稿</button></view></block>
  <view wx:if="{{status}}" class="tn-error">{{status}}</view><button wx:if="{{!version}}" class="tn-button" bindtap="refresh" disabled="{{busy}}" loading="{{busy}}">重新读取书稿</button>
</view>
