<tn-navigation title="{{navigationTitle}}" intercept-back="{{true}}" bindback="leave"/>
<app-loading wx:if="{{pageLoading}}" variant="form"/>
<view wx:else class="tn-page recording-page {{screen}} {{screen !== 'saving' ? 'with-dock' : ''}}">
  <block wx:if="{{!canRecord && (!interview || screen === 'ready')}}">
    <view class="tn-card"><view class="tn-heading">暂时不能开始讲述</view><view class="tn-muted" role="alert">{{status}}</view><button class="tn-button" bindtap="refresh" loading="{{busy}}" disabled="{{busy}}">重新查询</button></view>
  </block>
  <block wx:elif="{{screen === 'ready' || screen === 'recording' || screen === 'paused'}}">
    <view class="tn-eyebrow question-source">{{questionSource}}</view>
    <view class="record-question">{{question}}</view>
    <view wx:if="{{recordingPhotos.length}}" class="photo-section">
      <view class="photo-heading"><text>照片 · {{recordingPhotos.length}} 张</text><button class="tn-link" bindtap="photos" disabled="{{busy}}"><image class="tn-icon" src="/assets/icons/plus.svg"/>添加照片</button></view>
      <swiper class="recording-photos" current="{{photoIndex}}" bindchange="photoChanged" indicator-dots="{{recordingPhotos.length > 1}}" indicator-active-color="#46563C">
        <swiper-item wx:for="{{recordingPhotos}}" wx:key="photoId">
          <view class="record-photo">
            <image wx:if="{{item.image}}" class="photo-image" src="{{item.image}}" mode="aspectFill" aria-label="{{item.caption || '本次讲述照片'}}"/>
            <app-loading wx:elif="{{photosLoading}}" variant="card"/>
            <view wx:else class="photo-placeholder">照片暂未加载</view>
            <button class="tn-icon-button remove-photo" aria-label="移除第 {{index + 1}} 张照片" data-id="{{item.photoId}}" bindtap="removePhoto" disabled="{{busy}}"><image class="tn-icon" src="/assets/icons/x.svg"/></button>
          </view>
        </swiper-item>
      </swiper>
    </view>
    <app-loading wx:elif="{{photosLoading}}" variant="card"/>
    <button wx:else class="add-photo" bindtap="photos" disabled="{{busy}}"><image class="tn-icon" src="/assets/icons/image.svg"/>添加照片</button>
    <view wx:if="{{photoError}}" class="photo-error"><text class="tn-error">{{photoError}}</text><button class="tn-link" bindtap="loadRecordingPhotos">重新读取</button></view>
    <block wx:if="{{screen === 'ready'}}">
      <button wx:if="{{canChooseQuestion}}" class="tn-button change-question" bindtap="chooseAnother" disabled="{{busy}}"><image class="tn-icon" src="/assets/icons/rotate-ccw.svg"/>换个问题</button>
      <text class="record-hint">每段 {{recordingMaxMinutes}} 分钟自动保存，可继续录。</text>
      <button wx:for="{{pendingInterviews}}" wx:key="*this" class="tn-row" data-id="{{item}}" bindtap="resumePending"><view class="tn-grow">继续保存本机录音 {{index + 1}}</view><image class="tn-icon" src="/assets/icons/chevron-right.svg"/></button>
    </block>
    <view wx:else class="record-stage">
      <view class="wave {{screen === 'paused' ? 'wave-paused' : ''}}" aria-hidden="true"><view wx:for="{{wave}}" wx:key="index" class="wave-bar" style="height:{{item}}px;opacity:{{0.4 + (index % 4) * 0.15}}"/></view>
      <text class="record-time">{{timer}}</text>
      <text class="record-state">{{screen === 'paused' ? '已暂停' : '正在录音'}}</text>
      <text wx:if="{{recordingLimitLabel !== '10:00'}}" class="record-hint">本段可录至 {{recordingLimitLabel}}</text>
    </view>
  </block>
  <block wx:elif="{{screen === 'saving' || screen === 'failed'}}">
    <view class="state-heading"><view class="state-icon"><image src="/assets/icons/{{screen === 'failed' ? 'alert-circle' : 'upload'}}.svg"/></view><view class="state-copy"><view class="state-title">{{localSaveFailed ? '录音尚未保存' : screen === 'failed' ? '录音上传失败' : '正在保存录音'}}</view><view class="tn-muted">{{localSaveFailed ? '请保留当前页面，重试保存录音。' : screen === 'failed' ? '录音保留在当前设备，可重试上传。' : '请保持页面打开。'}}</view></view></view>
    <view class="tn-card saved-recording"><view class="saved-heading"><text>刚刚的讲述</text><text>{{timer}}</text></view><view class="wave compact-wave" aria-hidden="true"><view wx:for="{{wave}}" wx:key="index" class="wave-bar" style="height:{{item / 2}}px;opacity:{{0.4 + (index % 4) * 0.15}}"/></view>
      <block wx:if="{{screen === 'saving'}}"><view class="upload-track"><view class="upload-progress {{hasUploadProgress ? '' : 'upload-indeterminate'}}" style="{{hasUploadProgress ? 'width:' + uploadProgress + '%' : ''}}"/></view><text class="record-hint">{{state === 'sealing' ? '正在完成保存' : hasUploadProgress ? '保存中 ' + uploadProgress + '%' : '保存中'}}</text></block>
    </view>
  </block>
  <block wx:elif="{{screen === 'blocked'}}">
    <view class="state-heading"><view class="state-icon"><image src="/assets/icons/mic.svg"/></view><view class="state-title">开启麦克风权限</view></view>
    <view class="tn-card"><text class="record-hint">在微信的小程序设置中开启麦克风。</text></view>
  </block>
  <view wx:if="{{status && canRecord}}" class="tn-error" role="alert">{{status}}</view>
</view>
<view wx:if="{{!pageLoading && (canRecord || (interview && screen === 'failed')) && (screen !== 'saving' || (status && !busy))}}" class="tn-dock recording-dock">
  <button wx:if="{{screen === 'ready'}}" class="start-recording" bindtap="startSpeaking" disabled="{{busy || state === 'requesting'}}" aria-label="开始录音"><view class="microphone"><image src="/assets/icons/mic-light.svg"/></view><text>{{state === 'requesting' ? '正在开启麦克风' : '开始录音'}}</text></button>
  <block wx:elif="{{screen === 'recording' || screen === 'paused'}}"><view class="record-actions"><button class="tn-button toggle-recording {{screen === 'recording' ? 'tn-secondary' : ''}}" bindtap="togglePause" disabled="{{busy}}"><image class="tn-icon" src="/assets/icons/{{screen === 'recording' ? 'pause' : 'mic-light'}}.svg"/>{{screen === 'recording' ? '暂停' : '继续讲述'}}</button><button class="tn-button finish-recording {{screen === 'paused' ? 'tn-secondary' : ''}}" bindtap="finishRecording" disabled="{{busy}}"><image class="tn-icon" src="/assets/icons/{{screen === 'paused' ? 'square' : 'square-light'}}.svg"/>结束并保存</button></view><text wx:if="{{screen === 'recording'}}" class="record-hint dock-hint">每段 {{recordingMaxMinutes}} 分钟自动保存，可继续录。</text></block>
  <block wx:elif="{{screen === 'failed'}}"><button class="tn-button" bindtap="retryProcessing" loading="{{busy}}" disabled="{{busy}}">{{localSaveFailed ? '重试保存' : '重新上传'}}</button><button wx:if="{{!localSaveFailed}}" class="tn-link" bindtap="leave">稍后再试</button></block>
  <block wx:elif="{{screen === 'blocked'}}"><button class="tn-button" bindtap="settings">前往设置</button><button class="tn-link" bindtap="leave">返回这本书</button></block>
  <button wx:elif="{{status && !busy}}" class="tn-button" bindtap="saved">查看故事</button>
</view>
