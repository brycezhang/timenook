.photos-page {
  padding: 32rpx;
  font-size: 40rpx;
  line-height: 1.6;
}
.photos-page .title {
  font-size: 52rpx;
  font-weight: 600;
}
.photos-page .btn {
  min-height: 100rpx;
  min-width: 100rpx;
  font-size: 40rpx;
  white-space: normal;
}
.photo-card {
  padding: 24rpx;
  border: 2rpx solid #d9cbbb;
  border-radius: 20rpx;
  background: #fffdf8;
}
.photo-preview {
  width: 100%;
  height: 340rpx;
  display: block;
}
.photos-page .input {
  font-size: 40rpx;
  min-height: 100rpx;
  width: 100%;
  box-sizing: border-box;
}
